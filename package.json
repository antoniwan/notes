{
  "name": "notes blog",
  "type": "module",
  "version": "6.27.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/antoniwan/notes.git"
  },
  "homepage": "https://notes.antoniwan.online",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "22.x",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "node scripts/generate-social-images.js && astro build",
    "preview": "node scripts/serve-dist.mjs",
    "preview:vercel": "astro preview",
    "astro": "astro",
    "generate-social-images": "node scripts/generate-social-images.js",
    "generate-favicons": "node scripts/generate-favicons.js",
    "lighthouse": "node scripts/lighthouse.mjs",
    "audit-performance": "node scripts/lighthouse.mjs --performance-only",
    "prepare": "simple-git-hooks",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "validate-feeds": "node scripts/validate-feeds.mjs",
    "audit-frontmatter": "node scripts/audit-frontmatter.mjs",
    "validate-structured-data": "node scripts/validate-structured-data.mjs",
    "validate-generated-content": "node scripts/validate-generated-content.mjs",
    "changelog:since": "node scripts/changelog-since.mjs",
    "sync-remark42-rewrite": "node scripts/sync-remark42-rewrite.mjs",
    "check-remark42-rewrite": "node scripts/sync-remark42-rewrite.mjs --check"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.10",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "astro": "^7.3.2",
    "date-fns": "^4.1.0",
    "js-yaml": "^4.1.1",
    "mdast-util-to-string": "^4.0.0",
    "reading-time": "^1.5.0",
    "sentiment": "^5.0.2",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.3.0",
    "@types/js-yaml": "^4.0.9",
    "@typescript-eslint/parser": "^8.59.2",
    "eslint": "^10.3.0",
    "eslint-plugin-astro": "^1.7.0",
    "fast-xml-parser": "5.3.8",
    "lint-staged": "^17.3.0",
    "playwright": "1.55.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "simple-git-hooks": "^2.13.1",
    "terser": "^5.47.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  }
}
