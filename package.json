{
  "name": "notes blog",
  "type": "module",
  "version": "7.6.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/antoniwan/notes.git"
  },
  "homepage": "https://notes.antoniwan.online",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "22.x",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "node scripts/generate-social-images.js && astro build",
    "preview": "node scripts/serve-dist.mjs",
    "preview:vercel": "astro preview",
    "astro": "astro",
    "generate-social-images": "node scripts/generate-social-images.js",
    "generate-favicons": "node scripts/generate-favicons.js",
    "lighthouse": "node scripts/lighthouse.mjs",
    "audit-performance": "node scripts/lighthouse.mjs --performance-only",
    "prepare": "simple-git-hooks",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:tokens": "node scripts/lint-tokens.mjs",
    "check-image-sizes": "node scripts/check-image-sizes.mjs",
    "share-drafts": "node scripts/share-drafts.mjs",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "validate-feeds": "node scripts/validate-feeds.mjs",
    "audit-frontmatter": "node scripts/audit-frontmatter.mjs",
    "validate-structured-data": "node scripts/validate-structured-data.mjs",
    "validate-generated-content": "node scripts/validate-generated-content.mjs",
    "changelog:since": "node scripts/changelog-since.mjs",
    "sync-remark42-rewrite": "node scripts/sync-remark42-rewrite.mjs",
    "check-remark42-rewrite": "node scripts/sync-remark42-rewrite.mjs --check"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.3",
    "@astrojs/mdx": "^8.1.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.16",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "astro": "^7.4.1",
    "beautiful-mermaid": "1.1.3",
    "js-yaml": "^5.5.0",
    "mdast-util-to-string": "^4.0.0",
    "reading-time": "^1.5.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@axe-core/playwright": "^4.14.0",
    "@tailwindcss/vite": "^4.3.3",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "fast-xml-parser": "^5.11.2",
    "fast-xml-validator": "^1.4.2",
    "lint-staged": "^17.6.0",
    "playwright": "1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "simple-git-hooks": "^2.14.0",
    "terser": "^5.51.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  }
}
