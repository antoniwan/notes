{
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "antoniwan.blog"
        }
      ],
      "destination": "https://notes.antoniwan.online/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.antoniwan.blog"
        }
      ],
      "destination": "https://notes.antoniwan.online/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "blog.antoniwan.com"
        }
      ],
      "destination": "https://notes.antoniwan.online/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "blog.antoniwan.online"
        }
      ],
      "destination": "https://notes.antoniwan.online/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "vault.antoniwan.online"
        }
      ],
      "destination": "https://notes.antoniwan.online/:path*",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/everything",
      "permanent": true
    },
    {
      "source": "/blog/:slug*",
      "destination": "/p/:slug*",
      "permanent": true
    },
    {
      "source": "/categories",
      "destination": "/category",
      "permanent": true
    },
    {
      "source": "/categories/:slug*",
      "destination": "/category/:slug*",
      "permanent": true
    },
    {
      "source": "/ciencia-cerebral/:path*",
      "destination": "/writing-insights",
      "permanent": true
    },
    {
      "source": "/search",
      "destination": "/everything",
      "permanent": true
    },
    {
      "source": "/p",
      "destination": "/everything",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/remark42/:path*",
      "destination": "https://remark42-production-7df4.up.railway.app/:path*"
    }
  ]
}
