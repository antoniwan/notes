{
  "redirects": [
    {
      "source": "/recipes",
      "destination": "https://cookbook.antoniwan.online/",
      "statusCode": 301
    },
    {
      "source": "/p/recipes/:slug",
      "destination": "https://cookbook.antoniwan.online/recipes/:slug",
      "statusCode": 301
    },
    {
      "source": "/blog/recipes/:slug",
      "destination": "https://cookbook.antoniwan.online/recipes/:slug",
      "statusCode": 301
    },
    {
      "source": "/p/lemon-pepper-chicken",
      "destination": "https://cookbook.antoniwan.online/recipes/lemon-pepper-chicken",
      "statusCode": 301
    },
    {
      "source": "/blog/lemon-pepper-chicken",
      "destination": "https://cookbook.antoniwan.online/recipes/lemon-pepper-chicken",
      "statusCode": 301
    },
    {
      "source": "/p/lemon-pepper-chicken.md",
      "destination": "https://cookbook.antoniwan.online/recipes/lemon-pepper-chicken.md",
      "statusCode": 301
    },
    {
      "source": "/blog/lemon-pepper-chicken.md",
      "destination": "https://cookbook.antoniwan.online/recipes/lemon-pepper-chicken.md",
      "statusCode": 301
    },
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "blog.antoniwan.com"
        }
      ],
      "destination": "https://notes.antoniwan.online/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "blog.antoniwan.online"
        }
      ],
      "destination": "https://notes.antoniwan.online/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "vault.antoniwan.online"
        }
      ],
      "destination": "https://notes.antoniwan.online/:path*",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/everything",
      "permanent": true
    },
    {
      "source": "/blog/:slug*",
      "destination": "/p/:slug*",
      "permanent": true
    },
    {
      "source": "/categories",
      "destination": "/category",
      "permanent": true
    },
    {
      "source": "/categories/:slug*",
      "destination": "/category/:slug*",
      "permanent": true
    },
    {
      "source": "/ciencia-cerebral/:path*",
      "destination": "/writing-insights",
      "permanent": true
    },
    {
      "source": "/search",
      "destination": "/everything",
      "permanent": true
    },
    {
      "source": "/p",
      "destination": "/everything",
      "permanent": true
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap-index.xml",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/api/remark42/:path*",
      "destination": "https://remark42-production-7df4.up.railway.app/:path*"
    }
  ],
  "headers": [
    {
      "source": "/((?!api/).*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'" }
      ]
    }
  ]
}
