---
import PageLayout from '../layouts/PageLayout.astro';
import ArchiveList from '../components/ArchiveList.astro';
import { getCollection } from 'astro:content';
import { PAGE_META } from '../data/pageMeta';
import { isCollectionListed } from '../utils/publishFilters';

const posts = await getCollection('blog', ({ data }) => isCollectionListed(data));
---

<PageLayout
  title="Archive"
  description="The full record, newest to oldest."
  metaDescription={PAGE_META['/archive']}
  path="/archive"
  structuredDataType="website"
  mode="chrome"
>
  <ArchiveList posts={posts} />
</PageLayout>
