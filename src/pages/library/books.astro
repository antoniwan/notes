---
import PageLayout from '../../layouts/PageLayout.astro';
import { books, type BookStatus } from '../../data/library';
import { PAGE_META } from '../../data/pageMeta';

const shelves = [...new Set(books.map((book) => book.shelf))].sort((a, b) => a.localeCompare(b));
const catalogue = [...books].sort((a, b) =>
  a.title.localeCompare(b.title, 'en', { sensitivity: 'base', numeric: true }),
);
const statusLabels: Record<BookStatus, string> = {
  'in-progress': 'Currently reading',
  read: 'Read',
  'to-read': 'Reference / not read completely',
};
---

<PageLayout
  title="Book Library"
  description="Books I own, books I've read, and books I dip into for a specific idea. Shared for reference, not as a reading challenge."
  descriptionClass="text-base md:text-lg library-intro"
  metaDescription={PAGE_META['/library/books']}
  path="/library/books"
  mode="chrome"
>
  <div class="library-page">
    <form class="library-filters" id="library-filters" role="search" aria-label="Find books">
      <label class="library-search">
        <span>Search books</span>
        <input
          id="library-search-input"
          type="search"
          name="q"
          placeholder="Title or author"
          inputmode="search"
          autocomplete="off"
          aria-controls="library-books"
        />
      </label>
      <label>
        <span>Reading status</span>
        <select id="library-status-filter" name="status" aria-controls="library-books">
          <option value="">All statuses</option>
          <option value="in-progress">Currently reading</option>
          <option value="read">Read</option>
          <option value="to-read">Reference</option>
        </select>
      </label>
      <label>
        <span>Shelf</span>
        <select id="library-shelf-filter" name="shelf" aria-controls="library-books">
          <option value="">All shelves</option>
          {shelves.map((shelf) => <option value={shelf}>{shelf}</option>)}
        </select>
      </label>
    </form>

    <div class="library-results">
      <p data-library-results role="status" aria-live="polite" aria-atomic="true">
        {catalogue.length} books
      </p>
      <div class="library-results__actions">
        <span>Titles A–Z</span>
        <button type="reset" form="library-filters" class="library-clear" data-library-clear hidden>
          Clear filters
        </button>
      </div>
    </div>

    <ul class="library-books" id="library-books" aria-label="Book catalogue" role="list">
      {
        catalogue.map((book) => (
          <li
            class="book-row"
            data-book
            data-title={book.title}
            data-author={book.author}
            data-status={book.status}
            data-shelf={book.shelf}
          >
            <div class="book-main">
              <h2>{book.title}</h2>
              <p>{book.author}</p>
            </div>
            <dl class="book-details">
              <div>
                <dt>Shelf</dt>
                <dd>{book.shelf}</dd>
              </div>
              <div>
                <dt>Reading status</dt>
                <dd>{statusLabels[book.status]}</dd>
              </div>
            </dl>
          </li>
        ))
      }
    </ul>

    <div class="library-empty" data-library-empty hidden>
      <h2>No books match</h2>
      <p>Try another title or author, or clear the filters.</p>
    </div>
    <noscript>
      <style is:inline>
        .library-filters {
          display: none;
        }
      </style>
    </noscript>
  </div>
</PageLayout>

<script>
  import { matchesCatalogSearch } from '../../utils/catalogSearch';

  const form = document.querySelector<HTMLFormElement>('#library-filters');
  const search = document.querySelector<HTMLInputElement>('#library-search-input');
  const status = document.querySelector<HTMLSelectElement>('#library-status-filter');
  const shelf = document.querySelector<HTMLSelectElement>('#library-shelf-filter');
  const result = document.querySelector<HTMLElement>('[data-library-results]');
  const clear = document.querySelector<HTMLButtonElement>('[data-library-clear]');
  const empty = document.querySelector<HTMLElement>('[data-library-empty]');
  const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-book]'));

  if (form && search && status && shelf && result && clear && empty) {
    const updateResults = () => {
      let visible = 0;
      rows.forEach((row) => {
        const matches =
          (!status.value || status.value === row.dataset.status) &&
          (!shelf.value || shelf.value === row.dataset.shelf) &&
          matchesCatalogSearch(search.value, row.dataset.title ?? '', row.dataset.author ?? '');
        row.hidden = !matches;
        if (matches) visible++;
      });
      const active = Boolean(search.value.trim() || status.value || shelf.value);
      result.textContent = active
        ? `${visible} of ${rows.length} ${rows.length === 1 ? 'book' : 'books'}`
        : `${rows.length} ${rows.length === 1 ? 'book' : 'books'}`;
      clear.hidden = !active;
      empty.hidden = visible !== 0;
    };

    const writeUrl = () => {
      const url = new URL(window.location.href);
      for (const [key, value] of [
        ['q', search.value.trim()],
        ['status', status.value],
        ['shelf', shelf.value],
      ]) {
        if (value) url.searchParams.set(key, value);
        else url.searchParams.delete(key);
      }
      history.replaceState(history.state, '', url);
    };

    const restoreFromUrl = () => {
      const params = new URL(window.location.href).searchParams;
      search.value = params.get('q') ?? '';
      for (const [control, name] of [
        [status, 'status'],
        [shelf, 'shelf'],
      ] as const) {
        const value = params.get(name) ?? '';
        control.value = Array.from(control.options).some((option) => option.value === value)
          ? value
          : '';
      }
      updateResults();
    };

    const applyFilters = () => {
      updateResults();
      writeUrl();
    };
    search.addEventListener('input', applyFilters);
    status.addEventListener('change', applyFilters);
    shelf.addEventListener('change', applyFilters);
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      applyFilters();
    });
    form.addEventListener('reset', (event) => {
      event.preventDefault();
      search.value = '';
      status.value = '';
      shelf.value = '';
      applyFilters();
      search.focus();
    });
    window.addEventListener('popstate', restoreFromUrl);
    window.addEventListener('pageshow', restoreFromUrl);
    restoreFromUrl();
  }
</script>

<style>
  :global(.library-intro) {
    max-width: 62ch;
  }

  .library-page {
    padding-top: 1rem;
    padding-bottom: clamp(4rem, 7vw, 7rem);
  }

  .library-filters {
    display: grid;
    gap: 1rem;
    margin: 0;
  }

  .library-filters label {
    display: grid;
    gap: 0.5rem;
    min-width: 0;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    line-height: 1.5;
    font-weight: 600;
    color: rgb(var(--color-text));
  }

  .library-filters input,
  .library-filters select {
    width: 100%;
    min-width: 0;
    min-height: 3rem;
    margin: 0;
    padding: 0.75rem 1rem;
    border: 1px solid rgb(var(--color-border));
    border-radius: var(--radius-lg);
    background-color: rgb(var(--color-bg-alt));
    color: rgb(var(--color-text));
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.5;
  }

  .library-results {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem 1rem;
    min-height: 2.75rem;
    margin: 1.5rem 0;
    color: rgb(var(--color-text-muted));
    font-family: var(--font-sans);
    font-size: 0.875rem;
    line-height: 1.5;
    font-variant-numeric: tabular-nums;
  }

  .library-results p {
    margin: 0;
  }

  .library-results__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }

  .library-clear {
    min-height: 2.75rem;
    padding: 0.5rem 0;
    border: 0;
    background: transparent;
    color: rgb(var(--color-accent));
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .library-clear:hover {
    color: rgb(var(--color-accent-hover));
  }

  .library-clear:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 4px;
    border-radius: 2px;
  }

  .library-filters input:focus-visible,
  .library-filters select:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 4px;
  }

  .library-books {
    display: grid;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .book-row {
    display: grid;
    gap: 1.5rem;
    min-width: 0;
    padding: 1.5rem;
    margin: 0;
    border-radius: var(--radius-lg);
    background: rgb(var(--color-bg-alt));
  }

  .book-main {
    min-width: 0;
  }

  .book-main h2,
  .library-empty h2 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 1.7vw, 1.6rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.015em;
    text-wrap: pretty;
  }

  .book-main p {
    margin: 0.75rem 0 0;
    color: rgb(var(--color-text-muted));
    font-size: 1rem;
    line-height: 1.7;
  }

  .book-details {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    min-width: 0;
    margin: 0;
    font-family: var(--font-sans);
  }

  .book-details dt {
    margin: 0 0 0.375rem;
    color: rgb(var(--color-text-muted));
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .book-details dd {
    margin: 0;
    font-size: 1rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .library-empty {
    display: grid;
    gap: 1rem;
    padding: 2rem;
    border-radius: var(--radius-lg);
    background: rgb(var(--color-bg-alt));
  }

  .library-empty p {
    margin: 0;
    max-width: 62ch;
    font-size: 1.125rem;
    line-height: 1.7;
    color: rgb(var(--color-text-muted));
  }

  [hidden] {
    display: none !important;
  }

  @media (min-width: 600px) {
    .library-filters {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem;
    }

    .library-search {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 768px) {
    .book-row {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      gap: 2rem;
      padding: 2rem;
      align-items: start;
    }
  }

  @media (min-width: 1024px) {
    .library-filters {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1.25fr) minmax(0, 1.75fr);
      gap: 2rem;
    }

    .library-search {
      grid-column: auto;
    }

    .book-row {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    }
  }
</style>
