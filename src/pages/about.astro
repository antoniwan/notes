---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import LatestWatched from '../components/LatestWatched.astro';
import { PAGE_META } from '../data/pageMeta';
import { AUTHOR } from '../consts';
import { fetchLetterboxdRecent } from '../utils/letterboxd';
import HeroImage from '../components/HeroImage.astro';

const rssUrl = import.meta.env.LETTERBOXD_RSS_URL ?? '';
const profileUrl = import.meta.env.LETTERBOXD_PROFILE_URL ?? 'https://letterboxd.com/antoniwan/';

const letterboxdFilms = await fetchLetterboxdRecent(rssUrl, 12);

type AboutTopic = {
  label: string;
  hint: string;
  emoji: string;
  /** Matches `/category/[category]` when set (see `src/data/categories.ts`). */
  categoryId?: string;
};

// Curated voice list for About — not a full category dump (see `src/data/categories.ts`).
const topics: AboutTopic[] = [
  {
    label: 'Integration & Growth',
    hint: 'Trying to live what I already understand',
    emoji: '\u{1F9D8}\u{1F3FD}\u{200D}\u{2642}\u{FE0F}',
    categoryId: 'integration-growth',
  },
  {
    label: 'On Parenting',
    hint: 'Presence with my kids, the sacred in the ordinary',
    emoji: '\u{1F468}\u{200D}\u{1F469}\u{200D}\u{1F467}\u{200D}\u{1F466}',
    categoryId: 'parenting',
  },
  {
    label: 'Love & Revolution',
    hint: 'A home rooted in kindness; love as the final revolution',
    emoji: '\u{1F49C}',
  },
  {
    label: 'Psychology, Roughly',
    hint: "Human behavior, healing, clear signals, the body's wisdom",
    emoji: '\u{1F9E0}',
    categoryId: 'psychology',
  },
  {
    label: 'On Politics & Culture',
    hint: 'Power, norms, dignity that need not be earned',
    emoji: '\u{2696}\u{FE0F}',
    categoryId: 'politics',
  },
  {
    label: 'Art & Expression',
    hint: 'Creative soul, truth-telling, aesthetic power',
    emoji: '\u{1F3B5}',
    categoryId: 'art-expression',
  },
  {
    label: 'On Systems & Strategy',
    hint: 'Digital power, code, tools that matter',
    emoji: '\u{1F4BB}',
    categoryId: 'systems-strategy',
  },
  {
    label: 'DIY & Creation',
    hint: 'Physical builds, handmade goods, crafting',
    emoji: '\u{1F6E0}\u{FE0F}',
    categoryId: 'diy-creation',
  },
  {
    label: 'Metaspace',
    hint: 'Reflections on the journey itself — the why and how',
    emoji: '\u{1F300}',
    categoryId: 'metaspace',
  },
];
---

<BaseLayout
  title="About Antonio Rodríguez Martínez"
  description="I write from home as a stay-at-home and remote-working father, and as a stepfather, while I practice patience, temperance, and grounded leadership."
  metaDescription={PAGE_META['/about']}
  path="/about"
>
  <Container>
    <div class="about-shell">
      <header class="about-heading">
        <p class="about-kicker">About</p>
        <h1 class="about-name">Antonio Rodríguez Martínez</h1>
        <p class="about-description">
          I write from home as a stay-at-home and remote-working father, and as a stepfather, while
          I practice patience, temperance, and grounded leadership.
        </p>
      </header>

      <div class="about-introduction">
        <div class="about-story">
          <p class="about-story__opening">
            For a long time I could explain things with precision, but daily life still exposed the
            gaps between what I believed, or thought I believed, and how I actually moved. Naming
            the gap was super useful. Closing it is the real work, and where I am today.
          </p>
          <p>
            I am a boyfriend, a father to a 6-year-old daughter, stepfather to a 2-year-old and a
            21-year-old, and a stay-at-home remote-working parent of an infant. My beautiful blended
            family is where I learn the most. Leadership for me is practical: patience under
            pressure, temperance when I am tired, and choosing presence over ego.
          </p>
          <p>
            I also keep a <a href="/recipes">Cookbook</a> with recipes we actually cook at home, from
            arroz and sofrito to pancakes for Mia.
          </p>
          <p>
            I still build systems: digital, emotional, and relational. I care deeply about code,
            strategy, and craft. I am a technical program manager and developer. I write to practice
            what I claim, in small repeated actions.
          </p>
          <p>
            This site is where I test ideas against life. If something I write is true, it should
            hold up in my home, my work, and my relationships. I also write for fun. Writing is a
            valve, a creative output, and part of my art practice. I also write to learn a fuckton
            of things, it's very effective.
          </p>
          <p>
            I wrote two bilingual children's books for my kids and my nephew:{' '}
            <a href="/books#the-bent-one">The Bent One</a> and{' '}
            <a href="/books#mia-the-sun-and-the-moon">Mia, the Sun, and the Moon</a>. They are part
            of that art practice, stories to read together in English and Spanish.
          </p>
        </div>

        <div class="about-pictures">
          <figure class="about-portrait">
            <HeroImage
              src="/images/mia-y-yo-anime.avif"
              alt="Antonio Rodríguez Martínez and his daughter Mia, illustrated in anime style."
              variant="article"
              priority={true}
            />
          </figure>

          <a href="/recipes" class="about-cookbook">
            <div class="about-cookbook__image">
              <HeroImage src="/images/2026/cast-iron-flank-steak.avif" alt="" variant="card" />
            </div>
            <span class="about-cookbook__caption">
              <span class="about-cookbook__title">Cookbook</span>
              <span class="about-cookbook__destination"
                >Recipes <span aria-hidden="true">↗</span></span
              >
            </span>
          </a>
        </div>
      </div>

      <section class="about-topics" aria-labelledby="about-topics-heading">
        <div class="about-section-heading">
          <h2 id="about-topics-heading" class="about-section-title">What these notes cover</h2>
          <p class="about-topics__intro">
            Working notes from real life, organized as a map rather than a finished system.
          </p>
        </div>
        <ul class="about-topics__list">
          {
            topics.map((topic) => (
              <li class="about-topics__item">
                {topic.categoryId ? (
                  <a href={`/category/${topic.categoryId}`} class="about-topic about-topic--link">
                    <span class="about-topic__emoji" aria-hidden="true">
                      {topic.emoji}
                    </span>
                    <span class="about-topic__copy">
                      <span class="about-topic__label">{topic.label}</span>
                      <span class="about-topic__hint">{topic.hint}</span>
                    </span>
                    <span class="about-topic__arrow" aria-hidden="true">
                      ↗
                    </span>
                  </a>
                ) : (
                  <div class="about-topic">
                    <span class="about-topic__emoji" aria-hidden="true">
                      {topic.emoji}
                    </span>
                    <span class="about-topic__copy">
                      <span class="about-topic__label">{topic.label}</span>
                      <span class="about-topic__hint">{topic.hint}</span>
                    </span>
                  </div>
                )}
              </li>
            ))
          }
        </ul>
      </section>

      <div class="about-films">
        <LatestWatched films={letterboxdFilms} profileUrl={profileUrl} />
      </div>

      <div class="about-closing">
        <section class="about-contact" aria-labelledby="about-contact-heading">
          <h2 id="about-contact-heading" class="about-closing__heading">Write to me</h2>
          <p>
            I’m mostly inactive on social media. If you want to respond to an essay, ask about a
            book, or talk about the writing,{' '}
            <a href={'mailto:' + AUTHOR.email}>email me</a>.
          </p>
        </section>
        <footer class="about-disclaimer">
          <h2 class="about-closing__heading">Disclaimer</h2>
          <p>
            The wisdom, practices, and digital craft shared here come from personal experience and
            exploration. None of it is medical, legal, psychological, or professional advice. Please
            talk to qualified people when you need that kind of guidance.
          </p>
        </footer>
      </div>
    </div>
  </Container>
</BaseLayout>

<style>
  .about-shell {
    --about-body-size: 1.125rem;
    --about-heading-size: clamp(1.65rem, 2.5vw, 2rem);
    padding-block: clamp(2rem, 5vw, 4.5rem) clamp(4rem, 7vw, 7rem);
  }

  .about-heading {
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .about-kicker {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 1.1rem;
    color: rgb(var(--color-text-muted));
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .about-kicker::before {
    width: 2rem;
    height: 3px;
    background: rgb(var(--color-primary));
    content: '';
  }

  .about-name {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 1.06;
    text-wrap: balance;
  }

  .about-description {
    max-width: 69ch;
    margin: 1.5rem 0 0;
    color: rgb(var(--color-text-muted));
    font-family: var(--font-sans);
    font-size: var(--about-body-size);
    line-height: 1.7;
  }

  .about-introduction {
    display: grid;
    gap: 2.75rem;
    align-items: start;
  }

  .about-story {
    max-width: 62ch;
    min-width: 0;
    font-family: var(--font-serif);
    font-size: var(--about-body-size);
    line-height: 1.75;
  }

  .about-story p {
    margin: 0 0 1.4rem;
    font-size: inherit;
    line-height: inherit;
  }

  .about-story p:last-child {
    margin-bottom: 0;
  }

  .about-story a,
  .about-closing a {
    color: rgb(var(--color-accent));
    text-decoration: underline;
    text-decoration-color: rgb(var(--color-accent) / 0.4);
    text-underline-offset: 0.18em;
    transition: text-decoration-color 160ms ease;
  }

  .about-story a:hover,
  .about-closing a:hover {
    text-decoration-color: currentColor;
  }

  .about-pictures {
    min-width: 0;
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .about-portrait {
    margin: 0;
  }

  .about-portrait :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .about-cookbook {
    display: block;
    color: rgb(var(--color-text));
    text-decoration: none;
  }

  .about-cookbook__image {
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: rgb(var(--color-bg-alt));
  }

  .about-cookbook__image :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 55%;
    transition: transform 400ms ease;
  }

  .about-cookbook__caption {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 0 0;
  }

  .about-cookbook__title {
    font-family: var(--font-heading);
    font-size: var(--about-heading-size);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.2;
  }

  .about-cookbook__destination {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    color: rgb(var(--color-accent));
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .about-cookbook__destination > span {
    font-size: var(--about-body-size);
    line-height: 1;
  }

  .about-cookbook:hover .about-cookbook__image :global(img) {
    transform: scale(1.035);
  }

  .about-cookbook:hover .about-cookbook__title {
    color: rgb(var(--color-accent));
  }

  .about-topics,
  .about-films {
    margin-top: clamp(3.5rem, 7vw, 6rem);
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid rgb(var(--color-border) / 0.8);
  }

  .about-section-heading {
    display: grid;
    gap: 1rem;
    align-items: end;
    margin-bottom: 2rem;
  }

  .about-section-title {
    max-width: 18ch;
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--about-heading-size);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.15;
    text-wrap: balance;
  }

  .about-topics__intro {
    max-width: 43ch;
    margin: 0;
    color: rgb(var(--color-text-muted));
    font-family: var(--font-sans);
    font-size: var(--about-body-size);
    line-height: 1.65;
  }

  .about-topics__list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .about-topics__item {
    min-width: 0;
  }

  .about-topic {
    display: flex;
    height: 100%;
    align-items: start;
    gap: 0.75rem;
    padding: 0.65rem 0;
    color: rgb(var(--color-text));
    text-decoration: none;
  }

  .about-topic__emoji {
    flex-shrink: 0;
    font-size: var(--about-body-size);
    line-height: 1.5;
  }

  .about-topic__copy {
    display: grid;
    gap: 0.4rem;
    flex: 1;
    min-width: 0;
  }

  .about-topic__label {
    font-family: var(--font-heading);
    font-size: var(--about-body-size);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.4;
  }

  .about-topic__hint {
    max-width: 33ch;
    color: rgb(var(--color-text-muted));
    font-family: var(--font-sans);
    font-size: var(--about-body-size);
    line-height: 1.6;
  }

  .about-topic__arrow {
    flex-shrink: 0;
    color: rgb(var(--color-accent));
    font-size: var(--about-body-size);
    line-height: 1.4;
    transition: transform 160ms ease;
  }

  .about-topic--link:hover .about-topic__label {
    color: rgb(var(--color-accent));
  }

  .about-topic--link:hover .about-topic__arrow {
    transform: translate(2px, -2px);
  }

  .about-closing {
    display: grid;
    gap: 2.5rem;
    margin-top: clamp(3.5rem, 6vw, 5rem);
    padding-top: 2rem;
    border-top: 1px solid rgb(var(--color-border) / 0.75);
  }

  .about-closing__heading {
    margin: 0 0 1rem;
    font-family: var(--font-heading);
    font-size: var(--about-heading-size);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.025em;
  }

  .about-closing p {
    max-width: 58ch;
    margin: 0;
    color: rgb(var(--color-text-muted));
    font-family: var(--font-sans);
    font-size: var(--about-body-size);
    line-height: 1.75;
  }

  .about-story a:focus-visible,
  .about-closing a:focus-visible,
  .about-topic--link:focus-visible,
  .about-cookbook:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 5px;
  }

  @media (min-width: 640px) {
    .about-topics__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 960px) {
    .about-introduction {
      grid-template-columns: minmax(0, 1.12fr) minmax(0, 1fr);
      column-gap: clamp(2.5rem, 5vw, 5rem);
    }

    .about-section-heading {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: 4rem;
    }

    .about-topics__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: clamp(1.5rem, 3vw, 3rem);
    }

    .about-closing {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(3rem, 7vw, 7rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-cookbook__image :global(img),
    .about-topic__arrow,
    .about-story a,
    .about-closing a {
      transition: none;
    }

    .about-cookbook:hover .about-cookbook__image :global(img),
    .about-topic--link:hover .about-topic__arrow {
      transform: none;
    }
  }
</style>
