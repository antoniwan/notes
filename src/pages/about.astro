---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import { PAGE_META } from '../data/pageMeta';
import { AUTHOR } from '../consts';
import HeroImage from '../components/HeroImage.astro';
---

<BaseLayout
  title="About"
  ogTitle="About Antonio"
  description="Field notes on family, work, and trying to live what I believe."
  metaDescription={PAGE_META['/about']}
  path="/about"
>
  <Container>
    <div class="about-shell">
      <header class="about-heading">
        <p class="about-kicker">About</p>
        <h1 class="about-name">Antonio Rodríguez Martínez</h1>
        <p class="about-description">
          Field notes on family, work, and trying to live what I believe.
        </p>
      </header>

      <div class="about-introduction">
        <div class="about-story">
          <p class="about-story__opening">
            For a long time I could explain things with precision, but daily life exposed the gap
            between what I believed and how I moved. Closing it is the real work.
          </p>
          <p>
            I am a boyfriend, father, and stepfather. My beautiful blended family is where I learn
            the most. Leadership for me is practical: patience under pressure, temperance when I am
            tired, and choosing presence over ego.
          </p>
          <p>
            I am a technical program manager and developer who works from home. I care deeply about
            code, strategy, and craft. Here I test ideas against life: they should hold up at home,
            at work, and in my relationships.
          </p>
          <p>
            Writing is also a valve, part of my art practice, and a way to learn a fuckton of
            things. It's very effective, and I write for fun too.
          </p>
          <p>
            I also keep a <a href="https://cookbook.antoniwan.online/">Cookbook</a> with recipes we
            actually cook at home, from arroz and sofrito to pancakes for Mia.
          </p>
          <p>
            I wrote two bilingual children's books for my kids and my nephew:{' '}
            <a href="https://antoniwan.online/projects#the-bent-one">The Bent One</a> and{' '}
            <a href="https://antoniwan.online/projects#mia-the-sun-and-the-moon">
              Mia, the Sun, and the Moon
            </a>
            . Stories to read together in English and Spanish.
          </p>
          <p id="how-i-write">
            How I write: some pieces I write by hand; others with AI. I bring the thinking from my
            life, daily notes, and conversations. Models help draft, revise, find sources, and build
            charts. I edit, decide what stays, and stand behind everything I publish. Any essay may
            include that help. More in <a href="/p/panda-and-wolf">Panda and Wolf</a>.
          </p>
          <p id="cover-images">
            Cover images: most come from my Midjourney prompts, sometimes edited. Others are my own
            photos, drawings, and creations.
          </p>
        </div>

        <div class="about-pictures">
          <figure class="about-portrait">
            <HeroImage
              src="/images/mia-y-yo-anime.avif"
              alt="Antonio Rodríguez Martínez and his daughter Mia, illustrated in anime style."
              variant="article"
              priority={true}
            />
          </figure>
        </div>
      </div>

      <section class="about-topics" aria-labelledby="about-topics-heading">
        <div class="about-section-heading">
          <h2 id="about-topics-heading" class="about-section-title">
            What these notes cover
          </h2>
          <p class="about-topics__intro">
            Parenting, growth, psychology, politics, art, systems, and the ordinary things that
            connect them. <a href="/browse#topics">Explore the topics</a>.
          </p>
        </div>
      </section>

      <div class="about-closing">
        <section class="about-contact" aria-labelledby="about-contact-heading">
          <h2 id="about-contact-heading" class="about-closing__heading">
            Write to me
          </h2>
          <p>
            I’m mostly inactive on social media. To talk about an essay, a book, or the writing,{' '}
            <a href={'mailto:' + AUTHOR.email}>email me</a>.
          </p>
        </section>
        <footer class="about-disclaimer">
          <h2 class="about-closing__heading">Disclaimer</h2>
          <p>
            These notes draw on personal experience. They are not medical, legal, psychological, or
            professional advice. Talk to qualified people when you need that guidance.
          </p>
        </footer>
      </div>
    </div>
  </Container>
  <script is:inline>
    if (window.location.hash === '#about-watched-heading') {
      window.location.replace('https://antoniwan.online/collections/movies#latest-watches');
    }
  </script>
</BaseLayout>

<style>
  .about-shell {
    --about-body-size: 1.125rem;
    --about-heading-size: clamp(1.65rem, 2.5vw, 2rem);
    padding-block: round(nearest, clamp(2rem, 5vw, 4.5rem), 4px)
      round(nearest, clamp(4rem, 7vw, 7rem), 4px);
  }

  .about-heading {
    margin-bottom: round(nearest, clamp(2rem, 4vw, 3.5rem), 4px);
  }

  .about-kicker {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 1rem;
    color: rgb(var(--color-text-muted));
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: var(--leading-snug);
    text-transform: uppercase;
  }

  .about-kicker::before {
    width: 2rem;
    height: 3px;
    background: rgb(var(--color-primary));
    content: '';
  }

  .about-name {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: var(--leading-none);
    text-wrap: balance;
  }

  .about-description {
    max-width: var(--measure);
    margin: 1.5rem 0 0;
    color: rgb(var(--color-text-muted));
    font-family: var(--font-sans);
    font-size: var(--about-body-size);
    line-height: var(--leading-relaxed);
  }

  .about-introduction {
    display: grid;
    gap: 2.75rem;
    align-items: start;
  }

  .about-story {
    max-width: var(--measure);
    min-width: 0;
    font-family: var(--font-serif);
    font-size: var(--about-body-size);
    line-height: var(--leading-relaxed);
  }

  .about-story p {
    margin: 0 0 1.5rem;
    font-size: inherit;
    line-height: inherit;
  }

  .about-story p:last-child {
    margin-bottom: 0;
  }

  .about-story a,
  .about-topics a,
  .about-closing a {
    color: rgb(var(--color-accent));
    text-decoration: underline;
    text-decoration-color: rgb(var(--color-accent) / 0.4);
    text-underline-offset: 0.18em;
    transition: text-decoration-color 160ms ease;
  }

  .about-story a:hover,
  .about-topics a:hover,
  .about-closing a:hover {
    text-decoration-color: currentColor;
  }

  .about-pictures {
    min-width: 0;
    display: grid;
    gap: round(nearest, clamp(1.5rem, 3vw, 2.5rem), 4px);
  }

  .about-portrait {
    margin: 0;
  }

  .about-portrait :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .about-topics {
    margin-top: round(nearest, clamp(3.5rem, 7vw, 6rem), 4px);
    padding-top: round(nearest, clamp(2rem, 4vw, 3rem), 4px);
    border-top: 1px solid rgb(var(--color-border) / 0.8);
  }

  .about-section-heading {
    display: grid;
    gap: 1rem;
    align-items: end;
  }

  .about-section-title {
    max-width: var(--measure-title);
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--about-heading-size);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: var(--leading-display);
    text-wrap: balance;
  }

  .about-topics__intro {
    max-width: var(--measure);
    margin: 0;
    color: rgb(var(--color-text-muted));
    font-family: var(--font-sans);
    font-size: var(--about-body-size);
    line-height: var(--leading-relaxed);
  }

  .about-closing {
    display: grid;
    gap: 2.5rem;
    margin-top: round(nearest, clamp(3.5rem, 6vw, 5rem), 4px);
    padding-top: 2rem;
    border-top: 1px solid rgb(var(--color-border) / 0.75);
  }

  .about-closing__heading {
    margin: 0 0 1rem;
    font-family: var(--font-heading);
    font-size: var(--about-heading-size);
    font-weight: 600;
    line-height: var(--leading-tight);
    letter-spacing: -0.025em;
  }

  .about-closing p {
    max-width: var(--measure);
    margin: 0;
    color: rgb(var(--color-text-muted));
    font-family: var(--font-sans);
    font-size: var(--about-body-size);
    line-height: var(--leading-relaxed);
  }

  .about-story a:focus-visible,
  .about-topics a:focus-visible,
  .about-closing a:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 5px;
  }

  /* One two-column grid for the whole page: the introduction, the topics head, and the closing
     share their column edges. */
  @media (min-width: 960px) {
    .about-introduction,
    .about-section-heading,
    .about-closing {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 4rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-story a,
    .about-topics a,
    .about-closing a {
      transition: none;
    }
  }
</style>
