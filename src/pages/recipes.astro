---
import PageLayout from '../layouts/PageLayout.astro';
import DefaultImage from '../components/DefaultImage.astro';
import { getCollection } from 'astro:content';
import { PAGE_META } from '../data/pageMeta';
import { getSpanishTwinGroups } from '../utils/translationUtils';
import { isSpanishPrimary } from '../utils/publishFilters';
import { isCookbookListedPost, recipeContentsLetter } from '../utils/recipes';

const recipes = (await getCollection('blog', (entry) => isCookbookListedPost(entry))).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const spanishTwinGroups = await getSpanishTwinGroups();

const plates = recipes.map((recipe) => ({
  recipe,
  hasSpanish:
    Boolean(recipe.data.translationGroup) &&
    spanishTwinGroups.has(recipe.data.translationGroup ?? ''),
}));

const byLetter = new Map<string, typeof recipes>();
const alpha = [...recipes].sort((a, b) => a.data.title.localeCompare(b.data.title));
for (const recipe of alpha) {
  const letter = recipeContentsLetter(recipe.data.title);
  const group = byLetter.get(letter) ?? [];
  group.push(recipe);
  byLetter.set(letter, group);
}
const contents = [...byLetter.entries()].sort(([a], [b]) => a.localeCompare(b));
---

<PageLayout
  title="Cookbook"
  heading="Cookbook"
  description="What we actually cook at home — arroz, sofrito, pancakes for Mia, and the rest. Look a dish up by name. Plates are below."
  metaDescription={PAGE_META['/recipes']}
  path="/recipes"
  structuredDataType="website"
  mode="chrome"
  contentClass="cookbook max-w-none"
>
  {
    contents.length > 0 ? (
      <>
        <section class="cookbook-contents" aria-labelledby="cookbook-contents-heading">
          <h2 id="cookbook-contents-heading">Index</h2>
          <div class="cookbook-contents__cols">
            {contents.map(([letter, dishes]) => (
              <div class="cookbook-letter">
                <h3>{letter}</h3>
                <ul>
                  {dishes.map((recipe) => (
                    <li>
                      <a href={`/p/${recipe.id}`}>{recipe.data.title}</a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </section>

        <section class="cookbook-plates" aria-labelledby="cookbook-plates-heading">
          <h2 id="cookbook-plates-heading">Plates</h2>
          <div class="cookbook-plates__grid">
            {plates.map(({ recipe, hasSpanish }) => (
              <a href={`/p/${recipe.id}`} class="cookbook-plate">
                <div class="cookbook-plate__image">
                  {recipe.data.heroImage ? (
                    <img
                      src={recipe.data.heroImage}
                      alt=""
                      class="cookbook-plate__img"
                      loading="lazy"
                    />
                  ) : (
                    <DefaultImage
                      alt=""
                      seed={recipe.id}
                      className="cookbook-plate__img"
                      loading="lazy"
                      width={800}
                      height={500}
                    />
                  )}
                </div>
                <span class="cookbook-plate__caption">
                  <span class="cookbook-plate__title">{recipe.data.title}</span>
                  {hasSpanish && !isSpanishPrimary(recipe.data) && (
                    <span class="cookbook-plate__es" lang="es">
                      ES
                    </span>
                  )}
                </span>
              </a>
            ))}
          </div>
        </section>
      </>
    ) : (
      <p class="text-body-muted">No recipes yet.</p>
    )
  }
</PageLayout>

<style>
  .cookbook-contents h2,
  .cookbook-plates h2 {
    margin: 0 0 1.5rem;
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .cookbook-plates {
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid rgb(var(--color-border) / 0.45);
  }

  .cookbook-plates__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem 1.25rem;
    margin: 0;
  }

  @media (min-width: 640px) {
    .cookbook-plates__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem 1.5rem;
    }
  }

  @media (min-width: 960px) {
    .cookbook-plates__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .cookbook-plate {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    text-decoration: none;
    color: inherit;
    outline: none;
  }

  .cookbook-plate:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 3px;
  }

  .cookbook-plate__image {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: rgb(var(--color-bg-alt));
  }

  .cookbook-plate__img,
  .cookbook-plate__image :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    margin: 0;
    border: none;
    transition: transform 0.45s var(--animation-easing-out);
  }

  .cookbook-plate:hover .cookbook-plate__img,
  .cookbook-plate:hover .cookbook-plate__image :global(img) {
    transform: scale(1.03);
  }

  .cookbook-plate__caption {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .cookbook-plate__title {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.25;
    color: rgb(var(--color-text));
  }

  .cookbook-plate__es {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: rgb(var(--color-accent));
  }

  .cookbook-contents__cols {
    column-count: 1;
    column-gap: 2.5rem;
  }

  @media (min-width: 640px) {
    .cookbook-contents__cols {
      column-count: 2;
    }
  }

  .cookbook-letter {
    break-inside: avoid;
    margin-bottom: 1.35rem;
  }

  .cookbook-letter h3 {
    margin: 0 0 0.35rem;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(var(--color-text-muted));
  }

  .cookbook-letter ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cookbook-letter li {
    margin: 0;
  }

  .cookbook-letter a {
    display: inline-block;
    padding: 0.15rem 0;
    font-family: var(--font-heading);
    font-size: 1.05rem;
    line-height: 1.35;
    color: rgb(var(--color-text));
    text-decoration: none;
  }

  .cookbook-letter a:hover {
    color: rgb(var(--color-accent));
  }

  @media (prefers-reduced-motion: reduce) {
    .cookbook-plate__img,
    .cookbook-plate__image :global(img) {
      transition: none;
    }

    .cookbook-plate:hover .cookbook-plate__img,
    .cookbook-plate:hover .cookbook-plate__image :global(img) {
      transform: none;
    }
  }
</style>
