---
import PageLayout from '../layouts/PageLayout.astro';
import Chapter from '../components/Chapter.astro';
import SeasonNavigation from '../components/SeasonNavigation.astro';
import { getCollection } from 'astro:content';
import { PAGE_META } from '../data/pageMeta';
import { isGuidedPathListedPost } from '../utils/recipes';
import { groupPostsBySeason } from '../utils/guidedPath';

const allPosts = await getCollection('blog', (post) => isGuidedPathListedPost(post));
const chapters = groupPostsBySeason(allPosts);
const firstPost = chapters[0]?.posts[0];
const totalPosts = chapters.reduce((total, chapter) => total + chapter.posts.length, 0);
---

<PageLayout
  title="Guided Path"
  description="Follow the writing season by season. Pick up wherever you like."
  descriptionClass="text-base md:text-lg max-w-[62ch]"
  metaDescription={PAGE_META['/guided-path']}
  path="/guided-path"
  mode="chrome"
>
  {
    firstPost ? (
      <div class="guided-path" data-guided-path>
        <SeasonNavigation chapters={chapters} totalPosts={totalPosts} firstPost={firstPost} />
        <div class="chapters" id="season-reading-list">
          {chapters.map((chapter) => (
            <Chapter posts={chapter.posts} chapterTitle={chapter.title} chapterId={chapter.id} />
          ))}
        </div>
      </div>
    ) : (
      <p class="guided-empty">The first season will appear here when there is writing to read.</p>
    )
  }
</PageLayout>

<script>
  import { getReadingProgress } from '../utils/guidedPath';

  const path = document.querySelector<HTMLElement>('[data-guided-path]');
  const service = window.ReadStateService?.getInstance();

  if (path && service) {
    const rows = Array.from(path.querySelectorAll<HTMLElement>('[data-guided-post]'));
    const slugs = rows.map((row) => row.dataset.guidedPost!);
    const isRead = (slug: string) => Boolean(service.getReadData(slug));

    const updateProgress = () => {
      const progress = getReadingProgress(slugs, isRead);
      const summary = path.querySelector<HTMLElement>('[data-reading-summary]');
      if (summary) {
        summary.textContent = `${progress.read} of ${progress.total} read`;
        summary.hidden = false;
      }
      rows.forEach((row) => {
        const read = isRead(row.dataset.guidedPost!);
        const indicator = row.querySelector<HTMLElement>('[data-read-status]');
        if (indicator) {
          indicator.textContent = read ? 'Read' : 'Unread';
          indicator.classList.toggle('is-read', read);
          indicator.hidden = false;
        }
      });
      path.querySelectorAll<HTMLElement>('[data-season]').forEach((season) => {
        const seasonSlugs = Array.from(
          season.querySelectorAll<HTMLElement>('[data-guided-post]'),
        ).map((row) => row.dataset.guidedPost!);
        const chapter = getReadingProgress(seasonSlugs, isRead);
        const indicator = season.querySelector<HTMLElement>('[data-chapter-read]');
        if (indicator) {
          indicator.textContent =
            chapter.remaining === 0 ? 'All read' : `${chapter.read} of ${chapter.total} read`;
          indicator.classList.toggle('is-complete', chapter.remaining === 0);
          indicator.hidden = false;
        }
      });
      const nextRow = rows.find((row) => !isRead(row.dataset.guidedPost!));
      const nextLink = path.querySelector<HTMLAnchorElement>('[data-next-unread]');
      const nextLabel = path.querySelector<HTMLElement>('[data-next-label]');
      const nextTitle = path.querySelector<HTMLElement>('[data-next-title]');
      if (nextLink && nextLabel && nextTitle) {
        nextLink.hidden = !nextRow;
        nextTitle.hidden = !nextRow;
        if (nextRow) {
          nextLink.href = nextRow.querySelector<HTMLAnchorElement>('.post-link')!.href;
          nextLabel.textContent = progress.read > 0 ? 'Next unread' : 'Start reading';
          nextTitle.textContent = nextRow.querySelector('.post-title')?.textContent ?? '';
        }
      }
      const complete = path.querySelector<HTMLElement>('[data-path-complete]');
      if (complete) complete.hidden = progress.remaining !== 0;
    };

    updateProgress();
    service.subscribeToAll(updateProgress);
  }
</script>

<style>
  .guided-path {
    display: grid;
    align-items: start;
    gap: 3rem;
    padding-top: 1rem;
    padding-bottom: clamp(4rem, 7vw, 7rem);
  }
  .chapters {
    display: grid;
    gap: clamp(3.5rem, 7vw, 6rem);
    min-width: 0;
  }
  .guided-empty {
    margin: 2rem 0 4rem;
    font-size: 1.125rem;
    line-height: 1.75;
  }
  @media (min-width: 1200px) {
    .guided-path {
      grid-template-columns: 14rem minmax(0, 1fr);
      column-gap: clamp(3rem, 5vw, 4.5rem);
      padding-top: 2rem;
    }
  }
</style>
