---
import PageLayout from '../../layouts/PageLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { series, type Series } from '../../data/series';
import { isCollectionListed } from '../../utils/publishFilters';
import { seriesPosts } from '../../utils/series';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => isCollectionListed(data));
  return series
    .map((entry) => ({ entry, parts: seriesPosts(posts, entry.id) }))
    .filter(({ parts }) => parts.length > 0)
    .map(({ entry, parts }) => ({ params: { series: entry.id }, props: { entry, parts } }));
}

interface Props {
  entry: Series;
  parts: Awaited<ReturnType<typeof getCollection<'blog'>>>;
}

const { entry, parts } = Astro.props;
---

<PageLayout
  title={entry.title}
  description={entry.description}
  metaDescription={`A series on Notes: ${entry.description}`.slice(0, 160)}
  path={`/series/${entry.id}`}
  structuredDataType="website"
  mode="chrome"
>
  <ol class="series-list" role="list">
    {parts.map((post, index) => (
      <li>
        <span class="series-list__part">Part {index + 1}</span>
        <PostCard
          post={post}
          headingAs="h2"
          idPrefix="series"
          imageLoading={index === 0 ? 'eager' : 'lazy'}
        />
      </li>
    ))}
  </ol>
</PageLayout>

<style>
  .series-list {
    display: grid;
    gap: var(--grid-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .series-list li {
    display: grid;
    gap: 0.5rem;
  }

  .series-list__part {
    color: rgb(var(--color-text-muted));
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
</style>
