---
import PageLayout from '../layouts/PageLayout.astro';
import PostCard from '../components/PostCard.astro';
import TopicIndex from '../components/browse/TopicIndex.astro';
import ContentFormPrelude from '../components/tag/ContentFormPrelude.astro';
import { getCollection } from 'astro:content';
import * as pkg from '../../package.json';
import { PAGE_META } from '../data/pageMeta';
import { getTagFamily } from '../data/tagFamilies';
import { getTagMetadata } from '../data/tags';
import { isTagListedPost } from '../utils/recipes';
import { calculateTagStats } from '../utils/tagProcessing';
import { canonicalizeTags } from '../utils/tagVocabulary';

/**
 * Browse, words first. One box searches every word of the English essays; the 14 sentences
 * and the A–Z rows run that search in place. Without JS there is no box, and every word opens
 * its topic page.
 */

// Newest first, then by id: the order of the word index's essays (browse-words.json.ts).
const posts = (await getCollection('blog', (entry) => isTagListedPost(entry))).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf() || a.id.localeCompare(b.id),
);
const { tagCounts } = calculateTagStats(posts);
const topics = Object.entries(tagCounts)
  .sort(([a], [b]) => a.localeCompare(b, 'en', { sensitivity: 'base' }))
  .map(([slug, count]) => ({
    slug,
    name: getTagMetadata(slug).name,
    count,
    family: getTagFamily(slug),
  }));

// Every essay ships as a hidden card. The search reads each card's title and description from the
// card itself, and its topics from data-topics, so only body words need a fetch.
const cards = posts.map((post) => {
  const tags = canonicalizeTags(post.data.tags);
  return {
    post,
    date: post.data.pubDate.toISOString().slice(0, 10),
    topicNames: tags.map((tag) => getTagMetadata(tag).name).join('|'),
    topicSlugs: tags.join('|'),
  };
});

// Body words come from the word index, fetched on first intent. The URL carries the release
// version, as the header's search index does, so a deploy busts the HTTP and service worker caches.
const wordsUrl = `/browse-words.json?v=${encodeURIComponent(pkg.version ?? 'dev')}`;
---

<PageLayout
  title="Browse"
  metaDescription={PAGE_META['/browse']}
  path="/browse"
  structuredDataType="website"
  mode="chrome"
>
  <div class="browse-page">
    <form
      class="browse-search"
      role="search"
      aria-labelledby="browse-q-label"
      data-words-url={wordsUrl}
    >
      <label id="browse-q-label" for="browse-q">
        Find a writing
      </label>
      <div class="browse-search__row">
        <input
          id="browse-q"
          name="q"
          type="search"
          autocomplete="off"
          spellcheck="false"
          enterkeyhint="search"
          aria-controls="browse-results"
          placeholder="Dad, Puerto Rico, money, God…"
        />
        <button type="button" class="browse-clear" aria-label="Clear search" hidden>
          Clear
        </button>
      </div>
      <p class="sr-only" id="browse-status" role="status" aria-live="polite" aria-atomic="true"></p>
    </form>
    <noscript>
      <style is:inline>
        .browse-search {
          display: none;
        }
      </style>
    </noscript>
    <script is:inline>
      // Before first paint: a ?q= link shows its query in the box, and a ?q= or ?topic= link keeps
      // the sentences from flashing in before the results replace them. The module script clears
      // the flag after it renders.
      (function () {
        const params = new URLSearchParams(location.search);
        const query = params.get('q');
        if (query && query.trim().length >= 2) {
          document.getElementById('browse-q').value = query;
        } else if (!params.get('topic')) {
          return;
        }
        document.documentElement.setAttribute('data-browse-q', '');
      })();
    </script>
    <section id="browse-results" class="browse-results" aria-labelledby="results-heading" hidden>
      <div class="browse-results__head">
        <h2 id="results-heading" tabindex="-1" class="heading-section"></h2>
        <p class="browse-results__aside" hidden></p>
      </div>
      <ol class="browse-grid" role="list">
        {cards.map(({ post, date, topicNames, topicSlugs }) => (
          <li
            data-slug={post.id}
            data-date={date}
            data-topics={topicNames}
            data-topic-slugs={topicSlugs}
            hidden
          >
            <PostCard post={post} headingAs="h3" idPrefix="browse" />
          </li>
        ))}
      </ol>
      <button type="button" class="browse-more" hidden>
        Show more
      </button>
    </section>

    <div class="browse-rest">
      <details id="topics" class="browse-topics">
        <summary>Every topic, A to Z</summary>
        <TopicIndex topics={topics} headingLevel={2} />
      </details>
      <div data-browse-ways>
        <ContentFormPrelude tagCounts={tagCounts} />
      </div>
    </div>
  </div>
</PageLayout>

<script>
  import {
    queryWords,
    searchEssays,
    type BrowseEssay,
    type WordIndex,
  } from '../utils/browseSearch';

  const PAGE_SIZE = 9;
  const TYPING_DELAY = 150;
  const SEARCHING = 'Searching the full text…';
  const UNLOADED = 'Titles, descriptions, and topics only: the full text didn’t load.';
  // Every sentence word and every A–Z row shows its topic's writings here instead of opening the
  // topic page. A topic is not a word search: "Poems" shows the poems, not every essay that says
  // "poem".
  const TOPIC_LINKS = '[data-browse-ways] a, .topic-row';

  /** A piece of this page's own markup, above. Missing is a bug in this file, not a state. */
  function part<T extends Element>(selector: string): T {
    const element = document.querySelector<T>(selector);
    if (!element) throw new Error(`browse: ${selector} is missing`);
    return element;
  }

  const page = part<HTMLElement>('.browse-page');
  const form = part<HTMLFormElement>('.browse-search');
  const input = part<HTMLInputElement>('#browse-q');
  const clear = part<HTMLButtonElement>('.browse-clear');
  const status = part<HTMLElement>('#browse-status');
  const results = part<HTMLElement>('#browse-results');
  const heading = part<HTMLElement>('#results-heading');
  const aside = part<HTMLElement>('.browse-results__aside');
  const grid = part<HTMLOListElement>('.browse-grid');
  const more = part<HTMLButtonElement>('.browse-more');
  const rest = part<HTMLElement>('.browse-rest');
  const fold = part<HTMLDetailsElement>('#topics');

  // Newest first, as the server wrote them; a topic lists its writings in this order.
  const items = [...grid.querySelectorAll<HTMLLIElement>(':scope > li')];
  const topicSlugsOf = new Map(
    items.map((item) => [item, (item.dataset.topicSlugs ?? '').split('|')]),
  );
  /** Topic slug to display name, from the links themselves. */
  const topicNames = new Map<string, string>();
  const itemBySlug = new Map(items.map((item) => [item.dataset.slug ?? '', item]));
  const essays: BrowseEssay[] = items.map((item) => ({
    slug: item.dataset.slug ?? '',
    date: item.dataset.date ?? '',
    title: item.querySelector('.postcard-title')?.textContent?.trim() ?? '',
    description: item.querySelector('.postcard-description')?.textContent?.trim() ?? '',
    topics: item.dataset.topics ? item.dataset.topics.split('|') : [],
    // The word search covers every essay. A topic is shown apart, from data-topic-slugs.
    topicSlugs: [],
  }));

  const wordsUrl = form.dataset.wordsUrl;
  let index: WordIndex | null = null;
  // 'absent' when the page ships no word index: the search then reads titles, descriptions, and
  // topics only, and says nothing about the full text.
  let indexState: 'absent' | 'idle' | 'loading' | 'ready' | 'failed' = wordsUrl ? 'idle' : 'absent';
  /** The topic being shown, when the box is empty. */
  let topic = '';
  let ranked: HTMLLIElement[] = [];
  let shown = 0;
  let typingTimer: number | undefined;

  /**
   * Fetches the word index once per visit, on the first sign of a search. A failed load stays
   * failed: the results say the full text is missing rather than refetching on every keystroke.
   */
  function ensureIndex() {
    if (indexState !== 'idle' || !wordsUrl) return;
    indexState = 'loading';
    fetch(wordsUrl, { credentials: 'same-origin' })
      .then((response) => {
        if (!response.ok) throw new Error(`browse words responded ${response.status}`);
        return response.json() as Promise<WordIndex>;
      })
      .then((data) => {
        if (!Array.isArray(data?.s) || !data.w) throw new Error('browse words are malformed');
        index = data;
        indexState = 'ready';
      })
      .catch(() => {
        indexState = 'failed';
      })
      .then(() => {
        // The mentions join the results already on screen, without resetting 'Show more'.
        if (!results.hidden) render({ keepShown: true });
      });
  }

  /** The heading counts the named writings; the aside, the ones that only mention the words. */
  function describe(named: number, mentioned: number, query: string) {
    const quoted = `“${query.trim().replace(/\s+/g, ' ')}”`;
    if (named > 0) {
      const title = `${named} ${named === 1 ? 'writing' : 'writings'} for ${quoted}`;
      if (indexState === 'loading') return { title, note: SEARCHING };
      if (indexState === 'failed') return { title, note: UNLOADED };
      return { title, note: mentioned > 0 ? `Mentioned in ${mentioned} more` : '' };
    }
    // No false 'No writing' while the body words are still on their way.
    if (indexState === 'loading') return { title: SEARCHING, note: '' };
    if (mentioned > 0) {
      const verb = mentioned === 1 ? 'writing mentions' : 'writings mention';
      return { title: `${mentioned} ${verb} ${quoted}`, note: '' };
    }
    return {
      title: `No writing mentions ${quoted}`,
      note: indexState === 'failed' ? UNLOADED : '',
    };
  }

  function reveal(count: number) {
    shown = Math.min(count, ranked.length);
    const visible = new Set(ranked.slice(0, shown));
    for (const item of items) item.hidden = !visible.has(item);
    const remaining = ranked.length - shown;
    more.hidden = remaining === 0;
    if (remaining > 0) more.textContent = `Show ${Math.min(PAGE_SIZE, remaining)} more`;
  }

  /** DOM order is rank order. A card already in its place is not moved, so it keeps its focus. */
  function arrange() {
    ranked.forEach((item, position) => {
      const current = grid.children[position];
      if (current !== item) grid.insertBefore(item, current ?? null);
    });
  }

  function render({ keepShown = false } = {}) {
    const query = input.value;
    const searching = queryWords(query).length > 0;
    const following = !searching && topicNames.has(topic);
    results.hidden = !searching && !following;
    clear.hidden = !searching && !following;

    if (following) {
      ranked = items.filter((item) => topicSlugsOf.get(item)?.includes(topic));
      arrange();
      reveal(keepShown ? Math.max(shown, PAGE_SIZE) : PAGE_SIZE);
      const count = ranked.length;
      const noun = count === 1 ? 'writing' : 'writings';
      heading.textContent = `${count} ${noun} in ${topicNames.get(topic)}`;
      aside.textContent = '';
      aside.hidden = true;
      rest.hidden = true;
      status.textContent = heading.textContent;
    } else if (!searching) {
      ranked = [];
      reveal(0);
      rest.hidden = false;
      status.textContent = '';
    } else {
      ensureIndex();
      const { named, mentioned } = searchEssays({ essays, index, query });
      ranked = [...named, ...mentioned].flatMap((slug) => itemBySlug.get(slug) ?? []);
      arrange();
      reveal(keepShown ? Math.max(shown, PAGE_SIZE) : PAGE_SIZE);

      const { title, note } = describe(named.length, mentioned.length, query);
      heading.textContent = title;
      aside.textContent = note;
      aside.hidden = !note;
      // With no match, the sentences and the A–Z show below as the way forward.
      rest.hidden = ranked.length > 0 || indexState === 'loading';
      status.textContent = note ? `${title}. ${note}` : title;
    }
    document.documentElement.removeAttribute('data-browse-q');
  }

  /** Typing edits the current history entry; only following a topic adds one. */
  function writeQuery() {
    const url = new URL(window.location.href);
    const query = input.value.trim();
    url.searchParams.delete('q');
    url.searchParams.delete('topic');
    if (queryWords(query).length > 0) url.searchParams.set('q', query);
    else if (topic) url.searchParams.set('topic', topic);
    window.history.replaceState(window.history.state, '', url);
  }

  function readQuery({ keepShown = false } = {}) {
    window.clearTimeout(typingTimer);
    const params = new URLSearchParams(window.location.search);
    input.value = params.get('q') ?? '';
    topic = params.get('topic') ?? '';
    render({ keepShown });
  }

  function clearSearch() {
    window.clearTimeout(typingTimer);
    input.value = '';
    topic = '';
    render();
    writeQuery();
    input.focus();
  }

  /** #topics and #topics-{letter} open the fold, then scroll to it or to the letter. */
  function revealTopics(behavior: ScrollBehavior) {
    const id = window.location.hash.slice(1);
    if (id !== 'topics' && !id.startsWith('topics-')) return;
    fold.open = true;
    document.getElementById(id)?.scrollIntoView({ behavior });
  }

  const topicHref = (slug: string) =>
    `${window.location.pathname}?topic=${encodeURIComponent(slug)}`;

  const topicLinkFrom = (target: EventTarget | null) =>
    target instanceof Element ? target.closest<HTMLAnchorElement>(TOPIC_LINKS) : null;

  // Each link's server href is its topic page, /tag/<slug>. A row names its topic in data-q; a
  // sentence link, in its own text.
  for (const link of page.querySelectorAll<HTMLAnchorElement>(TOPIC_LINKS)) {
    const slug = decodeURIComponent(link.pathname.replace(/^\/tag\//, '').replace(/\/$/, ''));
    topicNames.set(slug, link.dataset.q ?? link.textContent?.trim() ?? slug);
    link.dataset.topic = slug;
    // Middle-click, a new tab, and a copied link all give the topic here, not the topic page.
    link.href = topicHref(slug);
  }

  form.addEventListener('focusin', ensureIndex);

  input.addEventListener('input', () => {
    // Typing is a word search, so it leaves any topic.
    topic = '';
    window.clearTimeout(typingTimer);
    typingTimer = window.setTimeout(() => {
      render();
      writeQuery();
    }, TYPING_DELAY);
  });
  input.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || !input.value) return;
    event.preventDefault();
    clearSearch();
  });
  form.addEventListener('submit', (event) => {
    event.preventDefault();
    window.clearTimeout(typingTimer);
    render();
    writeQuery();
    if (results.hidden) return;
    // Leaving the box closes a phone's keyboard; the heading is where the results begin.
    input.blur();
    heading.focus({ preventScroll: true });
  });
  clear.addEventListener('click', clearSearch);

  more.addEventListener('click', () => {
    const first = ranked[shown];
    reveal(shown + PAGE_SIZE);
    first?.querySelector<HTMLAnchorElement>('.postcard-link')?.focus();
  });

  page.addEventListener('click', (event) => {
    const link = topicLinkFrom(event.target);
    if (!link || event.defaultPrevented || event.button !== 0) return;
    if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    event.preventDefault();
    const slug = link.dataset.topic ?? '';
    // Back returns to this spot: the same sentence, or the same row in the open fold.
    window.history.replaceState({ ...window.history.state, browseScrollY: window.scrollY }, '');
    window.history.pushState({}, '', topicHref(slug));
    window.clearTimeout(typingTimer);
    input.value = '';
    topic = slug;
    render();
    window.scrollTo({ top: 0, behavior: 'instant' });
    heading.focus({ preventScroll: true });
  });

  window.addEventListener('popstate', (event) => {
    // Only Back from results brings the sentences and the fold back, so only then can the browser's
    // own scroll restore come too early to reach them. Any other Back, such as from a letter jump,
    // restores itself, and the saved spot may be older than that.
    const restWasHidden = rest.hidden;
    readQuery();
    const scrollY = (event.state as { browseScrollY?: unknown } | null)?.browseScrollY;
    if (restWasHidden && !rest.hidden && typeof scrollY === 'number') {
      requestAnimationFrame(() => window.scrollTo({ top: scrollY, behavior: 'instant' }));
    }
  });
  window.addEventListener('pageshow', (event) => {
    // Back from an essay finds the results as they were left, 'Show more' cards included.
    if (event.persisted) readQuery({ keepShown: true });
  });
  // An open fold is already where it should be: the browser scrolled to a letter jump itself, and
  // Back to a row has its place restored by popstate, which this scroll would undo.
  window.addEventListener('hashchange', () => {
    if (!fold.open) revealTopics('auto');
  });

  // The box works from first paint, so a reader may have typed before this script ran: their words
  // win over the URL's. Otherwise the box takes the URL's query.
  const urlQuery = new URLSearchParams(window.location.search).get('q') ?? '';
  if (input.value && input.value !== urlQuery) {
    render();
    writeQuery();
  } else {
    readQuery();
  }
  revealTopics('instant');
</script>

<style>
  .browse-page {
    padding-top: 1rem;
    padding-bottom: round(nearest, clamp(4rem, 7vw, 7rem), 4px);
  }
  .browse-page [hidden] {
    display: none !important;
  }
  /* A ?q= link hides the sentences before first paint (the inline script above sets the flag). */
  :global(:root[data-browse-q]) .browse-rest {
    display: none;
  }

  /* ---------- The box. */
  .browse-search label {
    display: block;
    margin: 0 0 0.75rem;
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 600;
    line-height: var(--leading-normal);
  }
  .browse-search__row {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .browse-search input {
    flex: 1 1 auto;
    min-width: 0;
    max-width: var(--measure);
    min-height: 3rem;
    margin: 0;
    padding: 0.75rem 1rem;
    border: 1px solid rgb(var(--color-border));
    border-radius: var(--radius-lg);
    background: rgb(var(--color-bg-alt));
    color: rgb(var(--color-text));
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: var(--leading-normal);
  }
  .browse-search input::placeholder {
    color: rgb(var(--color-text-muted));
    opacity: 1;
  }
  /* Clear is the one clear control. */
  .browse-search input::-webkit-search-cancel-button {
    -webkit-appearance: none;
    appearance: none;
  }
  .browse-clear,
  .browse-more {
    display: inline-flex;
    align-items: center;
    flex: none;
    min-height: 2.75rem;
    padding: 0.5rem 0;
    border: 0;
    background: transparent;
    color: rgb(var(--color-accent));
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 600;
    line-height: var(--leading-normal);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }
  .browse-clear:hover,
  .browse-more:hover {
    color: rgb(var(--color-accent-hover));
  }

  /* ---------- Results: photographs on Home's twelve-column grid. */
  .browse-results {
    margin-top: 2.5rem;
  }
  .browse-results__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    margin-bottom: 1.5rem;
  }
  /* Only script focuses the heading, so it draws no ring. The base :focus-visible ring is a
     box-shadow, not an outline, so that goes too. */
  .browse-results__head h2:focus {
    outline: none;
    box-shadow: none;
  }
  .browse-results__aside {
    margin: 0;
    color: rgb(var(--color-text-muted));
    font-family: var(--font-sans);
    font-size: 0.875rem;
    line-height: var(--leading-normal);
    font-variant-numeric: tabular-nums;
  }
  .browse-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--grid-gap);
    row-gap: 2.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .browse-grid > li {
    grid-column: span 12;
    min-width: 0;
    margin: 0;
    padding: 0;
  }
  .browse-more {
    margin-top: 2rem;
  }

  /* ---------- At rest: the A–Z fold, then the sentences. */
  .browse-topics {
    margin-top: 1rem;
    scroll-margin-top: calc(var(--site-header-height) + 2rem);
  }
  .browse-topics > summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    min-height: 2.75rem;
    list-style: none;
    color: rgb(var(--color-accent));
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 600;
    line-height: var(--leading-normal);
    cursor: pointer;
  }
  .browse-topics > summary::-webkit-details-marker {
    display: none;
  }
  /* Text presentation, so no platform draws the marker as an emoji; screen readers skip it. */
  .browse-topics > summary::before {
    content: '\25B6\FE0E';
    content: '\25B6\FE0E' / '';
    font-size: 0.75rem;
    transition: transform 0.2s ease;
  }
  .browse-topics[open] > summary::before {
    transform: rotate(90deg);
  }
  .browse-topics > summary:hover {
    color: rgb(var(--color-accent-hover));
  }
  .browse-topics > :global(.topic-index) {
    margin-top: 1.5rem;
  }
  .browse-rest > [data-browse-ways] {
    margin-top: 3rem;
  }

  .browse-search input:focus-visible,
  .browse-clear:focus-visible,
  .browse-more:focus-visible,
  .browse-topics > summary:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 4px;
    /* The base layer's ring is a box-shadow with a white offset, which would double this one and
       show as a white band in dark mode. */
    box-shadow: none;
  }

  @media (min-width: 768px) {
    .browse-grid > li {
      grid-column: span 6;
    }
  }
  @media (min-width: 1024px) {
    .browse-grid > li {
      grid-column: span 4;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .browse-topics > summary::before {
      transition: none;
    }
  }
</style>
