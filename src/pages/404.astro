---
import PageLayout from '../layouts/PageLayout.astro';
import NotFoundQuote from '../components/NotFoundQuote.astro';
import { PAGE_META } from '../data/pageMeta';
import { getCollection } from 'astro:content';
import { getAllUniqueTags } from '../utils/tagProcessing';
import { isCollectionListed } from '../utils/publishFilters';

const posts = await getCollection('blog', ({ data }) => isCollectionListed(data));
const existingTags = getAllUniqueTags(posts);
---

<PageLayout
  title="Page not found"
  description="A random line from the quote archive."
  metaDescription={PAGE_META['/404']}
  robots="noindex, follow"
>
  <div class="not-prose mx-auto max-w-3xl">
    <NotFoundQuote existingTags={existingTags} />
  </div>
</PageLayout>
