---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import CategoryCard from '../../components/CategoryCard.astro';
import Container from '../../components/Container.astro';
import { getCollection } from 'astro:content';
import { categories } from '../../data/categories';
import { PAGE_META } from '../../data/pageMeta';
import { isCategoryListedPost } from '../../utils/recipes';

const posts = await getCollection('blog', (entry) => isCategoryListedPost(entry));

const postCounts = Object.fromEntries(
  categories.map((c) => [c.id, posts.filter((post) => post.data.category?.includes(c.id)).length]),
) as Record<string, number>;

const alphabetical = categories
  .filter((category) => postCounts[category.id] > 0)
  .sort((a, b) => a.name.localeCompare(b.name));
---

<BaseLayout
  title="Categories"
  description="Browse writings by high-level themes—parenting, psychology, systems, and more."
  metaDescription={PAGE_META['/category']}
  path="/category"
  structuredDataType="website"
>
  <Container>
    <div class="category-page">
      <PageHeader
        title="Categories"
        description="Choose a subject to find the writings filed there. From A to Z."
      />

      {
        alphabetical.length > 0 ? (
          <section class="category-directory" aria-label="Categories, A to Z">
            <ul class="category-grid" role="list">
              {alphabetical.map((category) => (
                <li>
                  <CategoryCard category={category} postCount={postCounts[category.id]} />
                </li>
              ))}
            </ul>
          </section>
        ) : (
          <section class="category-empty" aria-labelledby="category-empty-heading">
            <h2 id="category-empty-heading">Nothing filed yet</h2>
            <p>Categories will populate once drafts are published.</p>
          </section>
        )
      }

      <aside class="category-disclaimer" aria-labelledby="category-disclaimer-heading">
        <h2 id="category-disclaimer-heading">Fair warning</h2>
        <div class="category-disclaimer__copy">
          <p>
            I opened a category the way a stranger would. The organization is a nightmare. It kind
            of has to be: these notes do not concentrate into a clean shape of any kind, so a pile
            of one topic is not the best way to read me. If it looks like the person who filed this
            has lost it, you are not wrong.
          </p>
          <p>
            <a href="/tag">Topics</a> follow how the ideas actually connect. Categories are just where
            each note got stamped first.
          </p>
        </div>
      </aside>
    </div>
  </Container>
</BaseLayout>

<style>
  .category-page {
    padding-bottom: 4rem;
  }

  .category-directory {
    margin-top: 1rem;
  }

  .category-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .category-grid > li {
    min-width: 0;
    margin: 0;
    padding: 0;
  }

  .category-disclaimer {
    display: grid;
    gap: 1.5rem;
    margin-top: 3.5rem;
  }

  .category-disclaimer h2,
  .category-empty h2 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 2.4vw, 2rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.025em;
  }

  .category-disclaimer__copy {
    display: grid;
    gap: 1.5rem;
    min-width: 0;
    max-width: 68ch;
  }

  .category-disclaimer p,
  .category-empty p {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.7;
    color: rgb(var(--color-text-muted));
    text-wrap: pretty;
  }

  .category-disclaimer a {
    color: rgb(var(--color-accent));
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .category-disclaimer a:hover {
    color: rgb(var(--color-accent-hover));
  }

  .category-disclaimer a:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 4px;
    border-radius: 2px;
  }

  .category-empty {
    display: grid;
    gap: 1rem;
    padding-block: 2rem;
  }

  @media (min-width: 768px) {
    .category-page {
      padding-bottom: 5rem;
    }

    .category-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2.5rem;
    }

    .category-disclaimer {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      gap: 2.5rem;
      margin-top: 5rem;
    }
  }

  @media (min-width: 1024px) {
    .category-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .category-disclaimer {
      margin-top: 6rem;
    }
  }
</style>
