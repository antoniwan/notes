---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import PageHeader from '../../components/PageHeader.astro';
import Container from '../../components/Container.astro';
import { getCollection } from 'astro:content';
import { categories } from '../../data/categories';
import { categoryMetaDescription } from '../../data/pageMeta';
import { isCategoryListedPost } from '../../utils/recipes';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (entry) => isCategoryListedPost(entry));

  return categories
    .filter((category) => posts.some((post) => post.data.category?.includes(category.id)))
    .map((category) => ({
      params: { category: category.id },
      props: { category },
    }));
}

const { category } = Astro.props;
const posts = await getCollection('blog', (entry) => isCategoryListedPost(entry));
const categoryPosts = posts.filter((post) => post.data.category?.includes(category.id));

const primaryCategoryPosts = categoryPosts
  .filter((post) => post.data.category?.[0] === category.id)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const secondaryCategoryPosts = categoryPosts
  .filter(
    (post) => post.data.category?.[0] !== category.id && post.data.category?.includes(category.id),
  )
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const hasBothGroups = primaryCategoryPosts.length > 0 && secondaryCategoryPosts.length > 0;
const robots = categoryPosts.length > 0 ? 'index, follow' : 'noindex, follow';
---

<BaseLayout
  title={category.name}
  description={category.description}
  metaDescription={categoryMetaDescription(category)}
  path={`/category/${category.id}`}
  robots={robots}
  structuredDataType="category"
  structuredDataIdentifier={category.id}
  posts={categoryPosts}
>
  <Container>
    <div class="subject-page">
      <PageHeader
        title={`${category.icon} ${category.name}`}
        description={category.description}
        descriptionClass="text-base md:text-lg max-w-[62ch]"
      />

      <div class="subject-navigation">
        <a class="subject-back" href="/category">
          <span aria-hidden="true">←</span>
          All categories
        </a>
        {
          hasBothGroups && (
            <nav aria-label="On this category page" class="subject-jumps">
              <a href="#writings-heading">
                Writings <span>{primaryCategoryPosts.length}</span>
              </a>
              <a href="#related-writings-heading">
                Related <span>{secondaryCategoryPosts.length}</span>
              </a>
            </nav>
          )
        }
      </div>

      <div class="subject-collections">
        {
          primaryCategoryPosts.length > 0 && (
            <section id="writings" class="subject-collection" aria-labelledby="writings-heading">
              <div class="collection-heading">
                <h2 id="writings-heading" tabindex="-1">
                  Writings
                </h2>
                <p class="collection-count">
                  {primaryCategoryPosts.length}{' '}
                  {primaryCategoryPosts.length === 1 ? 'writing' : 'writings'}
                </p>
              </div>
              <div class="postcards-grid subject-grid">
                {primaryCategoryPosts.map((post, index) => (
                  <PostCard
                    post={post}
                    featured={post.data.featured}
                    headingAs="h3"
                    imageLoading={index === 0 ? 'eager' : 'lazy'}
                  />
                ))}
              </div>
            </section>
          )
        }

        {
          secondaryCategoryPosts.length > 0 && (
            <section
              id="related-writings"
              class="subject-collection"
              aria-labelledby="related-writings-heading"
            >
              <div class="collection-heading">
                <h2 id="related-writings-heading" tabindex="-1">
                  Related writings
                </h2>
                <p class="collection-count">
                  {secondaryCategoryPosts.length}{' '}
                  {secondaryCategoryPosts.length === 1 ? 'writing' : 'writings'}
                </p>
                <p class="collection-description">
                  Writings that touch on {category.name} as a secondary topic.
                </p>
              </div>
              <div class="postcards-grid subject-grid">
                {secondaryCategoryPosts.map((post, index) => (
                  <PostCard
                    post={post}
                    featured={post.data.featured}
                    headingAs="h3"
                    imageLoading={
                      primaryCategoryPosts.length === 0 && index === 0 ? 'eager' : 'lazy'
                    }
                  />
                ))}
              </div>
            </section>
          )
        }

        {
          categoryPosts.length === 0 && (
            <p class="subject-empty">No writings found in this category yet.</p>
          )
        }
      </div>
    </div>
  </Container>
</BaseLayout>

<style>
  .subject-page {
    padding-bottom: clamp(4rem, 7vw, 6rem);
  }

  .subject-navigation {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
  }

  .subject-back,
  .subject-jumps a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.5rem;
    color: rgb(var(--color-accent));
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.5;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .subject-back:hover,
  .subject-jumps a:hover {
    color: rgb(var(--color-accent-hover));
  }

  .subject-back:focus-visible,
  .subject-jumps a:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 4px;
    border-radius: 2px;
  }

  .subject-jumps {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }

  .subject-jumps a span {
    color: rgb(var(--color-text-muted));
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
    font-weight: 400;
  }

  .subject-collections {
    display: grid;
    gap: clamp(4rem, 7vw, 6rem);
    margin-top: 2.5rem;
  }

  .subject-collection {
    min-width: 0;
    scroll-margin-top: calc(var(--site-header-height, 4rem) + 2rem);
  }

  .collection-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem 1rem;
    margin-bottom: 2rem;
  }

  .collection-heading h2 {
    margin: 0;
    scroll-margin-top: calc(var(--site-header-height, 4rem) + 2rem);
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 2.4vw, 2rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.025em;
  }

  .collection-count {
    margin: 0;
    color: rgb(var(--color-text-muted));
    font-family: var(--font-sans);
    font-size: 0.875rem;
    line-height: 1.5;
    font-variant-numeric: tabular-nums;
  }

  .collection-description,
  .subject-empty {
    flex-basis: 100%;
    max-width: 62ch;
    margin: 0;
    color: rgb(var(--color-text-muted));
    font-size: 1.125rem;
    line-height: 1.7;
    text-wrap: pretty;
  }

  .subject-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .subject-collections {
      margin-top: 3rem;
    }

    .collection-heading {
      margin-bottom: 2.5rem;
    }

    .subject-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2.5rem;
    }
  }

  @media (min-width: 1024px) {
    .subject-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
