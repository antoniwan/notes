---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../Container.astro';
import FieldGuideCover from './FieldGuideCover.astro';
import FieldGuideSearch from './FieldGuideSearch.astro';
import {
  FIELD_GUIDE_COPY,
  FIELD_GUIDE_ROOT,
  FIELD_GUIDE_SHELVES,
  fieldGuideLetter,
  fieldGuideShelfPath,
  type FieldGuideLang,
} from '../../data/fieldGuide';
import { getFieldGuide, type ShelvedEntry } from '../../utils/fieldGuide';
import { generateCanonicalUrl } from '../../utils/seo';
import { hreflangFor } from '../../utils/ogLocale';
import { PAGE_META } from '../../data/pageMeta';

interface Props {
  lang: FieldGuideLang;
}

const { lang } = Astro.props;
const copy = FIELD_GUIDE_COPY[lang];
const entries = (await getFieldGuide()).filter(({ entry }) => entry.data.language === lang);

function topicOf(item: ShelvedEntry) {
  return 'topic' in item.entry.data ? item.entry.data.topic : undefined;
}

const concepts = entries.filter((e) => e.kind === 'concepts');
const values = entries.filter((e) => e.kind === 'values');
const beliefs = entries.filter((e) => e.kind === 'beliefs');
const letters = [...new Set(concepts.map((e) => fieldGuideLetter(e.entry.data.title)))].sort();
const topics = [...new Set(beliefs.map(topicOf).filter(Boolean))].sort() as string[];
const conceptsPath = fieldGuideShelfPath('concepts', lang);
const letterHref = (letter: string) =>
  `${conceptsPath}#g-${letter === '#' ? '-' : letter.toLowerCase()}`;
const topicHref = (topic: string) =>
  `${fieldGuideShelfPath('beliefs', lang)}#g-${topic
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')}`;
const shelf = (kind: 'concepts' | 'values' | 'beliefs') => FIELD_GUIDE_SHELVES[kind][lang];

const hreflangAlternates = [
  { hreflang: 'en', href: generateCanonicalUrl(FIELD_GUIDE_ROOT.en) },
  { hreflang: 'es-PR', href: generateCanonicalUrl(FIELD_GUIDE_ROOT.es) },
  { hreflang: 'x-default', href: generateCanonicalUrl(FIELD_GUIDE_ROOT.en) },
];
const other = lang === 'en' ? 'es' : 'en';
const [titleFirst, ...titleRest] = copy.title.split(' ');
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  metaDescription={PAGE_META[FIELD_GUIDE_ROOT[lang]]}
  path={FIELD_GUIDE_ROOT[lang]}
  structuredDataType="website"
  htmlLang={lang}
  locale={lang === 'es' ? 'es_PR' : undefined}
  inLanguage={lang === 'es' ? 'es-PR' : 'en-US'}
  hreflangAlternates={hreflangAlternates}
>
  <Container class="field-guide">
    <div class="guide-top">
      <header class="guide-intro">
        <h1>
          {titleFirst} <em>{titleRest.join(' ')}</em>
        </h1>
        <p class="guide-intro__description">{copy.description}</p>
        <a
          class="guide-intro__language"
          href={FIELD_GUIDE_ROOT[other]}
          hreflang={hreflangFor(other)}
        >
          <span lang={other}>{other === 'es' ? 'En español' : 'In English'}</span>
          <span aria-hidden="true">↗</span>
        </a>
      </header>

      <div class="guide-top__cover">
        <FieldGuideCover lines={copy.cover.map((line) => line.toUpperCase())} />
      </div>

      <div class="guide-find">
        <FieldGuideSearch
          label={copy.searchLabel}
          placeholder={copy.search}
          empty={copy.noResults}
          target="guide-results"
          reveal
        />
        <ul id="guide-results" class="guide-results" role="list" hidden>
          {entries.map((item) => (
            <li data-fg-text={`${item.entry.data.title} ${item.entry.data.summary}`}>
              <a href={item.path}>
                <span class="guide-results__kind">
                  {FIELD_GUIDE_SHELVES[item.kind][lang].singular}
                </span>
                <span class="guide-results__title">{item.entry.data.title}</span>
                <span class="guide-results__summary">{item.entry.data.summary}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="guide-doors">
      <section class="guide-door guide-door--concepts" aria-labelledby="door-concepts">
        <a class="guide-door__head" href={conceptsPath}>
          <h2 id="door-concepts">{shelf('concepts').name}</h2>
          <span class="guide-door__count">
            {concepts.length} {copy.entries}
          </span>
        </a>
        <p class="guide-door__blurb">{shelf('concepts').blurb}</p>
        <nav class="guide-door__letters" aria-label="A–Z">
          {letters.map((letter) => (
            <a href={letterHref(letter)}>{letter}</a>
          ))}
        </nav>
        <a class="guide-door__more" href={conceptsPath}>
          {copy.browseAll} <span aria-hidden="true">→</span>
        </a>
      </section>

      <section class="guide-door" aria-labelledby="door-values">
        <a class="guide-door__head" href={fieldGuideShelfPath('values', lang)}>
          <h2 id="door-values">{shelf('values').name}</h2>
          <span class="guide-door__count">
            {values.length} {copy.entries}
          </span>
        </a>
        <p class="guide-door__blurb">{shelf('values').blurb}</p>
        <ul class="guide-door__chips" role="list">
          {values.map((item) => (
            <li>
              <a href={item.path}>{item.entry.data.title}</a>
            </li>
          ))}
        </ul>
      </section>

      <section class="guide-door" aria-labelledby="door-beliefs">
        <a class="guide-door__head" href={fieldGuideShelfPath('beliefs', lang)}>
          <h2 id="door-beliefs">{shelf('beliefs').name}</h2>
          <span class="guide-door__count">
            {beliefs.length} {copy.entries}
          </span>
        </a>
        <p class="guide-door__blurb">{shelf('beliefs').blurb}</p>
        <ul class="guide-door__topics" role="list">
          {topics.map((topic) => (
            <li>
              <a href={topicHref(topic)}>
                {copy.topic} {topic}
              </a>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </Container>
</BaseLayout>

<style>
  /* Condensed: title on one line, then the line and search. The cover only shows where there's room for it. */
  .guide-top {
    display: grid;
    padding-top: round(nearest, clamp(1.5rem, 3vw, 2.5rem), 4px);
  }

  .guide-intro h1 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(2.25rem, 6vw, 3.5rem);
    font-weight: 600;
    line-height: var(--leading-none);
    letter-spacing: -0.045em;
  }

  .guide-intro h1 em {
    color: rgb(var(--color-accent));
    font-weight: 500;
  }

  .guide-intro__description {
    max-width: var(--measure);
    margin: 0.75rem 0 0;
    color: rgb(var(--color-text-muted));
    font-size: 1rem;
    line-height: var(--leading-relaxed);
    text-wrap: pretty;
  }

  .guide-top__cover {
    display: none;
  }

  .guide-intro__language {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    min-height: 2.25rem;
    margin-top: 0.25rem;
    color: rgb(var(--color-text));
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
  }

  .guide-intro__language span[aria-hidden] {
    color: rgb(var(--color-accent));
  }

  .guide-intro__language:hover {
    color: rgb(var(--color-accent));
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .guide-find {
    max-width: var(--measure);
    padding-block: 1rem 3rem;
  }

  .guide-results {
    display: grid;
    gap: 0.25rem;
    max-height: 28rem;
    margin: 1rem 0 0;
    padding: 0;
    overflow-y: auto;
    list-style: none;
  }

  .guide-results a {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    gap: 0.25rem 1rem;
    padding: 0.5rem 0;
    color: inherit;
    text-decoration: none;
  }

  .guide-results__kind {
    grid-row: span 2;
    padding-top: 0.25rem;
    color: rgb(var(--color-text-muted));
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .guide-results__title {
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 600;
  }

  .guide-results__summary {
    color: rgb(var(--color-text-muted));
    font-size: 0.9375rem;
  }

  .guide-results a:hover .guide-results__title {
    color: rgb(var(--color-accent));
  }

  /* No boxes: each shelf is a heading, a line, and its way in. Space does the separating. */
  .guide-doors {
    display: grid;
    gap: 3.5rem 4rem;
    padding-block: 0 6rem;
  }

  .guide-door {
    display: grid;
    align-content: start;
    gap: 0.75rem;
  }

  .guide-door__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    color: inherit;
    text-decoration: none;
  }

  .guide-door__head h2 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .guide-door__head:hover h2 {
    color: rgb(var(--color-accent));
  }

  .guide-door__count {
    color: rgb(var(--color-accent));
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .guide-door__blurb {
    margin: 0;
    color: rgb(var(--color-text-muted));
    line-height: var(--leading-normal);
  }

  /* A thumb index, like the edge of a dictionary. */
  .guide-door__letters {
    display: flex;
    flex-wrap: wrap;
    margin-top: 0.25rem;
  }

  .guide-door__letters a {
    display: grid;
    place-items: center;
    min-width: 2.5rem;
    height: 2.75rem;
    color: rgb(var(--color-accent));
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 600;
    text-decoration: none;
  }

  .guide-door__letters a:hover {
    color: rgb(var(--color-text));
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .guide-door__more {
    width: fit-content;
    margin-top: 0.25rem;
    color: rgb(var(--color-accent));
    font-weight: 600;
    text-decoration: none;
  }

  .guide-door__more:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .guide-door__chips,
  .guide-door__topics {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .guide-door__chips a,
  .guide-door__topics a {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    color: rgb(var(--color-text));
    font-family: var(--font-heading);
    font-size: 1.0625rem;
    text-decoration: none;
  }

  .guide-door__topics a {
    font-style: italic;
  }

  .guide-door__chips a:hover,
  .guide-door__topics a:hover {
    color: rgb(var(--color-accent));
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .guide-door a:focus-visible,
  .guide-results a:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 2px;
  }

  @media (min-width: 768px) {
    .guide-top {
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: 4rem;
    }

    .guide-top__cover {
      display: block;
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: start;
    }

    .guide-top__cover :global(.guide-cover) {
      width: 9rem;
      margin-right: 2rem;
    }

    .guide-doors {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .guide-door--concepts {
      grid-column: 1 / -1;
    }
  }
</style>
