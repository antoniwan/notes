---
/**
 * A filter box for a list of entries. Items carry `data-fg-text`; groups that
 * end up empty (`data-fg-group`) hide too. With `reveal`, the list stays hidden
 * until there's a query, which is how the index searches the whole guide.
 */
interface Props {
  label: string;
  placeholder: string;
  empty: string;
  target: string;
  reveal?: boolean;
}

const { label, placeholder, empty, target, reveal = false } = Astro.props;
---

<div class="guide-search" data-fg-search={target} data-fg-reveal={reveal ? '' : undefined}>
  <label class="sr-only" for={`${target}-input`}>
    {label}
  </label>
  <svg class="guide-search__icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
    <circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
    <path d="M13 13l4.5 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
  </svg>
  <input
    id={`${target}-input`}
    class="guide-search__input"
    type="search"
    placeholder={placeholder}
    autocomplete="off"
    spellcheck="false"
  />
  <p class="guide-search__empty" hidden>
    {empty}
  </p>
</div>

<script>
  function fold(text: string) {
    return text.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
  }

  for (const box of document.querySelectorAll<HTMLElement>('[data-fg-search]')) {
    const scope = document.getElementById(box.dataset.fgSearch ?? '');
    const input = box.querySelector('input');
    const empty = box.querySelector<HTMLElement>('.guide-search__empty');
    if (!scope || !input || !empty) continue;

    const reveal = box.hasAttribute('data-fg-reveal');
    const items = [...scope.querySelectorAll<HTMLElement>('[data-fg-text]')].map((el) => ({
      el,
      text: fold(el.dataset.fgText ?? ''),
    }));
    const groups = [...scope.querySelectorAll<HTMLElement>('[data-fg-group]')];

    const run = () => {
      const words = fold(input.value).split(/\s+/).filter(Boolean);
      let shown = 0;
      for (const { el, text } of items) {
        const match = words.every((w) => text.includes(w));
        el.hidden = !match;
        if (match) shown += 1;
      }
      for (const group of groups) {
        group.hidden = !group.querySelector('[data-fg-text]:not([hidden])');
      }
      if (reveal) scope.hidden = words.length === 0;
      empty.hidden = shown > 0 || (reveal && words.length === 0);
    };

    input.addEventListener('input', run);
    if (input.value) run();
  }
</script>

<style>
  .guide-search {
    position: relative;
    max-width: var(--measure);
  }

  .guide-search__icon {
    position: absolute;
    top: 50%;
    left: 1rem;
    width: 1.125rem;
    height: 1.125rem;
    color: rgb(var(--color-text-muted));
    transform: translateY(-50%);
    pointer-events: none;
  }

  .guide-search__input {
    width: 100%;
    min-height: 3rem;
    padding: 0.75rem 1rem 0.75rem 2.75rem;
    border: 1px solid rgb(var(--color-border));
    border-radius: 999px;
    background: rgb(var(--color-surface-1));
    color: rgb(var(--color-text));
    font-family: var(--font-sans);
    font-size: 1rem;
  }

  .guide-search__input:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 2px;
  }

  .guide-search__empty {
    margin: 1rem 0 0;
    color: rgb(var(--color-text-muted));
    font-size: 0.9375rem;
  }
</style>
