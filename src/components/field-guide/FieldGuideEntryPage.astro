---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../Container.astro';
import FormattedDate from '../FormattedDate.astro';
import {
  FIELD_GUIDE_COPY,
  FIELD_GUIDE_ROOT,
  FIELD_GUIDE_SHELVES,
  fieldGuideShelfPath,
} from '../../data/fieldGuide';
import { generateCanonicalUrl } from '../../utils/seo';
import { generateBreadcrumbSchema } from '../../utils/structuredData';
import { getFieldGuide, type ShelvedEntry } from '../../utils/fieldGuide';

interface Props {
  item: ShelvedEntry;
  twin?: ShelvedEntry;
}

const { item, twin } = Astro.props;
const { entry, kind, path } = item;
const lang = entry.data.language;
const copy = FIELD_GUIDE_COPY[lang];
const shelf = FIELD_GUIDE_SHELVES[kind][lang];
const origin = 'origin' in entry.data ? entry.data.origin : undefined;
const { Content } = await render(entry);

// The sidebar is a way to move, not a table of contents: back to the shelf,
// the neighbours on either side, and for a belief, the rest of its topic.
const shelfItems = (await getFieldGuide()).filter(
  (other) => other.kind === kind && other.entry.data.language === lang,
);
const index = shelfItems.findIndex((other) => other.path === path);
const previous = index > 0 ? shelfItems[index - 1] : undefined;
const next = index < shelfItems.length - 1 ? shelfItems[index + 1] : undefined;
const topic = 'topic' in entry.data ? entry.data.topic : undefined;
const sameTopic = topic
  ? shelfItems.filter(
      (other) => 'topic' in other.entry.data && other.entry.data.topic === topic && other !== item,
    )
  : [];
const shelfPath = fieldGuideShelfPath(kind, lang);

const twinLabel = twin?.entry.data.language === 'es' ? 'Español' : 'English';

const hreflangAlternates = twin
  ? [
      ...[item, twin].map((t) => ({
        hreflang: t.entry.data.language,
        href: generateCanonicalUrl(t.path),
      })),
      {
        hreflang: 'x-default',
        href: generateCanonicalUrl(lang === 'en' ? path : twin.path),
      },
    ]
  : undefined;

// An entry has no publish date, only "revised", so it is described as a
// defined term in its shelf rather than as a blog post.
const url = generateCanonicalUrl(path);
const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'DefinedTerm',
    name: entry.data.title,
    description: entry.data.summary,
    url,
    inLanguage: lang === 'es' ? 'es-PR' : 'en-US',
    dateModified: entry.data.revised.toISOString(),
    inDefinedTermSet: {
      '@type': 'DefinedTermSet',
      name: `${shelf.name} · ${copy.title}`,
      url: generateCanonicalUrl(shelfPath),
    },
  },
  generateBreadcrumbSchema([
    { name: copy.title, url: generateCanonicalUrl(FIELD_GUIDE_ROOT[lang]) },
    { name: shelf.name, url: generateCanonicalUrl(shelfPath) },
    { name: entry.data.title, url },
  ]),
];
---

<BaseLayout
  title={entry.data.title}
  titleSuffix={copy.title}
  description={entry.data.summary}
  path={path}
  type="article"
  articleSection={copy.title}
  updatedDate={entry.data.revised}
  additionalSchemas={schemas}
  htmlLang={lang}
  locale={lang === 'es' ? 'es_PR' : undefined}
  inLanguage={lang === 'es' ? 'es-PR' : 'en-US'}
  hreflangAlternates={hreflangAlternates}
>
  <Container class="guide-entry-shell field-guide">
    <div class="guide-entry">
      <header class="guide-entry__heading">
        <a class="guide-entry__eyebrow" href={shelfPath}>
          <span aria-hidden="true" class="guide-entry__mark"></span>
          {shelf.singular}
        </a>
        <h1 id="guide-entry-title" class="guide-entry__title">
          {entry.data.title}
        </h1>
        <p class="guide-entry__description">{entry.data.summary}</p>
        <p class="guide-entry__byline">
          {origin && (
            <span>
              {copy.origin} {origin}
            </span>
          )}
          <span>
            {copy.revised}{' '}
            <FormattedDate date={entry.data.revised} format="short" language={lang} />
          </span>
          {twin && (
            <a
              href={twin.path}
              hreflang={twin.entry.data.language}
              lang={twin.entry.data.language}
              rel="alternate"
            >
              {twinLabel}
            </a>
          )}
        </p>
      </header>

      <nav
        class:list={[
          'guide-entry__sidebar',
          { 'guide-entry__sidebar--topic': sameTopic.length > 0 },
        ]}
        aria-label={copy.title}
      >
        <a class="guide-entry__guide-link" href={FIELD_GUIDE_ROOT[lang]}>
          {copy.title}
        </a>
        <a class="guide-entry__shelf-link" href={shelfPath}>
          <span aria-hidden="true">←</span>
          {shelf.name}
        </a>
        <div class="guide-entry__steps">
          {previous && (
            <a href={previous.path} rel="prev">
              <span class="guide-entry__label">{copy.previous}</span>
              {previous.entry.data.title}
            </a>
          )}
          {next && (
            <a href={next.path} rel="next">
              <span class="guide-entry__label">{copy.next}</span>
              {next.entry.data.title}
            </a>
          )}
        </div>
        {sameTopic.length > 0 && (
          <div class="guide-entry__shelf">
            <h2 class="guide-entry__label">
              {copy.sameTopic} {topic}
            </h2>
            <ul>
              {sameTopic.map((other) => (
                <li>
                  <a href={other.path}>{other.entry.data.title}</a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </nav>

      <article class="guide-entry__article" aria-labelledby="guide-entry-title">
        <div class="guide-entry__prose prose prose-lg max-w-none">
          <Content />
        </div>
        <nav class="guide-entry__turn" aria-label={shelf.name}>
          {previous ? (
            <a href={previous.path} rel="prev">
              <span class="guide-entry__label">← {copy.previous}</span>
              {previous.entry.data.title}
            </a>
          ) : (
            <span />
          )}
          {next && (
            <a href={next.path} rel="next">
              <span class="guide-entry__label">{copy.next} →</span>
              {next.entry.data.title}
            </a>
          )}
          <a class="guide-entry__turn-shelf" href={shelfPath}>
            {copy.backTo} <b>{shelf.name}</b>
          </a>
        </nav>
      </article>
    </div>
  </Container>
</BaseLayout>

<style>
  :global(.guide-entry-shell) {
    padding-bottom: 4rem;
  }

  /* Same grid as a post: the guide on the left, the entry on the reading measure. */
  .guide-entry {
    display: grid;
    grid-template-columns: minmax(0, var(--measure));
    padding-top: round(nearest, clamp(1.75rem, 4vw, 3.5rem), 4px);
  }

  .guide-entry__heading {
    min-width: 0;
    padding-bottom: 2rem;
  }

  .guide-entry__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2rem;
    margin-bottom: 0.75rem;
    color: rgb(var(--color-accent));
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .guide-entry__mark {
    width: 0.5rem;
    height: 0.5rem;
    background: rgb(var(--color-primary));
    transform: rotate(45deg);
  }

  .guide-entry__title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(2.125rem, 1.4rem + 2.2vw, 3.5rem);
    font-weight: 700;
    line-height: var(--leading-display);
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  /* The subtitle is the definition, so it reads like one. */
  .guide-entry__description {
    margin: 1.25rem 0 0;
    color: rgb(var(--color-text) / 0.85);
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 1.1rem + 0.4vw, 1.5rem);
    font-style: italic;
    line-height: var(--leading-normal);
    text-wrap: pretty;
  }

  /* Where it comes from, when it changed, the other language: one quiet line. */
  .guide-entry__byline {
    margin: 1.25rem 0 0;
    color: rgb(var(--color-text-muted));
    font-family: var(--font-sans);
    font-size: 0.875rem;
    line-height: var(--leading-normal);
  }

  .guide-entry__byline > * + *::before {
    content: '·';
    padding: 0 0.5rem;
    color: rgb(var(--color-accent));
  }

  .guide-entry__byline :global(time) {
    color: inherit;
  }

  .guide-entry__byline a {
    color: rgb(var(--color-accent));
    font-weight: 600;
    text-decoration: none;
  }

  .guide-entry__byline a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .guide-entry__article {
    min-width: 0;
  }

  .guide-entry__prose {
    font-size: clamp(1.125rem, 1.025rem + 0.35vw, 1.25rem);
    line-height: var(--leading-relaxed);
  }

  /* Section names are small gold labels, so the writing leads. */
  .guide-entry__prose :global(h2) {
    margin: 2.5rem 0 0.75rem;
    color: rgb(var(--color-accent));
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: var(--leading-tight);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .guide-entry__prose :global(h2:first-child) {
    margin-top: 0;
  }

  .guide-entry__prose :global(h2 + p) {
    margin-top: 0;
  }

  /* Go next: one link per line, led by a gold arrow instead of a bullet. */
  .guide-entry__prose :global(h2:last-of-type + ul) {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .guide-entry__prose :global(h2:last-of-type + ul li) {
    margin: 0;
    padding: 0;
  }

  .guide-entry__prose :global(h2:last-of-type + ul li::marker) {
    content: none;
  }

  .guide-entry__prose :global(h2:last-of-type + ul li::before) {
    content: '→';
    margin-right: 0.5rem;
    color: rgb(var(--color-accent));
  }

  .guide-entry__prose :global(h2:last-of-type + ul a) {
    color: rgb(var(--color-accent));
    font-family: var(--font-heading);
    font-size: 1.25rem;
    text-decoration: none;
  }

  .guide-entry__prose :global(h2:last-of-type + ul a:hover) {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* The page turn: previous on the left, next on the right, the shelf under them.
     Wide screens have the sidebar for this instead. */
  .guide-entry__turn {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 3.5rem;
  }

  .guide-entry__turn a {
    display: grid;
    align-content: start;
    gap: 0.25rem;
    color: rgb(var(--color-text));
    font-family: var(--font-heading);
    font-size: 1.125rem;
    line-height: var(--leading-tight);
    text-decoration: none;
  }

  .guide-entry__turn a[rel='next'] {
    grid-column: 2;
    text-align: right;
  }

  .guide-entry__turn .guide-entry__label {
    color: rgb(var(--color-accent));
    font-size: 0.75rem;
    font-weight: 700;
  }

  .guide-entry__turn a:hover {
    color: rgb(var(--color-accent));
  }

  .guide-entry__turn a.guide-entry__turn-shelf {
    display: block;
    grid-column: 1 / -1;
    justify-self: center;
    margin-top: 1.25rem;
    color: rgb(var(--color-text-muted));
    font-size: 1.0625rem;
    font-style: italic;
    text-align: center;
  }

  .guide-entry__turn-shelf b {
    color: rgb(var(--color-accent));
    font-style: normal;
    font-weight: 600;
  }

  .guide-entry__turn a:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 3px;
  }

  .guide-entry__sidebar {
    grid-row: 3;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid rgb(var(--color-border));
    font-family: var(--font-sans);
    font-size: 0.9375rem;
  }

  .guide-entry__guide-link {
    display: block;
    margin-bottom: 0.25rem;
    color: rgb(var(--color-text));
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    text-decoration: none;
  }

  .guide-entry__guide-link:hover {
    color: rgb(var(--color-accent));
  }

  .guide-entry__shelf-link {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    min-height: 2.5rem;
    color: rgb(var(--color-accent));
    font-weight: 600;
    text-decoration: none;
  }

  .guide-entry__steps {
    display: grid;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .guide-entry__steps a {
    display: grid;
    gap: 0.25rem;
    color: rgb(var(--color-text));
    font-family: var(--font-heading);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: var(--leading-tight);
    text-decoration: none;
  }

  .guide-entry__steps a:hover {
    color: rgb(var(--color-accent));
  }

  .guide-entry__steps .guide-entry__label {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .guide-entry__shelf {
    margin-top: 1.5rem;
  }

  .guide-entry__label {
    margin: 0 0 0.25rem;
    color: rgb(var(--color-text-muted));
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .guide-entry__sidebar ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .guide-entry__sidebar li a {
    display: flex;
    align-items: center;
    min-height: 2.5rem;
    color: rgb(var(--color-text-muted));
    text-decoration: none;
  }

  .guide-entry__sidebar li a:hover,
  .guide-entry__sidebar li a[aria-current='page'] {
    color: rgb(var(--color-accent));
  }

  .guide-entry__sidebar li a[aria-current='page'] {
    font-weight: 600;
  }

  /* Below the sidebar breakpoint the page turn does the moving; keep only a belief's topic list. */
  @media (max-width: 1199px) {
    .guide-entry__sidebar {
      display: none;
    }

    .guide-entry__sidebar--topic {
      display: block;
    }

    .guide-entry__sidebar--topic > :not(.guide-entry__shelf) {
      display: none;
    }

    .guide-entry__shelf {
      margin-top: 0;
    }
  }

  @media (min-width: 1200px) {
    .guide-entry__turn {
      display: none;
    }

    .guide-entry {
      grid-template-columns: 14rem minmax(0, var(--measure));
      column-gap: round(nearest, clamp(3rem, 5vw, 4.5rem), 4px);
    }

    .guide-entry__heading {
      grid-column: 2;
      grid-row: 1;
    }

    .guide-entry__article {
      grid-column: 2;
      grid-row: 2;
    }

    .guide-entry__sidebar {
      grid-column: 1;
      grid-row: 1 / 3;
      position: sticky;
      top: calc(var(--site-header-height) + 1.5rem);
      align-self: start;
      margin-top: 0;
      padding-top: 0.25rem;
      border-top: 0;
    }
  }
</style>
