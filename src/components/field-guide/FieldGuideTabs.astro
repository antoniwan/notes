---
import {
  FIELD_GUIDE_COPY,
  FIELD_GUIDE_SHELVES,
  fieldGuideKinds,
  fieldGuideShelfPath,
  type FieldGuideKind,
  type FieldGuideLang,
} from '../../data/fieldGuide';

interface Props {
  lang: FieldGuideLang;
  current?: FieldGuideKind;
}

const { lang, current } = Astro.props;
---

<nav class="guide-tabs" aria-label={FIELD_GUIDE_COPY[lang].shelves}>
  {fieldGuideKinds.map((kind) => (
    <a href={fieldGuideShelfPath(kind, lang)} aria-current={kind === current ? 'page' : undefined}>
      {FIELD_GUIDE_SHELVES[kind][lang].name}
    </a>
  ))}
</nav>

<style>
  /* Book tabs: the shelf names in serif, with a gold line under the one you're on. */
  .guide-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.75rem;
  }

  .guide-tabs a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: rgb(var(--color-text-muted));
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 500;
    text-decoration: none;
    box-shadow: inset 0 -2px 0 transparent;
  }

  .guide-tabs a:hover {
    color: rgb(var(--color-text));
  }

  .guide-tabs a[aria-current='page'] {
    color: rgb(var(--color-text));
    font-weight: 600;
    box-shadow: inset 0 -2px 0 rgb(var(--color-accent));
  }

  .guide-tabs a:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 2px;
  }
</style>
