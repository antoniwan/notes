---
import type { CollectionEntry } from 'astro:content';
import PostCard from './PostCard.astro';
import { categories } from '../data/categories';
import { buildHighlightsLayout } from '../utils/highlightsLayout';

interface Props {
  posts: CollectionEntry<'blog'>[];
  postsByCategory?: Record<string, CollectionEntry<'blog'>[]>;
}

const { posts, postsByCategory = {} } = Astro.props;
const hasIntro = Astro.slots.has('intro');
const leadCount = hasIntro ? 2 : 0;
const categorySet = new Set<string>(Object.keys(postsByCategory));
for (const post of posts) {
  (post.data.category || []).forEach((id: string) => categorySet.add(id));
}
const availableCategories = categories.filter((cat) => categorySet.has(cat.id));
const PRIMARY_CATEGORY_LIMIT = 5;
const views = [
  { id: 'all', posts },
  ...Object.entries(postsByCategory).map(([id, categoryPosts]) => ({ id, posts: categoryPosts })),
].map((view) => ({
  ...view,
  leads: view.posts.slice(0, leadCount),
  slots: buildHighlightsLayout(view.posts.slice(leadCount)),
}));
const viewCounts = Object.fromEntries(views.map((view) => [view.id, view.posts.length]));
---

<section class="highlights-section" aria-labelledby="highlights-heading" data-highlights-container>
  {
    hasIntro && (
      <div class="highlights-opening">
        <div class="highlights-intro">
          <slot name="intro" />
        </div>
        {views.map((view) => (
          <div
            class="highlights-view highlights-leads"
            id={`highlights-${view.id}-start`}
            tabindex="-1"
            data-view={view.id}
            aria-hidden={view.id !== 'all' ? 'true' : 'false'}
            hidden={view.id !== 'all'}
          >
            {view.leads.map((post, index) => (
              <div class:list={['highlights-lead', { 'highlights-lead--second': index === 1 }]}>
                <PostCard
                  post={post}
                  showFeaturedIndicator={false}
                  idPrefix={`highlights-${view.id}`}
                  imageLoading={view.id === 'all' ? 'eager' : 'lazy'}
                />
              </div>
            ))}
          </div>
        ))}
      </div>
    )
  }

  <header class="highlights-header">
    <div class="highlights-heading">
      <h2 id="highlights-heading" class="highlights-title">Highlights</h2>
      <p class="highlights-subtitle">
        Hand-picked writings from recent seasons: a curated starting point, not a full index.
      </p>
    </div>

    {
      availableCategories.length > 0 && (
        <div class="highlights-filters" aria-label="Filter highlights by category" role="group">
          <button
            type="button"
            class="filter-chip is-active"
            data-filter="all"
            aria-label="Show all highlights"
            aria-pressed="true"
          >
            All
          </button>
          {availableCategories.map((category, index) => (
            <button
              type="button"
              class="filter-chip"
              class:list={{ 'is-extra': index >= PRIMARY_CATEGORY_LIMIT }}
              data-filter={category.id}
              data-category-name={category.name}
              aria-label={`Show posts in ${category.name}`}
              aria-pressed="false"
            >
              {category.icon && <span aria-hidden="true">{category.icon}</span>}
              <span>{category.name}</span>
            </button>
          ))}
          {availableCategories.length > PRIMARY_CATEGORY_LIMIT && (
            <button
              type="button"
              class="filter-chip filter-chip--more"
              data-toggle-more
              aria-label="Show more categories"
              aria-expanded="false"
            >
              More <span aria-hidden="true">+</span>
            </button>
          )}
        </div>
      )
    }
  </header>

  <div class="highlights-feedback">
    <p
      class="highlights-status"
      data-highlights-status
      role="status"
      aria-live="polite"
      aria-atomic="true"
    >
      Showing {posts.length} highlights (All categories)
    </p>
    {
      hasIntro && (
        <a class="highlights-jump" data-highlights-jump href="#highlights-all-start" hidden>
          View these highlights <span aria-hidden="true">↑</span>
        </a>
      )
    }
  </div>

  {
    views.map((view) => (
      <div
        class="highlights-masonry highlights-view"
        data-view={view.id}
        aria-hidden={view.id !== 'all' ? 'true' : 'false'}
        hidden={view.id !== 'all'}
      >
        {view.slots.map((slot) => (
          <div
            class="masonry-item"
            class:list={[`span-${slot.span}`]}
            style={`grid-row: ${slot.rowIndex + 1}; grid-column: ${slot.colStart} / span ${slot.span};`}
          >
            <PostCard
              post={slot.post}
              showFeaturedIndicator={false}
              idPrefix={`highlights-${view.id}`}
            />
          </div>
        ))}
      </div>
    ))
  }
</section>

<script is:inline define:vars={{ viewCounts }}>
  const container = document.querySelector('[data-highlights-container]');
  const filterButtons = Array.from(container?.querySelectorAll('.filter-chip[data-filter]') || []);
  const moreToggle = container?.querySelector('[data-toggle-more]');
  const statusEl = container?.querySelector('[data-highlights-status]');
  const jumpLink = container?.querySelector('[data-highlights-jump]');

  function applyFilter(filter) {
    filterButtons.forEach((btn) => {
      const isActive = btn.dataset.filter === filter;
      btn.classList.toggle('is-active', isActive);
      btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
    });

    const categoryName =
      filter === 'all'
        ? 'All categories'
        : filterButtons.find((button) => button.dataset.filter === filter)?.dataset.categoryName ||
          filter;
    const count = viewCounts[filter] ?? 0;
    if (statusEl) {
      statusEl.textContent =
        count === 0
          ? `No highlights in ${categoryName}`
          : `Showing ${count} highlight${count === 1 ? '' : 's'} (${categoryName})`;
    }

    if (jumpLink) {
      jumpLink.hidden = count === 0;
      jumpLink.setAttribute('href', '#highlights-' + filter + '-start');
    }

    container?.querySelectorAll('.highlights-view').forEach((view) => {
      const inactive = view.getAttribute('data-view') !== filter;
      view.setAttribute('aria-hidden', inactive ? 'true' : 'false');
      view.hidden = inactive;
    });
  }

  filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => applyFilter(btn.dataset.filter || 'all'));
  });

  if (moreToggle) {
    const filtersContainer = container.querySelector('.highlights-filters');
    moreToggle.addEventListener('click', () => {
      const expanded = filtersContainer.classList.toggle('filters-expanded');
      moreToggle.setAttribute('aria-expanded', expanded ? 'true' : 'false');
      moreToggle.setAttribute(
        'aria-label',
        expanded ? 'Show fewer categories' : 'Show more categories',
      );
      moreToggle.textContent = expanded ? 'Less −' : 'More +';
    });
  }
</script>

<style>
  .highlights-section {
    margin: 2rem 0 3rem;
  }

  .highlights-opening {
    display: grid;
    gap: 2.25rem;
    margin-bottom: 3rem;
  }

  .highlights-intro,
  .highlights-lead {
    min-width: 0;
  }

  .highlights-leads {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
    align-items: start;
  }

  .highlights-view[hidden] {
    display: none !important;
  }

  .highlights-header {
    display: grid;
    align-items: start;
    gap: 1.25rem 2.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid rgb(var(--color-border));
  }

  .highlights-title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 2.6vw, 2.25rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .highlights-subtitle {
    max-width: 45ch;
    margin: 0.65rem 0 0;
    font-size: 0.9rem;
    line-height: 1.6;
    color: rgb(var(--color-text-muted));
  }

  .highlights-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }

  .filter-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    padding: 0.55rem 0.85rem;
    border-radius: var(--radius-md);
    border: 1px solid rgb(var(--color-border));
    background: transparent;
    color: rgb(var(--color-text-muted));
    font-family: var(--font-sans);
    font-size: 0.875rem;
    line-height: 1.5;
    cursor: pointer;
    transition:
      background-color 160ms ease,
      color 160ms ease,
      border-color 160ms ease;
  }

  .filter-chip:hover {
    border-color: rgb(var(--color-accent) / 0.4);
    background: rgb(var(--color-bg-alt));
    color: rgb(var(--color-text));
  }

  .filter-chip.is-active {
    background: rgb(var(--color-primary));
    border-color: rgb(var(--color-primary));
    color: rgb(var(--color-on-primary));
    font-weight: 600;
  }

  .filter-chip:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 3px;
  }

  .filter-chip--more {
    border-style: dashed;
  }

  .filter-chip.is-extra {
    display: none;
  }

  .highlights-filters.filters-expanded .filter-chip.is-extra {
    display: inline-flex;
  }

  .highlights-feedback {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin: 1.25rem 0 1rem;
  }

  .highlights-jump {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: rgb(var(--color-accent));
    font-size: 0.875rem;
    line-height: 1.5;
    font-weight: 600;
    text-underline-offset: 0.2em;
  }

  .highlights-jump[hidden] {
    display: none;
  }
  .highlights-jump:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 4px;
  }
  .highlights-leads {
    scroll-margin-top: 6rem;
  }

  .highlights-status {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: rgb(var(--color-text-muted));
  }

  .highlights-masonry {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem 1.5rem;
    align-items: stretch;
  }

  .masonry-item {
    min-width: 0;
  }

  .highlights-lead :global(article.postcard .image-container) {
    aspect-ratio: 4 / 3;
  }

  @media (min-width: 600px) {
    .highlights-leads {
      grid-template-columns: 1.15fr 1fr;
      gap: 1.5rem;
    }

    .highlights-lead--second {
      padding-top: 3rem;
    }
  }

  @media (min-width: 768px) {
    .highlights-section {
      margin-top: 3rem;
    }

    .highlights-header {
      grid-template-columns: minmax(15rem, 0.85fr) minmax(0, 1.65fr);
      align-items: center;
      padding-top: 2rem;
    }

    .highlights-filters {
      justify-content: flex-end;
    }

    .highlights-masonry {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 2.5rem 1.75rem;
    }

    .highlights-masonry .masonry-item :global(article.postcard) {
      display: flex;
      flex-direction: column;
      height: 100%;
    }

    .highlights-masonry :global(article.postcard .image-container) {
      aspect-ratio: auto;
      flex: 0 0 auto;
      height: 15rem;
    }
  }

  @media (min-width: 1024px) {
    .highlights-opening {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: center;
      gap: 2.5rem;
      margin-bottom: 3.5rem;
    }

    .highlights-leads {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      gap: 1.75rem;
    }

    .highlights-lead :global(article.postcard .image-container) {
      aspect-ratio: 4 / 5;
    }

    .highlights-lead--second {
      padding-top: 5rem;
    }

    .highlights-lead--second :global(article.postcard .image-container) {
      aspect-ratio: 1 / 1;
    }

    .highlights-lead :global(article.postcard .postcard-title) {
      font-size: clamp(1.4rem, 2vw, 1.85rem);
    }

    .highlights-lead :global(article.postcard .postcard-description) {
      display: block;
      overflow: visible;
    }
  }

  @media (max-width: 767px) {
    .masonry-item {
      grid-column: 1 !important;
      grid-row: auto !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .filter-chip {
      transition: none;
    }
  }
</style>
