---
import type { TocItem } from '../../types/layout';

interface Props {
  tableOfContents?: TocItem[];
  language?: 'en' | 'es';
}

const { tableOfContents = [], language = 'en' } = Astro.props;
const hasToc = tableOfContents.length >= 2;
const labels =
  language === 'es'
    ? { trigger: 'Contenido', title: 'En esta página', close: 'Cerrar contenido' }
    : { trigger: 'Contents', title: 'On this page', close: 'Close contents' };
---

{
  hasToc && (
    <div class="post-toc-container" data-post-toc data-open="false">
      <button
        type="button"
        class="post-toc-trigger"
        aria-expanded="false"
        aria-controls="post-toc-modal"
        data-post-toc-trigger
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M8 6h12M8 12h12M8 18h12M3 6h.01M3 12h.01M3 18h.01"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
          />
        </svg>
        {labels.trigger}
      </button>

      <div
        id="post-toc-modal"
        class="post-toc-modal"
        aria-labelledby="post-toc-title"
        data-post-toc-modal
      >
        <div class="post-toc-header">
          <h2 id="post-toc-title" class="post-toc-title">
            {labels.title}
          </h2>
          <button
            type="button"
            class="post-toc-close"
            aria-label={labels.close}
            data-post-toc-close
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="m6 6 12 12M18 6 6 18"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
              />
            </svg>
          </button>
        </div>

        <nav aria-labelledby="post-toc-title" class="post-toc-nav scrollbar-subtle-y">
          <ol class="post-toc-list">
            {tableOfContents.map((item) => (
              <li
                class="post-toc-item"
                data-level={item.level}
                style={`--toc-indent: ${Math.max(0, item.level - 2)};`}
              >
                <a href={`#${item.slug}`} data-post-toc-link={item.slug}>
                  {item.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      </div>
    </div>
  )
}

<style>
  .post-toc-trigger {
    position: fixed;
    left: max(1rem, env(safe-area-inset-left));
    bottom: calc(1rem + env(safe-area-inset-bottom));
    z-index: 40;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: 48px;
    border: 1px solid rgb(var(--color-accent) / 0.3);
    border-radius: 999px;
    padding: 0.65rem 1rem;
    background: rgb(var(--color-bg));
    color: rgb(var(--color-text));
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.4;
    box-shadow: 0 4px 24px rgb(0 0 0 / 0.14);
    cursor: pointer;
    transition:
      background-color 150ms ease,
      border-color 150ms ease;
  }

  .post-toc-trigger svg {
    color: rgb(var(--color-accent));
    flex-shrink: 0;
  }

  .post-toc-trigger:hover,
  .post-toc-trigger[aria-expanded='true'] {
    border-color: rgb(var(--color-accent) / 0.6);
    background: color-mix(in srgb, rgb(var(--color-bg)) 93%, rgb(var(--color-accent)) 7%);
  }

  .post-toc-modal {
    position: fixed;
    left: max(1rem, env(safe-area-inset-left));
    bottom: calc(5.25rem + env(safe-area-inset-bottom));
    z-index: 45;
    display: none;
    flex-direction: column;
    width: min(23rem, calc(100vw - 2rem - env(safe-area-inset-left) - env(safe-area-inset-right)));
    max-height: calc(100dvh - var(--site-header-height) - 7rem - env(safe-area-inset-bottom));
    border: 1px solid rgb(var(--color-accent) / 0.25);
    border-radius: 1rem;
    background: rgb(var(--color-bg));
    box-shadow: 0 12px 44px rgb(0 0 0 / 0.2);
    font-family: var(--font-sans);
  }

  .post-toc-container[data-open='true'] .post-toc-modal {
    display: flex;
  }

  .post-toc-header {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.5rem 0.5rem 0.5rem 1rem;
  }

  .post-toc-title {
    margin: 0;
    font-family: var(--font-sans);
    color: rgb(var(--color-text-muted));
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .post-toc-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 0.5rem;
    background: transparent;
    color: rgb(var(--color-text-muted));
    cursor: pointer;
  }

  .post-toc-close:hover {
    background: rgb(var(--color-bg-alt));
    color: rgb(var(--color-text));
  }

  .post-toc-nav {
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0.5rem;
    border-radius: 0 0 1rem 1rem;
    scroll-behavior: auto;
  }

  .post-toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post-toc-item {
    margin: 0;
  }

  .post-toc-item a {
    display: flex;
    align-items: center;
    min-height: 44px;
    margin-left: calc(var(--toc-indent) * 0.65rem);
    padding: 0.65rem 0.75rem;
    border-left: 2px solid transparent;
    border-radius: 0 0.5rem 0.5rem 0;
    color: rgb(var(--color-text-muted));
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 450;
    line-height: 1.45;
    overflow-wrap: anywhere;
    transition:
      background-color 150ms ease,
      color 150ms ease;
  }

  .post-toc-item a:hover {
    background: rgb(var(--color-bg-alt));
    color: rgb(var(--color-text));
  }

  .post-toc-item a[data-active='true'] {
    border-left-color: rgb(var(--color-accent));
    background: rgb(var(--color-accent) / 0.08);
    color: rgb(var(--color-accent));
    font-weight: 600;
  }

  .post-toc-trigger:focus-visible,
  .post-toc-close:focus-visible,
  .post-toc-item a:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 2px;
  }

  @media (min-width: 1200px) {
    .post-toc-trigger,
    .post-toc-close {
      display: none;
    }

    .post-toc-modal {
      position: static;
      display: flex;
      width: 100%;
      max-height: none;
      border: 0;
      border-radius: 0;
      background: transparent;
      box-shadow: none;
    }

    .post-toc-header {
      padding: 0 0 0.75rem;
      border-bottom: 0;
    }

    .post-toc-nav {
      max-height: none;
      overflow: visible;
      padding: 0.2rem 0.35rem 0.2rem 0.2rem;
      border-radius: 0;
    }

    .post-toc-item a {
      min-height: 38px;
      padding: 0.55rem 0.6rem;
      font-size: 0.8125rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-toc-trigger,
    .post-toc-item a {
      transition: none;
    }
  }
</style>
