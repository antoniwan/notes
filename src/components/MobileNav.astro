---
import Logo from './Logo.astro';
import {
  readingLinks,
  collectionLinks,
  contactLinks,
  siteToolLinks,
} from '../data/readerNavigation';
import { getSortedCategories } from '../utils/categoryUtils';
import { isNavDropdownItemActive } from '../utils/navActive';

const sortedCategories = await getSortedCategories();
const pathname = Astro.url.pathname;
const entryDescriptions: Record<string, string> = {
  '/everything': 'The full archive, with images.',
  '/guided-path': 'A place to start reading.',
};
const entryLinks = readingLinks.filter((link) => link.href in entryDescriptions);
const browseLinks = readingLinks.filter((link) => !(link.href in entryDescriptions));
const collectionDescriptions: Record<string, string> = {
  '/books': 'Stories I wrote',
  '/recipes': 'Recipes from my kitchen',
  '/library/books': 'Books on my shelf',
};
const primaryContactLinks = contactLinks.filter(
  (link) => link.href === '/about' || link.href.startsWith('mailto:'),
);
const secondaryContactLinks = contactLinks.filter((link) => !primaryContactLinks.includes(link));
function currentLocation(href: string) {
  if (pathname === href) return 'page';
  if (
    (href === '/category' && pathname.startsWith('/category/')) ||
    isNavDropdownItemActive(href, pathname)
  )
    return 'location';
  return undefined;
}
---

<button
  id="mobile-menu-button"
  type="button"
  class="mobile-menu-trigger"
  aria-label="Open menu"
  aria-expanded="false"
  aria-controls="mobile-menu"
  aria-haspopup="dialog"
>
  <svg
    width="21"
    height="21"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.7"
    aria-hidden="true"
  >
    <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"></path>
  </svg>
</button>

<dialog id="mobile-menu" class="mobile-menu" aria-labelledby="mobile-menu-title">
  <div class="mobile-menu__header">
    <span id="mobile-menu-title" class="sr-only">Menu</span>
    <Logo class="mobile-menu__brand" />
    <button id="close-mobile-menu" class="mobile-menu__close" type="button" aria-label="Close menu">
      <svg
        width="21"
        height="21"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        aria-hidden="true"
      >
        <path d="m6 6 12 12M6 18 18 6" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>
  <div class="mobile-menu__content">
    <button id="mobile-search-nav-action" class="mobile-menu__search" type="button">
      <svg
        width="19"
        height="19"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        aria-hidden="true"
      >
        <circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m16 16 4.5 4.5" stroke-linecap="round"
        ></path>
      </svg>
      Search the notes
    </button>
    <nav class="mobile-menu__navigation" aria-label="Mobile navigation">
      <section class="mobile-menu__section" aria-labelledby="mobile-menu-read">
        <h2 id="mobile-menu-read" class="mobile-menu__label">Read</h2>
        <ul class="mobile-menu__links mobile-menu__entries">
          {
            entryLinks.map((link) => (
              <li>
                <a
                  class="mobile-menu__entry"
                  href={link.href}
                  aria-current={currentLocation(link.href)}
                >
                  <span class="mobile-menu__entry-title">{link.label}</span>
                  <span class="mobile-menu__description">{entryDescriptions[link.href]}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <ul class="mobile-menu__links mobile-menu__links--paired mobile-menu__browse">
          {
            browseLinks.map((link) => (
              <li>
                <a
                  class="mobile-menu__primary"
                  href={link.href}
                  aria-current={currentLocation(link.href)}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
        <details
          class="mobile-menu__group mobile-menu__group--secondary"
          data-active={pathname.startsWith('/category/') ? 'true' : undefined}
        >
          <summary class="mobile-menu__primary">
            Choose a category
            <svg
              class="mobile-menu__chevron"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              aria-hidden="true"
            >
              <path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </summary>
          <div class="mobile-menu__children">
            {
              sortedCategories.map((category) => {
                const href = '/category/' + category.id;
                return (
                  <a href={href} aria-current={currentLocation(href)}>
                    <span>{category.name}</span>
                    <span class="mobile-menu__count" aria-label={category.postCount + ' writings'}>
                      {category.postCount}
                    </span>
                  </a>
                );
              })
            }
          </div>
        </details>
      </section>

      <section
        class="mobile-menu__section mobile-menu__collections"
        aria-labelledby="mobile-menu-collections"
      >
        <h2 id="mobile-menu-collections" class="mobile-menu__label">Collections</h2>
        <ul class="mobile-menu__links">
          {
            collectionLinks.map((link) => (
              <li>
                <a
                  class="mobile-menu__collection"
                  href={link.href}
                  aria-current={currentLocation(link.href)}
                >
                  <span class="mobile-menu__collection-title">{link.label}</span>
                  <span class="mobile-menu__description">{collectionDescriptions[link.href]}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="mobile-menu__section" aria-labelledby="mobile-menu-contact">
        <h2 id="mobile-menu-contact" class="mobile-menu__label">About &amp; contact</h2>
        <ul class="mobile-menu__links mobile-menu__links--paired">
          {
            primaryContactLinks.map((link) => (
              <li>
                <a
                  class="mobile-menu__primary"
                  href={link.href}
                  aria-current={currentLocation(link.href)}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
        <ul class="mobile-menu__links mobile-menu__links--paired mobile-menu__secondary-links">
          {
            secondaryContactLinks.map((link) => (
              <li>
                <a
                  class="mobile-menu__primary"
                  href={link.href}
                  aria-current={currentLocation(link.href)}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <details
        class="mobile-menu__group mobile-menu__group--secondary mobile-menu__tools"
        data-active={siteToolLinks.some((link) => isNavDropdownItemActive(link.href, pathname))
          ? 'true'
          : undefined}
      >
        <summary class="mobile-menu__primary">
          Site tools
          <svg
            class="mobile-menu__chevron"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            aria-hidden="true"
          >
            <path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </summary>
        <div class="mobile-menu__children">
          {
            siteToolLinks.map((link) => (
              <a href={link.href} aria-current={currentLocation(link.href)}>
                {link.label}
              </a>
            ))
          }
        </div>
      </details>
    </nav>
  </div>
</dialog>

<script>
  const trigger = document.querySelector<HTMLButtonElement>('#mobile-menu-button');
  const menu = document.querySelector<HTMLDialogElement>('#mobile-menu');
  const closeButton = document.querySelector<HTMLButtonElement>('#close-mobile-menu');

  if (trigger && menu && closeButton) {
    const desktop = window.matchMedia('(min-width: 1280px)');
    let previousOverflow = '';
    let waitingForBack = false;
    let afterBack: (() => void) | undefined;

    function openMenu(addHistory = true) {
      if (!menu || !trigger || menu.open || desktop.matches || waitingForBack) return;
      previousOverflow = document.body.style.overflow;
      document.body.style.overflow = 'hidden';
      menu.showModal();
      trigger.setAttribute('aria-expanded', 'true');
      menu.dataset.dismissReason = 'open';
      document.dispatchEvent(new CustomEvent('mobile-nav:opened'));
      if (addHistory) {
        history.pushState({ ...history.state, notesMobileMenu: true }, '', window.location.href);
      }
      closeButton?.focus();
    }

    function closeMenu(
      reason: string,
      restoreFocus = true,
      syncHistory = true,
      action?: () => void,
    ) {
      if (!menu || !trigger || !menu.open) return;
      menu.close();
      document.body.style.overflow = previousOverflow;
      trigger.setAttribute('aria-expanded', 'false');
      menu.dataset.dismissReason = reason;
      if (restoreFocus && !desktop.matches) trigger.focus();
      if (syncHistory && history.state?.notesMobileMenu) {
        waitingForBack = true;
        afterBack = action;
        history.back();
      } else {
        action?.();
      }
    }

    trigger.addEventListener('click', () => openMenu());
    closeButton.addEventListener('click', () => closeMenu('close-button'));
    menu.addEventListener('cancel', (event) => {
      event.preventDefault();
      closeMenu('escape-key');
    });
    menu.addEventListener('click', (event) => {
      if (event.target !== menu) return;
      const bounds = menu.getBoundingClientRect();
      if (
        event.clientX < bounds.left ||
        event.clientX > bounds.right ||
        event.clientY < bounds.top ||
        event.clientY > bounds.bottom
      ) {
        closeMenu('overlay-tap');
      }
    });
    window.addEventListener('popstate', (event) => {
      if (waitingForBack) {
        waitingForBack = false;
        const action = afterBack;
        afterBack = undefined;
        action?.();
        return;
      }
      if (event.state?.notesMobileMenu) openMenu(false);
      else closeMenu('back-action', true, false);
    });
    desktop.addEventListener('change', () => {
      if (desktop.matches) closeMenu('desktop-layout', false);
    });

    // Native dialog contains focus; native details omit collapsed links from the Tab sequence.
    menu.querySelectorAll<HTMLDetailsElement>('details').forEach((group) => {
      group.addEventListener('toggle', () => {
        if (group.open) {
          menu.querySelectorAll<HTMLDetailsElement>('details').forEach((other) => {
            if (other !== group) other.open = false;
          });
        }
      });
    });

    menu.querySelectorAll<HTMLAnchorElement>('a[href]').forEach((link) => {
      link.addEventListener('click', (event) => {
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey)
          return;
        if (link.target === '_blank' || link.protocol === 'mailto:') {
          closeMenu('link-selection');
          return;
        }
        event.preventDefault();
        closeMenu('link-selection', false, true, () => window.location.assign(link.href));
      });
    });
    document.querySelector('#mobile-search-nav-action')?.addEventListener('click', () => {
      closeMenu('search', false, true, () => {
        document.dispatchEvent(new CustomEvent('mobile-nav:open-search'));
      });
    });
  }
</script>

<style>
  .mobile-menu-trigger,
  .mobile-menu__close {
    display: inline-flex;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 0.625rem;
    color: rgb(var(--color-text));
    cursor: pointer;
  }
  .mobile-menu-trigger:hover,
  .mobile-menu__close:hover {
    color: rgb(var(--color-accent));
    background: rgb(var(--color-accent) / 0.07);
  }
  .mobile-menu {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: 28rem;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0 0 0 auto;
    padding: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    scroll-padding-block: calc(var(--site-header-height) + 1rem) 1.5rem;
    border: 0;
    color: rgb(var(--color-text));
    background: rgb(var(--color-bg));
    font-family: var(--font-sans);
  }
  .mobile-menu::backdrop {
    background: rgb(0 0 0 / 0.32);
    backdrop-filter: blur(3px);
  }
  .mobile-menu__header {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    background: rgb(var(--color-bg));
    min-height: var(--site-header-height);
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 1rem;
  }
  .mobile-menu__header :global(.mobile-menu__brand) {
    min-height: 44px;
  }
  .mobile-menu__content {
    display: flex;
    min-height: calc(100dvh - var(--site-header-height));
    flex-direction: column;
    padding: 0.5rem 1rem max(1.5rem, env(safe-area-inset-bottom));
  }
  .mobile-menu__search {
    display: flex;
    width: 100%;
    min-height: 48px;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-lg);
    color: rgb(var(--color-text-muted));
    background: rgb(var(--color-bg-alt));
    font-size: 1rem;
    line-height: 1.5;
    text-align: left;
    cursor: pointer;
  }
  .mobile-menu__search:hover {
    color: rgb(var(--color-accent));
    background: rgb(var(--color-accent) / 0.07);
  }
  .mobile-menu__navigation {
    display: grid;
    gap: 1.5rem;
    padding-top: 1.5rem;
  }
  .mobile-menu__section {
    min-width: 0;
  }
  .mobile-menu__label {
    margin: 0 0 0.5rem;
    padding-inline: 0.75rem;
    color: rgb(var(--color-text-muted));
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.5;
  }
  .mobile-menu__links {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .mobile-menu__links > li {
    margin: 0;
  }
  .mobile-menu__entries {
    display: grid;
    gap: 0.5rem;
  }
  .mobile-menu__entry,
  .mobile-menu__collection {
    display: flex;
    min-height: 44px;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
    padding: 0.75rem;
    border-radius: var(--radius-md);
    color: rgb(var(--color-text));
    text-decoration: none;
  }
  .mobile-menu__entry-title {
    font-family: var(--font-heading);
    font-size: 1.625rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.025em;
  }
  .mobile-menu__description {
    color: rgb(var(--color-text-muted));
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.5;
  }
  .mobile-menu__links--paired {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 0.5rem;
  }
  .mobile-menu__browse {
    margin-top: 0.75rem;
  }
  .mobile-menu__primary {
    display: flex;
    min-height: 44px;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.625rem 0.75rem;
    border-radius: var(--radius-md);
    color: rgb(var(--color-text));
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.5;
    text-decoration: none;
    cursor: pointer;
  }
  .mobile-menu__collections {
    padding: 1rem 0.5rem 0.5rem;
    border-radius: var(--radius-lg);
    background: rgb(var(--color-accent) / 0.06);
  }
  .mobile-menu__collection {
    gap: 0.125rem;
    padding-block: 0.625rem;
  }
  .mobile-menu__collection-title {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.5;
  }
  .mobile-menu__secondary-links .mobile-menu__primary,
  .mobile-menu__group--secondary > summary {
    color: rgb(var(--color-text-muted));
    font-weight: 400;
  }
  .mobile-menu__tools {
    margin-top: -0.5rem;
  }
  summary {
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .mobile-menu__chevron {
    flex-shrink: 0;
    color: rgb(var(--color-text-muted));
    transition: transform 160ms ease;
  }
  .mobile-menu__group[open] .mobile-menu__chevron {
    transform: rotate(180deg);
  }
  .mobile-menu__children {
    display: grid;
    padding: 0.25rem 0.25rem 0.75rem 0.75rem;
  }
  .mobile-menu__children a {
    display: flex;
    min-height: 44px;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.625rem 0.75rem;
    border-radius: var(--radius-md);
    color: rgb(var(--color-text-muted));
    font-size: 1rem;
    line-height: 1.5;
    text-decoration: none;
  }
  .mobile-menu__count {
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }
  .mobile-menu
    :is(
      .mobile-menu__primary,
      .mobile-menu__entry,
      .mobile-menu__collection,
      .mobile-menu__children a
    ):is(:hover, [aria-current]),
  .mobile-menu__group[data-active] > summary {
    color: rgb(var(--color-accent));
    background: rgb(var(--color-accent) / 0.07);
  }
  .mobile-menu__collections .mobile-menu__collection[aria-current] {
    background: rgb(var(--color-bg) / 0.8);
  }
  a:focus-visible,
  button:focus-visible,
  summary:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 2px;
  }
  @media (min-width: 768px) {
    .mobile-menu__header,
    .mobile-menu__content {
      padding-inline: 1.5rem;
    }
  }
  @media (min-width: 1280px) {
    .mobile-menu-trigger {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-menu__chevron {
      transition: none;
    }
    .mobile-menu::backdrop {
      backdrop-filter: none;
    }
  }
</style>
