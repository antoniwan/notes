---
import { SOCIAL_LINKS } from '../consts';
import { mainNavigation } from '../data/navigation';
import { getSortedCategories } from '../utils/categoryUtils';
import { isMainNavItemActive, isNavDropdownItemActive } from '../utils/navActive';
import { generateCanonicalUrl } from '../utils/seo';

const sortedCategories = await getSortedCategories();
const pathname = Astro.url.pathname;
const navigation = [{ href: '/', label: 'Home' }, ...mainNavigation];
const socialLinks = [
  { href: SOCIAL_LINKS.bluesky, label: 'Bluesky' },
  { href: SOCIAL_LINKS.github, label: 'GitHub' },
  { href: 'https://www.youtube.com/@Antoniwan777', label: 'YouTube' },
];
---

<button
  id="mobile-menu-button"
  type="button"
  class="mobile-menu-trigger"
  aria-label="Open menu"
  aria-expanded="false"
  aria-controls="mobile-menu"
  aria-haspopup="dialog"
>
  <svg
    width="21"
    height="21"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.7"
    aria-hidden="true"
  >
    <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"></path>
  </svg>
</button>

<dialog
  id="mobile-menu"
  class="mobile-menu"
  aria-labelledby="mobile-menu-title"
  data-share-url={generateCanonicalUrl(pathname)}
>
  <div class="mobile-menu__header">
    <span id="mobile-menu-title">Menu</span>
    <button id="close-mobile-menu" class="mobile-menu__close" type="button" aria-label="Close menu">
      <svg
        width="21"
        height="21"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        aria-hidden="true"
      >
        <path d="m6 6 12 12M6 18 18 6" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>
  <div class="mobile-menu__content">
    <button id="mobile-search-nav-action" class="mobile-menu__search" type="button">
      <svg
        width="19"
        height="19"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        aria-hidden="true"
      >
        <circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m16 16 4.5 4.5" stroke-linecap="round"
        ></path>
      </svg>
      Search the notes
    </button>
    <nav class="mobile-menu__navigation" aria-label="Mobile navigation">
      {
        navigation.map((item) => {
          const isActive = isMainNavItemActive(item.href, pathname);
          if (!('dropdown' in item) || !item.dropdown) {
            return (
              <a
                class="mobile-menu__primary"
                href={item.href}
                aria-current={isActive ? 'page' : undefined}
              >
                {item.label}
              </a>
            );
          }
          const isCategories = item.href === '/category';
          return (
            <details class="mobile-menu__group" data-active={isActive ? 'true' : undefined}>
              <summary class="mobile-menu__primary">
                {item.label}
                <svg
                  class="mobile-menu__chevron"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  aria-hidden="true"
                >
                  <path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </summary>
              <div class="mobile-menu__children">
                {isCategories && (
                  <a
                    class="mobile-menu__overview"
                    href="/category"
                    aria-current={pathname === '/category' ? 'page' : undefined}
                  >
                    All categories <span aria-hidden="true">↗</span>
                  </a>
                )}
                {isCategories
                  ? sortedCategories.map((category) => {
                      const href = `/category/${category.id}`;
                      return (
                        <a
                          href={href}
                          aria-current={
                            isNavDropdownItemActive(href, pathname) ? 'page' : undefined
                          }
                        >
                          <span>{category.name}</span>
                          <span
                            class="mobile-menu__count"
                            aria-label={`${category.postCount} articles`}
                          >
                            {category.postCount}
                          </span>
                        </a>
                      );
                    })
                  : (item.dropdown.items ?? []).map((child) => (
                      <a
                        href={child.href}
                        aria-current={
                          isNavDropdownItemActive(child.href, pathname) ? 'page' : undefined
                        }
                      >
                        {child.label}
                      </a>
                    ))}
              </div>
            </details>
          );
        })
      }
    </nav>
    <div class="mobile-menu__extras">
      <button id="mobile-share-button" class="mobile-menu__share" type="button">
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          aria-hidden="true"
        >
          <path
            d="M12 15V3m-4 4 4-4 4 4M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        Share this page
      </button>
      <p id="mobile-share-status" class="mobile-menu__status" role="status" aria-live="polite"></p>
      <p class="mobile-menu__label">Elsewhere</p>
      <div class="mobile-menu__social">
        {
          socialLinks.map((link) => (
            <a href={link.href} target="_blank" rel="noopener noreferrer">
              {link.label}
              <span aria-hidden="true">↗</span>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</dialog>

<script>
  const trigger = document.querySelector<HTMLButtonElement>('#mobile-menu-button');
  const menu = document.querySelector<HTMLDialogElement>('#mobile-menu');
  const closeButton = document.querySelector<HTMLButtonElement>('#close-mobile-menu');

  if (trigger && menu && closeButton) {
    const desktop = window.matchMedia('(min-width: 1280px)');
    let previousOverflow = '';
    let waitingForBack = false;
    let afterBack: (() => void) | undefined;

    function openMenu(addHistory = true) {
      if (!menu || !trigger || menu.open || desktop.matches || waitingForBack) return;
      previousOverflow = document.body.style.overflow;
      document.body.style.overflow = 'hidden';
      menu.showModal();
      trigger.setAttribute('aria-expanded', 'true');
      menu.dataset.dismissReason = 'open';
      document.dispatchEvent(new CustomEvent('mobile-nav:opened'));
      if (addHistory) {
        history.pushState({ ...history.state, notesMobileMenu: true }, '', window.location.href);
      }
      closeButton?.focus();
    }

    function closeMenu(
      reason: string,
      restoreFocus = true,
      syncHistory = true,
      action?: () => void,
    ) {
      if (!menu || !trigger || !menu.open) return;
      menu.close();
      document.body.style.overflow = previousOverflow;
      trigger.setAttribute('aria-expanded', 'false');
      menu.dataset.dismissReason = reason;
      if (restoreFocus && !desktop.matches) trigger.focus();
      if (syncHistory && history.state?.notesMobileMenu) {
        waitingForBack = true;
        afterBack = action;
        history.back();
      } else {
        action?.();
      }
    }

    trigger.addEventListener('click', () => openMenu());
    closeButton.addEventListener('click', () => closeMenu('close-button'));
    menu.addEventListener('cancel', (event) => {
      event.preventDefault();
      closeMenu('escape-key');
    });
    menu.addEventListener('click', (event) => {
      if (event.target !== menu) return;
      const bounds = menu.getBoundingClientRect();
      if (
        event.clientX < bounds.left ||
        event.clientX > bounds.right ||
        event.clientY < bounds.top ||
        event.clientY > bounds.bottom
      ) {
        closeMenu('overlay-tap');
      }
    });
    window.addEventListener('popstate', (event) => {
      if (waitingForBack) {
        waitingForBack = false;
        const action = afterBack;
        afterBack = undefined;
        action?.();
        return;
      }
      if (event.state?.notesMobileMenu) openMenu(false);
      else closeMenu('back-action', true, false);
    });
    desktop.addEventListener('change', () => {
      if (desktop.matches) closeMenu('desktop-layout', false);
    });

    // Native dialog contains focus; native details omit collapsed links from the Tab sequence.
    menu.querySelectorAll<HTMLDetailsElement>('details').forEach((group) => {
      group.addEventListener('toggle', () => {
        if (group.open) {
          menu.querySelectorAll<HTMLDetailsElement>('details').forEach((other) => {
            if (other !== group) other.open = false;
          });
        }
      });
    });

    menu.querySelectorAll<HTMLAnchorElement>('a[href]').forEach((link) => {
      link.addEventListener('click', (event) => {
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey)
          return;
        if (link.target === '_blank') {
          closeMenu('link-selection', false);
          return;
        }
        event.preventDefault();
        closeMenu('link-selection', false, true, () => window.location.assign(link.href));
      });
    });
    document.querySelector('#mobile-search-nav-action')?.addEventListener('click', () => {
      closeMenu('search', false, true, () => {
        document.dispatchEvent(new CustomEvent('mobile-nav:open-search'));
      });
    });
    document.querySelector('#mobile-share-button')?.addEventListener('click', async () => {
      const status = document.querySelector<HTMLElement>('#mobile-share-status');
      const url =
        menu.dataset.shareUrl ||
        document.querySelector<HTMLLinkElement>('link[rel="canonical"]')?.href;
      if (!url || !status) return;
      status.textContent = '';
      if (navigator.share) {
        try {
          await navigator.share({ title: document.title, url });
          return;
        } catch (error) {
          if (error instanceof Error && error.name === 'AbortError') return;
        }
      }
      try {
        await navigator.clipboard.writeText(url);
        status.textContent = 'Link copied.';
      } catch {
        status.textContent = 'Couldn’t copy the link. Use your browser’s Share option.';
      }
    });
  }
</script>

<style>
  .mobile-menu-trigger,
  .mobile-menu__close {
    display: inline-flex;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 0.625rem;
    color: rgb(var(--color-text));
    cursor: pointer;
  }

  .mobile-menu-trigger:hover,
  .mobile-menu__close:hover {
    color: rgb(var(--color-accent));
    background: rgb(var(--color-accent) / 0.07);
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: 28rem;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0 0 0 auto;
    padding: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    border: 0;
    color: rgb(var(--color-text));
    background: rgb(var(--color-bg));
    font-family: var(--font-sans);
  }

  .mobile-menu::backdrop {
    background: rgb(0 0 0 / 0.32);
    backdrop-filter: blur(3px);
  }

  .mobile-menu__header {
    display: flex;
    min-height: var(--site-header-height);
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 1rem;
  }

  #mobile-menu-title {
    font-family: var(--font-heading);
    font-size: 1.625rem;
    font-weight: 600;
  }

  .mobile-menu__content {
    display: flex;
    min-height: calc(100dvh - var(--site-header-height));
    flex-direction: column;
    padding: 0.75rem 1rem max(1.5rem, env(safe-area-inset-bottom));
  }

  .mobile-menu__search {
    display: flex;
    width: 100%;
    min-height: 48px;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    border-radius: 0.625rem;
    color: rgb(var(--color-accent));
    background: rgb(var(--color-accent) / 0.07);
    font-size: 0.9375rem;
    text-align: left;
    cursor: pointer;
  }

  .mobile-menu__navigation {
    display: grid;
    gap: 0.375rem;
    padding-block: 1.25rem 2rem;
  }

  .mobile-menu__primary {
    display: flex;
    min-height: 48px;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.625rem 0.75rem;
    border-radius: 0.625rem;
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: 1.4;
    cursor: pointer;
  }

  summary {
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .mobile-menu__primary:hover,
  .mobile-menu__primary[aria-current],
  .mobile-menu__group[data-active] > summary {
    color: rgb(var(--color-accent));
    background: rgb(var(--color-accent) / 0.07);
  }

  .mobile-menu__chevron {
    color: rgb(var(--color-text-muted));
    transition: transform 160ms ease;
  }

  .mobile-menu__group[open] .mobile-menu__chevron {
    transform: rotate(180deg);
  }

  .mobile-menu__children {
    display: grid;
    padding: 0.25rem 0.25rem 0.75rem 0.75rem;
  }

  .mobile-menu__children a {
    display: flex;
    min-height: 44px;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.625rem 0.75rem;
    border-radius: 0.5rem;
    color: rgb(var(--color-text-muted));
    font-size: 0.9375rem;
    line-height: 1.4;
  }

  .mobile-menu__children a:hover,
  .mobile-menu__children a[aria-current],
  .mobile-menu__children .mobile-menu__overview {
    color: rgb(var(--color-accent));
  }

  .mobile-menu__children a:hover,
  .mobile-menu__children a[aria-current] {
    background: rgb(var(--color-accent) / 0.07);
  }

  .mobile-menu__count {
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  .mobile-menu__extras {
    margin-top: auto;
    padding-inline: 0.75rem;
  }

  .mobile-menu__share {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 0.625rem;
    color: rgb(var(--color-text-muted));
    font-size: 0.875rem;
    cursor: pointer;
  }

  .mobile-menu__status {
    margin: 0;
    color: rgb(var(--color-text-muted));
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .mobile-menu__label {
    margin: 1.25rem 0 0;
    color: rgb(var(--color-text-muted));
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .mobile-menu__social {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
  }

  .mobile-menu__social a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 0.375rem;
    color: rgb(var(--color-text-muted));
    font-size: 0.8125rem;
  }

  .mobile-menu__share:hover,
  .mobile-menu__social a:hover {
    color: rgb(var(--color-accent));
  }

  a:focus-visible,
  button:focus-visible,
  summary:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 2px;
  }

  @media (min-width: 768px) {
    .mobile-menu__header {
      padding-inline: 1.5rem;
    }
    .mobile-menu__content {
      padding-inline: 1.5rem;
    }
  }

  @media (min-width: 1280px) {
    .mobile-menu-trigger {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu__chevron {
      transition: none;
    }
    .mobile-menu::backdrop {
      backdrop-filter: none;
    }
  }
</style>
