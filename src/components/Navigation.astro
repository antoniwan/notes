---
import { mainNavigation } from '../data/navigation';
import { getSortedCategories } from '../utils/categoryUtils';
import { isMainNavItemActive, isNavDropdownItemActive } from '../utils/navActive';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
const sortedCategories = await getSortedCategories();
const pathname = Astro.url.pathname;
---

<nav class:list={['site-navigation', className]} aria-label="Main navigation" data-site-navigation>
  {
    mainNavigation.map((item) => {
      const isActive = isMainNavItemActive(item.href, pathname);
      if (!item.dropdown) {
        return (
          <a
            class="site-navigation__link"
            href={item.href}
            aria-current={isActive ? 'page' : undefined}
          >
            {item.label}
          </a>
        );
      }

      const isCategories = item.href === '/category';
      return (
        <details class="nav-disclosure" data-active={isActive ? 'true' : undefined}>
          <summary class="site-navigation__link">
            {item.label}
            <svg
              class="nav-chevron"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              aria-hidden="true"
            >
              <path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </summary>
          <div class="nav-disclosure__panel">
            <p class="nav-disclosure__label">{item.dropdown.label}</p>
            {isCategories && (
              <a
                class="nav-disclosure__overview"
                href={item.href}
                aria-current={pathname === item.href ? 'page' : undefined}
              >
                All categories <span aria-hidden="true">↗</span>
              </a>
            )}
            <div class="nav-disclosure__links">
              {isCategories
                ? sortedCategories.map((category) => {
                    const href = `/category/${category.id}`;
                    return (
                      <a
                        href={href}
                        aria-current={isNavDropdownItemActive(href, pathname) ? 'page' : undefined}
                      >
                        <span>{category.name}</span>
                        <span
                          class="nav-disclosure__count"
                          aria-label={`${category.postCount} articles`}
                        >
                          {category.postCount}
                        </span>
                      </a>
                    );
                  })
                : (item.dropdown.items ?? []).map((child) => (
                    <a
                      href={child.href}
                      aria-current={
                        isNavDropdownItemActive(child.href, pathname) ? 'page' : undefined
                      }
                    >
                      <span>{child.label}</span>
                    </a>
                  ))}
            </div>
          </div>
        </details>
      );
    })
  }
</nav>

<script>
  const navigation = document.querySelector<HTMLElement>('[data-site-navigation]');
  if (navigation) {
    const disclosures = Array.from(navigation.querySelectorAll<HTMLDetailsElement>('details'));
    const closeAll = (except?: HTMLDetailsElement) => {
      disclosures.forEach((disclosure) => {
        if (disclosure !== except) disclosure.open = false;
      });
    };

    disclosures.forEach((disclosure) => {
      const summary = disclosure.querySelector('summary');
      disclosure.addEventListener('toggle', () => {
        if (disclosure.open) closeAll(disclosure);
      });
      disclosure.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && disclosure.open) {
          event.preventDefault();
          disclosure.open = false;
          summary?.focus();
        }
        if (event.key === 'ArrowDown' && event.target === summary) {
          event.preventDefault();
          disclosure.open = true;
          disclosure.querySelector('a')?.focus();
        }
      });
      disclosure.addEventListener('focusout', (event) => {
        if (!disclosure.contains(event.relatedTarget as Node | null)) disclosure.open = false;
      });
    });
    document.addEventListener('pointerdown', (event) => {
      if (!navigation.contains(event.target as Node)) closeAll();
    });
    window.matchMedia('(min-width: 1280px)').addEventListener('change', () => closeAll());
  }
</script>

<style>
  .site-navigation {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    font-family: var(--font-sans);
  }

  .site-navigation__link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 0.75rem;
    border-radius: 0.6rem;
    color: rgb(var(--color-text-muted));
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.4;
    white-space: nowrap;
    cursor: pointer;
    transition:
      color 160ms ease,
      background-color 160ms ease;
  }

  summary {
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .site-navigation__link:hover,
  .site-navigation__link[aria-current],
  .nav-disclosure[data-active] > summary,
  .nav-disclosure[open] > summary {
    color: rgb(var(--color-accent));
    background: rgb(var(--color-accent) / 0.07);
  }

  .nav-disclosure {
    position: relative;
  }

  .nav-chevron {
    transition: transform 160ms ease;
  }

  .nav-disclosure[open] .nav-chevron {
    transform: rotate(180deg);
  }

  .nav-disclosure__panel {
    position: absolute;
    z-index: 50;
    top: calc(100% + 0.625rem);
    left: 0;
    width: 17rem;
    max-height: calc(100dvh - var(--site-header-height) - 2rem);
    overflow-y: auto;
    padding: 1rem 0.625rem 0.625rem;
    border: 1px solid rgb(var(--color-border) / 0.55);
    border-radius: 0.875rem;
    background: rgb(var(--color-bg));
    box-shadow: 0 16px 48px -16px rgb(0 0 0 / 0.2);
  }

  .nav-disclosure__label {
    margin: 0 0 0.5rem;
    padding-inline: 0.625rem;
    color: rgb(var(--color-text-muted));
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .nav-disclosure__links a,
  .nav-disclosure__overview {
    display: flex;
    min-height: 44px;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.625rem;
    border-radius: 0.5rem;
    color: rgb(var(--color-text));
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .nav-disclosure__overview {
    margin-bottom: 0.375rem;
    color: rgb(var(--color-accent));
    font-weight: 500;
  }

  .nav-disclosure__links a:hover,
  .nav-disclosure__links a[aria-current],
  .nav-disclosure__overview:hover,
  .nav-disclosure__overview[aria-current] {
    background: rgb(var(--color-accent) / 0.07);
    color: rgb(var(--color-accent));
  }

  .nav-disclosure__count {
    color: rgb(var(--color-text-muted));
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  a:focus-visible,
  summary:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-navigation__link,
    .nav-chevron {
      transition: none;
    }
  }
</style>
