---
interface Props {
  class?: string;
  placeholder?: string;
}

const { class: className = '', placeholder = 'Search writings, pages...' } = Astro.props;

// Generate unique ID for this search instance
const searchId = `search-${Math.random().toString(36).slice(2, 11)}`;
---

<div class={`search-container relative ${className}`}>
  <!-- Search Input -->
  <div class="relative">
    <!-- Search Icon -->
    <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-2.5">
      <svg class="text-body-muted h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
    </div>

    <!-- Input Field -->
    <input
      type="search"
      id={searchId}
      autocomplete="off"
      aria-controls={`${searchId}-results`}
      class="search-input"
      placeholder={placeholder}
      aria-label="Search writings"
    />

    <!-- Clear Button -->
    <button
      id={`${searchId}-clear`}
      type="button"
      class="search-clear hidden"
      aria-label="Clear search"
    >
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <!-- Polite status for assistive technology. Lives outside the dropdown so it is
       announced even while the results region is hidden. -->
  <p id={`${searchId}-status`} class="sr-only" role="status" aria-live="polite" aria-atomic="true">
  </p>

  <!-- Search Results Dropdown -->
  <div
    id={`${searchId}-results`}
    class="search-dropdown hidden"
    role="region"
    aria-label="Search results"
    aria-busy="false"
  >
    <!-- Loading State -->
    <div id={`${searchId}-loading`} class="text-body-muted hidden p-8 text-center">
      <div class="flex flex-col items-center space-y-3">
        <div class="relative">
          <svg class="h-8 w-8 animate-spin" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"
            ></circle>
            <path
              class="opacity-75"
              fill="currentColor"
              d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
            ></path>
          </svg>
        </div>
        <p class="text-sm font-medium">Searching...</p>
      </div>
    </div>

    <!-- No Results State -->
    <div id={`${searchId}-no-results`} class="text-body-muted hidden p-8 text-center">
      <div class="flex flex-col items-center space-y-4">
        <div class="space-y-2">
          <p class="text-base font-semibold">No results found</p>
          <p class="text-sm opacity-75">Try searching for writings, categories, topics, or pages</p>
        </div>
      </div>
    </div>

    <!-- Results List -->
    <div id={`${searchId}-results-list`} class="search-results-list"></div>
  </div>
</div>

<script>
  // Search functionality
  class SearchBar {
    private input: HTMLInputElement | null;
    private results: HTMLElement | null;
    private resultsList: HTMLElement | null;
    private loading: HTMLElement | null;
    private noResults: HTMLElement | null;
    private clearBtn: HTMLButtonElement | null;
    private status: HTMLElement | null;
    private debounceTimer: ReturnType<typeof setTimeout> | null = null;
    private isSearching = false;
    private searchRequestId = 0;

    constructor(searchId: string) {
      this.input = document.getElementById(searchId) as HTMLInputElement;
      this.results = document.getElementById(`${searchId}-results`) as HTMLElement;
      this.resultsList = document.getElementById(`${searchId}-results-list`) as HTMLElement;
      this.loading = document.getElementById(`${searchId}-loading`) as HTMLElement;
      this.noResults = document.getElementById(`${searchId}-no-results`) as HTMLElement;
      this.clearBtn = document.getElementById(`${searchId}-clear`) as HTMLButtonElement;
      this.status = document.getElementById(`${searchId}-status`) as HTMLElement;

      this.init();
    }

    init() {
      if (!this.input) return;

      // Input event
      this.input.addEventListener('input', () => {
        this.handleInput();
      });

      // Focus events
      this.input?.addEventListener('focus', () => {
        const hasQuery = !!this.input?.value.trim();
        if (hasQuery) {
          this.showResults();
          if (this.clearBtn) {
            this.clearBtn.classList.toggle('hidden', !hasQuery);
          }
        }
      });

      // Clear button
      if (this.clearBtn) {
        this.clearBtn.addEventListener('click', () => {
          this.clearSearch();
        });
      }

      // Click outside to close
      document.addEventListener('click', (e) => {
        if (!this.input?.contains(e.target as Node) && !this.results?.contains(e.target as Node)) {
          this.hideResults();
        }
      });

      document.addEventListener('focusin', (event) => {
        if (!this.input?.closest('.search-container')?.contains(event.target as Node))
          this.hideResults();
      });
      this.resultsList?.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
          event.preventDefault();
          this.handleArrowKeys(event.key);
        } else if (event.key === 'Escape') {
          event.preventDefault();
          this.input?.focus();
          this.hideResults();
        }
      });

      // Keyboard navigation
      this.input.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          this.hideResults();
          e.preventDefault();
        } else if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
          e.preventDefault();
          this.handleArrowKeys(e.key);
        } else if (e.key === 'Enter') {
          e.preventDefault();
          this.handleEnterKey();
        }
      });
    }

    handleInput() {
      const query = this.input?.value.trim() || '';
      this.searchRequestId += 1;

      // Show/hide clear button
      if (this.clearBtn) {
        this.clearBtn.classList.toggle('hidden', !query);
      }

      // Clear previous timer
      if (this.debounceTimer) {
        clearTimeout(this.debounceTimer);
        this.debounceTimer = null;
      }

      // Debounce search
      this.debounceTimer = setTimeout(() => {
        this.debounceTimer = null;
        if (query.length >= 2) {
          this.performSearch(query);
        } else {
          this.announce('');
          this.hideResults();
        }
      }, 300);
    }

    async performSearch(query: string) {
      if (this.isSearching) return;

      const requestId = this.searchRequestId;
      this.isSearching = true;
      this.showLoading();
      this.announce('Searching');

      try {
        // Simulate search - replace with actual search implementation
        const results = await this.searchPosts(query);
        if (requestId !== this.searchRequestId || this.input?.value.trim() !== query) return;
        this.displayResults(results, query);
      } catch (error) {
        if (requestId !== this.searchRequestId || this.input?.value.trim() !== query) return;
        this.showNoResults(query);
      } finally {
        this.isSearching = false;
        this.setBusy(false);
      }
    }

    async searchPosts(query: string) {
      // Get the search data from the global variable
      const searchData = (window as any).searchData || [];

      if (!searchData || searchData.length === 0) {
        return [];
      }

      const normalizedQuery = query.toLowerCase().trim();

      // Perform enhanced search across all content types
      const results = searchData.filter((item: any) => {
        // Basic text matches
        const titleMatch = item.title?.toLowerCase().includes(normalizedQuery);
        const descriptionMatch = item.description?.toLowerCase().includes(normalizedQuery);

        // Content type specific searches
        let additionalMatches = false;

        if (item.type === 'post') {
          // Search in post-specific fields
          const categoryMatch = item.category?.some((cat: string) =>
            cat.toLowerCase().includes(normalizedQuery),
          );
          const tagsMatch = item.tags?.some((tag: string) =>
            tag.toLowerCase().includes(normalizedQuery),
          );
          const authorMatch = item.author?.toLowerCase().includes(normalizedQuery);
          const keywordsMatch = item.keywords?.some((keyword: string) =>
            keyword.toLowerCase().includes(normalizedQuery),
          );
          additionalMatches = categoryMatch || tagsMatch || authorMatch || keywordsMatch;
        } else if (item.type === 'tag') {
          // Search in tag-specific fields
          const weightMatch = item.weight?.toString().includes(normalizedQuery);
          additionalMatches = weightMatch;
        }

        return titleMatch || descriptionMatch || additionalMatches;
      });

      // Enhanced relevance scoring and sorting
      const scoredResults = results.map((item: any) => {
        let score = 0;
        const titleMatch = item.title?.toLowerCase().includes(normalizedQuery);
        const descriptionMatch = item.description?.toLowerCase().includes(normalizedQuery);

        // Base scoring
        if (titleMatch) score += 10;
        if (descriptionMatch) score += 5;

        // Content type specific scoring
        if (item.type === 'post') {
          // Posts get priority for most searches
          score += 3;
          if (item.category?.some((cat: string) => cat.toLowerCase().includes(normalizedQuery)))
            score += 2;
          if (item.tags?.some((tag: string) => tag.toLowerCase().includes(normalizedQuery)))
            score += 1;
        } else if (item.type === 'category') {
          // Categories get high priority for category searches
          score += 4;
        } else if (item.type === 'tag') {
          // Tags get medium priority
          score += 2;
          if (item.weight > 5) score += 1; // Higher weight tags get slight boost
        } else if (item.type === 'page') {
          // Pages get lower priority
          score += 1;
        }

        return { ...item, score };
      });

      // Sort by score (highest first), then by title length for ties
      const sortedResults = scoredResults.sort((a: any, b: any) => {
        if (b.score !== a.score) return b.score - a.score;
        return a.title.length - b.title.length;
      });

      // Return top 10 results with enhanced metadata
      return sortedResults.slice(0, 10).map((item: any) => ({
        title: item.title,
        description: item.description,
        url: item.url,
        image: item.heroImage,
        category: item.category,
        type: item.type,
        author: item.author,
        themes: item.themes,
        icon: item.icon,
        language: item.language,
      }));
    }

    displayResults(results: any[], query = '') {
      if (!this.resultsList) return;

      this.hideLoading();
      this.hideNoResults();

      if (results.length === 0) {
        this.showNoResults(query);
        return;
      }

      // Create search results using safe DOM manipulation
      this.resultsList.replaceChildren();

      results.forEach((result) => {
        // Get appropriate icon and styling based on content type
        const typeConfig = this.getTypeConfig(result.type);

        // Create main link element
        const link = document.createElement('a');
        link.href = this.escapeAttribute(result.url);
        link.className = 'search-result-item group';

        // Create content structure
        const content = document.createElement('div');
        content.className = 'search-result-content';

        // Create image section
        const imageDiv = document.createElement('div');
        imageDiv.className = 'search-result-image';

        if (result.image) {
          const img = document.createElement('img');
          img.src = this.escapeAttribute(result.image);
          img.alt = '';
          img.className = 'w-full h-full object-cover rounded-lg';
          imageDiv.appendChild(img);
        } else {
          const iconDiv = document.createElement('div');
          iconDiv.className = `w-full h-full flex items-center justify-center text-body-muted ${typeConfig.bgClass} rounded-lg`;
          iconDiv.innerHTML = typeConfig.icon; // Safe: typeConfig.icon is from internal config
          imageDiv.appendChild(iconDiv);
        }

        // Create text section
        const textDiv = document.createElement('div');
        textDiv.className = 'search-result-text';

        // Title and type section
        const headerDiv = document.createElement('div');
        headerDiv.className = 'flex items-start justify-between gap-3 mb-2';

        const title = document.createElement('h3');
        title.className = 'search-result-title group-hover:text-[rgb(var(--color-accent))]';
        title.textContent = result.title;

        headerDiv.appendChild(title);

        const primaryLang = Array.isArray(result.language) ? result.language[0] : result.language;
        if (result.type === 'post' && primaryLang === 'es') {
          const langSpan = document.createElement('span');
          langSpan.className =
            'search-result-type text-xs px-2.5 py-1 rounded-full bg-[rgb(var(--color-accent))]/10 text-[rgb(var(--color-accent))] font-medium flex-shrink-0';
          langSpan.textContent = 'ES';
          langSpan.setAttribute('aria-label', 'Spanish');
          headerDiv.appendChild(langSpan);
        }

        if (result.type !== 'post') {
          const typeSpan = document.createElement('span');
          typeSpan.className = `search-result-type text-xs px-2.5 py-1 rounded-full ${typeConfig.badgeClass} font-medium flex-shrink-0`;
          typeSpan.textContent = typeConfig.label;
          headerDiv.appendChild(typeSpan);
        }

        // Description
        const description = document.createElement('p');
        description.className = 'search-result-description';
        description.textContent = result.description;

        // Meta section
        const metaDiv = document.createElement('div');
        metaDiv.className = 'search-result-meta';

        // Add author if present
        if (result.author) {
          const authorSpan = this.createMetaSpan(
            'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z',
            result.author,
          );
          metaDiv.appendChild(authorSpan);
        }

        // Add themes if present
        if (result.themes && result.themes.length > 0) {
          const themesText =
            result.themes.slice(0, 2).join(', ') + (result.themes.length > 2 ? '...' : '');
          const themesSpan = this.createMetaSpan(
            'M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z',
            themesText,
          );
          metaDiv.appendChild(themesSpan);
        }

        // Add category if present
        if (result.category && result.category.length > 0) {
          const categorySpan = this.createMetaSpan(
            'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10',
            result.category[0],
          );
          metaDiv.appendChild(categorySpan);
        }

        // Assemble everything
        textDiv.appendChild(headerDiv);
        textDiv.appendChild(description);
        textDiv.appendChild(metaDiv);

        content.appendChild(imageDiv);
        content.appendChild(textDiv);

        link.appendChild(content);
        this.resultsList?.appendChild(link);
      });

      this.showResults();
      this.announce(
        `${results.length} ${results.length === 1 ? 'result' : 'results'}${this.forQuery(query)}. Use the arrow keys to review them.`,
      );
    }

    getTypeConfig(type: string) {
      const configs = {
        post: {
          label: 'Note',
          icon: `<svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
					</svg>`,
          bgClass: 'bg-blue-50 dark:bg-blue-900/30',
          badgeClass: 'bg-blue-100 text-blue-800 dark:bg-blue-900/40 dark:text-blue-200',
        },

        category: {
          label: 'Category',
          icon: `<svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
					</svg>`,
          bgClass: 'bg-purple-50 dark:bg-purple-900/30',
          badgeClass: 'bg-purple-100 text-purple-800 dark:bg-purple-900/40 dark:text-purple-200',
        },
        tag: {
          label: 'Topic',
          icon: `<svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
					</svg>`,
          bgClass: 'bg-orange-50 dark:bg-orange-900/30',
          badgeClass: 'bg-orange-100 text-orange-800 dark:bg-orange-900/40 dark:text-orange-200',
        },
        page: {
          label: 'Page',
          icon: `<svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
					</svg>`,
          bgClass: 'bg-gray-50 dark:bg-gray-900/30',
          badgeClass: 'bg-gray-100 text-gray-800 dark:bg-gray-900/40 dark:text-gray-200',
        },
      };

      return configs[type as keyof typeof configs] || configs.page;
    }

    showResults() {
      if (this.results) {
        this.results.classList.remove('hidden');
      }
    }

    hideResults() {
      if (this.results) {
        this.results.classList.add('hidden');
      }
      this.setBusy(false);
      // Hide clear button when closing results without navigating
      if (this.clearBtn) {
        this.clearBtn.classList.add('hidden');
      }
    }

    showLoading() {
      if (this.loading) this.loading.classList.remove('hidden');
      if (this.noResults) this.noResults.classList.add('hidden');
      if (this.resultsList) this.resultsList.innerHTML = '';
      this.setBusy(true);
      this.showResults();
    }

    hideLoading() {
      if (this.loading) this.loading.classList.add('hidden');
    }

    showNoResults(query = '') {
      if (this.noResults) this.noResults.classList.remove('hidden');
      if (this.loading) this.loading.classList.add('hidden');
      if (this.resultsList) this.resultsList.replaceChildren();
      this.showResults();
      this.announce(`No results found${this.forQuery(query)}.`);
    }

    hideNoResults() {
      if (this.noResults) this.noResults.classList.add('hidden');
    }

    clearSearch() {
      this.searchRequestId += 1;
      if (this.debounceTimer) {
        clearTimeout(this.debounceTimer);
        this.debounceTimer = null;
      }
      if (this.input) {
        this.input.value = '';
        this.input.focus();
      }
      this.announce('');
      this.hideResults();
      if (this.clearBtn) {
        this.clearBtn.classList.add('hidden');
      }
    }

    announce(message: string) {
      if (!this.status || this.status.textContent === message) return;
      this.status.textContent = message;
    }

    setBusy(busy: boolean) {
      this.results?.setAttribute('aria-busy', busy ? 'true' : 'false');
    }

    forQuery(query: string): string {
      const trimmed = query.trim();
      return trimmed ? ` for ${trimmed}` : '';
    }

    handleArrowKeys(key: string) {
      const resultItems = this.resultsList?.querySelectorAll(
        '.search-result-item',
      ) as NodeListOf<HTMLElement>;
      if (!resultItems || resultItems.length === 0 || this.results?.classList.contains('hidden'))
        return;

      const currentIndex = Array.from(resultItems).findIndex(
        (item) => item === document.activeElement,
      );

      let newIndex = 0;
      if (key === 'ArrowDown') {
        newIndex = currentIndex < resultItems.length - 1 ? currentIndex + 1 : 0;
      } else if (key === 'ArrowUp') {
        newIndex = currentIndex > 0 ? currentIndex - 1 : resultItems.length - 1;
      }

      resultItems.forEach((item) => {
        item.classList.remove('search-result-item--keyboard-active');
      });

      const selectedItem = resultItems[newIndex];
      if (selectedItem) {
        selectedItem.classList.add('search-result-item--keyboard-active');
        selectedItem.focus({ preventScroll: true });
        selectedItem.scrollIntoView({ block: 'nearest' });
      }
    }

    handleEnterKey() {
      const highlightedItem = this.resultsList?.querySelector(
        '.search-result-item--keyboard-active',
      ) as HTMLAnchorElement;
      if (highlightedItem && !this.results?.classList.contains('hidden')) {
        highlightedItem.click();
      } else {
        // If no item is highlighted, submit the search (you could implement a search page here)
      }
    }

    // Helper methods for safe DOM creation
    escapeAttribute(value: string): string {
      const div = document.createElement('div');
      div.textContent = value;
      return div.innerHTML;
    }

    createMetaSpan(svgPath: string, text: string): HTMLElement {
      const span = document.createElement('span');
      span.className = 'flex items-center gap-1.5';

      const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
      svg.setAttribute('class', 'h-3.5 w-3.5');
      svg.setAttribute('fill', 'none');
      svg.setAttribute('stroke', 'currentColor');
      svg.setAttribute('viewBox', '0 0 24 24');

      const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      path.setAttribute('stroke-linecap', 'round');
      path.setAttribute('stroke-linejoin', 'round');
      path.setAttribute('stroke-width', '2');
      path.setAttribute('d', svgPath);

      svg.appendChild(path);

      const textNode = document.createElement('span');
      textNode.textContent = text;

      span.appendChild(svg);
      span.appendChild(textNode);

      return span;
    }
  }

  // Initialize search bars
  function initializeSearchBars() {
    const searchInputs = document.querySelectorAll('input[id^="search-"]');
    searchInputs.forEach((input) => {
      const searchId = input.id;
      new SearchBar(searchId);
    });
  }
  if (document.readyState === 'loading')
    document.addEventListener('DOMContentLoaded', initializeSearchBars, { once: true });
  else initializeSearchBars();
</script>

<style>
  .search-container {
    font-family: var(--font-sans);
  }
  .search-input {
    display: block;
    width: 100%;
    min-height: 44px;
    padding: 0.625rem 2.75rem 0.625rem 2.125rem;
    border: 1px solid transparent;
    border-radius: 0.75rem;
    background: rgb(var(--color-accent) / 0.055);
    color: rgb(var(--color-text));
    font: inherit;
    font-size: 0.875rem;
    line-height: 1.5;
    box-shadow: none;
    transition:
      background-color 150ms ease,
      border-color 150ms ease;
  }
  .search-input::placeholder {
    color: rgb(var(--color-text-muted));
    opacity: 1;
  }
  .search-input:hover {
    background: rgb(var(--color-accent) / 0.08);
  }
  .search-input:focus {
    border-color: rgb(var(--color-accent) / 0.45);
    outline: 2px solid rgb(var(--color-accent) / 0.2);
    outline-offset: 2px;
  }
  .search-input::-webkit-search-cancel-button {
    display: none;
  }
  .search-clear {
    position: absolute;
    inset-block: 0;
    right: 0;
    width: 44px;
    align-items: center;
    justify-content: center;
    border-radius: 0.75rem;
    color: rgb(var(--color-text-muted));
    cursor: pointer;
  }
  .search-clear:not(.hidden) {
    display: flex;
  }
  .search-clear:hover {
    color: rgb(var(--color-accent));
  }
  .search-clear:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
  }
  .search-dropdown {
    position: absolute;
    top: 100%;
    inset-inline: 0;
