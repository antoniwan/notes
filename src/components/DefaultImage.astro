---
// Cover fallback for posts without a hero image.
// Fills the parent frame (hero banner, postcard, rotator) with object-cover.

import { Image } from 'astro:assets';
import { getDefaultCoverUrls } from '../data/defaultCovers';
import { HERO_QUALITY, HERO_WIDTHS, resolveHeroImage } from '../utils/heroImages';

interface Props {
  alt?: string;
  className?: string;
  loading?: 'lazy' | 'eager';
  seed?: string;
  sizes?: string;
  priority?: boolean;
  width?: number;
  height?: number;
}

const {
  alt = 'Default cover image',
  className = '',
  loading = 'lazy',
  seed,
  sizes = '(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw',
  priority = false,
  width,
  height,
} = Astro.props;

const defaultImages = getDefaultCoverUrls();

const hashInput = seed || alt || 'default';
const hash = hashInput.split('').reduce((a, b) => {
  a = (a << 5) - a + b.charCodeAt(0);
  return a & a;
}, 0);
const selectedImage = defaultImages[Math.abs(hash) % defaultImages.length];

const finalLoading = priority ? 'eager' : loading;
const fetchPriority = priority ? 'high' : 'auto';

// These covers moved under src/ with the hero art, so the same resolver gives
// them a srcset. Before this they carried a `sizes` attribute with no `srcset`
// to select from, which does nothing: a 1536px cover was painted into a 358px
// box on /everything, fourteen times over.
const resolved = resolveHeroImage(selectedImage);
---

{
  resolved ? (
    <Image
      src={resolved}
      alt={alt}
      class:list={[className, 'default-cover', priority && 'priority-image']}
      widths={HERO_WIDTHS}
      sizes={sizes}
      format="avif"
      quality={HERO_QUALITY}
      loading={finalLoading}
      fetchpriority={fetchPriority}
      decoding="async"
    />
  ) : (
    <img
      src={selectedImage}
      alt={alt}
      class:list={[className, 'default-cover', priority && 'priority-image']}
      loading={finalLoading}
      fetchpriority={fetchPriority}
      decoding="async"
      width={width}
      height={height}
    />
  )
}

<style>
  .default-cover {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    margin: 0 !important;
    object-fit: cover;
    object-position: center;
  }

  .priority-image {
    will-change: transform;
    transform: translateZ(0);
  }
</style>
