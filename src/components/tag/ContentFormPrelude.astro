---
import type { ContentFormPreludeItem } from '../../utils/tag/contentFormTags';
import { formatPreludeConnectors } from '../../utils/tag/contentFormTags';
import {
  buildPreludeTemplateCandidates,
  PRELUDE_THEME_LIMIT,
  selectPreludeTemplates,
} from '../../utils/tag/preludeTemplates';

interface Props {
  items: ContentFormPreludeItem[];
  tagCounts: Record<string, number>;
}

const { items, tagCounts } = Astro.props;

const primaryItems = items.filter((item) => item.label !== 'poems');
const chunks: ContentFormPreludeItem[][] = [];
for (let index = 0; index < primaryItems.length; index += 4) {
  chunks.push(primaryItems.slice(index, index + 4));
}

const formSlugsAlreadyLinked = primaryItems.map((item) => item.href.replace(/^\/tag\//, ''));
const tagLink = (tag: string) => `/tag/${encodeURIComponent(tag)}`;
const asHashTag = (tag: string) => `#${tag}`;
const candidates = buildPreludeTemplateCandidates({ tagCounts });
const templates = selectPreludeTemplates(candidates, PRELUDE_THEME_LIMIT, {
  excludeTags: formSlugsAlreadyLinked,
});
---

{
  (chunks.length > 0 || templates.length > 0) && (
    <section class="mb-6">
      <ul class="text-body-muted list-disc space-y-1.5 pl-5 text-sm leading-relaxed">
        {chunks.map((chunk, chunkIndex) => {
          const connectors = formatPreludeConnectors(chunk.length);
          const prefix = chunkIndex === 0 ? "I've written" : "I've also written";
          return (
            <li>
              {prefix}
              {chunk.map((item, itemIndex) => (
                <>
                  <span>{connectors[itemIndex] ?? ', '}</span>
                  <a
                    href={item.href}
                    class="font-medium text-[rgb(var(--color-accent))] underline decoration-[rgb(var(--color-accent))]/40 underline-offset-4 hover:text-[rgb(var(--color-accent-hover))]"
                  >
                    {asHashTag(item.label)}
                  </a>
                </>
              ))}
              .
            </li>
          );
        })}

        {templates.map((template) => {
          const connectors = formatPreludeConnectors(template.tags.length);
          return (
            <li>
              {template.prefix}
              {template.tags.map((tag, index) => (
                <>
                  <span>{connectors[index] ?? ', '}</span>
                  <a
                    href={tagLink(tag)}
                    class="font-medium text-[rgb(var(--color-accent))] underline decoration-[rgb(var(--color-accent))]/40 underline-offset-4 hover:text-[rgb(var(--color-accent-hover))]"
                  >
                    {asHashTag(tag)}
                  </a>
                </>
              ))}
              {template.suffix ? ` ${template.suffix}` : ''}.
            </li>
          );
        })}
      </ul>
    </section>
  )
}
