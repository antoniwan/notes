---
import { getTagFamily } from '../../data/tagFamilies';
import { getTagMetadata } from '../../data/tags';
import {
  buildPreludeTemplateCandidates,
  formatPreludeConnectors,
  orderPreludeTemplates,
  PRELUDE_THEME_LIMIT,
  selectPreludeTemplates,
  type PreludePost,
} from '../../utils/tag/preludeTemplates';

interface Props {
  tagCounts: Record<string, number>;
  /** The same writings as `tagCounts`, with canonical tags and dates, for the order. */
  posts: PreludePost[];
}

const { tagCounts, posts } = Astro.props;
const candidates = buildPreludeTemplateCandidates({ tagCounts });
const templates = orderPreludeTemplates(
  selectPreludeTemplates(candidates, PRELUDE_THEME_LIMIT),
  posts,
);
---

{templates.length > 0 && (
  <section class="sentence-browse" aria-labelledby="sentence-browse-heading">
    <h2 id="sentence-browse-heading">Ways into the writing</h2>
    <ul class="sentence-list" role="list">
      {templates.map((template) => {
        const connectors = formatPreludeConnectors(template.tags.length);
        return (
          <li>
            <span class="sentence-lead">{template.prefix}</span>
            {template.tags.map((tag, index) => (
              <>
                <span>{connectors[index] ?? ', '}</span>
                <a
                  href={`/tag/${encodeURIComponent(tag)}`}
                  class="tag-chip tag-chip--underline"
                  data-tag-family={getTagFamily(tag)}
                >
                  {getTagMetadata(tag).name}
                </a>
              </>
            ))}
            {template.suffix ? ` ${template.suffix}` : ''}
            {template.link && (
              <>
                {`${template.link.lead} `}
                <a href={template.link.href}>{template.link.label}</a>
              </>
            )}
            .
          </li>
        );
      })}
    </ul>
  </section>
)}

<style>
  .sentence-browse h2 {
    margin: 0 0 2rem;
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 2.4vw, 2rem);
    font-weight: 600;
    line-height: var(--leading-tight);
    letter-spacing: -0.025em;
  }

  .sentence-list {
    display: grid;
    gap: 1.5rem 2.5rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .sentence-list li {
    min-width: 0;
    max-width: var(--measure);
    padding: 0;
    margin: 0;
    color: rgb(var(--color-text));
    font-family: var(--font-serif);
    font-size: 1.125rem;
    line-height: var(--leading-relaxed);
    text-wrap: pretty;
  }

  .sentence-lead {
    font-weight: 400;
  }

  .sentence-list a {
    color: rgb(var(--color-accent));
    font-weight: 500;
    text-decoration-color: rgb(var(--color-accent) / 0.5);
    text-decoration-thickness: 1px;
  }

  .sentence-list a:hover {
    color: rgb(var(--color-accent-hover));
    text-decoration-color: currentColor;
  }

  .sentence-list a:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 4px;
  }

  @media (min-width: 1024px) {
    .sentence-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem 2.5rem;
    }
  }
</style>
