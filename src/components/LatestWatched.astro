---
import { letterboxdDiaryUrlFromProfile, type LetterboxdWatch } from '../utils/letterboxd';

interface Props {
  films: LetterboxdWatch[];
  profileUrl: string;
}

const { films, profileUrl } = Astro.props;
const diaryUrl = letterboxdDiaryUrlFromProfile(profileUrl);

function starSummary(rating: string | null): { visual: string; a11y: string } | null {
  if (!rating) return null;
  const n = parseFloat(rating);
  if (Number.isNaN(n) || n < 0 || n > 5) return null;
  const full = Math.floor(n);
  const frac = n - full;
  let visual = '★'.repeat(full);
  if (frac >= 0.25 && frac <= 0.99) visual += '½';
  return { visual, a11y: `${n} out of 5 stars` };
}
---

<section class="about-watched" aria-labelledby="about-watched-heading">
  <div class="about-watched__intro">
    <h2 id="about-watched-heading" class="about-watched__heading">
      Latest things I&apos;ve watched
    </h2>
    {
      films.length > 0 ? (
        <p class="about-watched__lede">
          Pulled from my{' '}
          <a href={diaryUrl} target="_blank" rel="noopener noreferrer">
            Letterboxd diary
          </a>
          — same spirit as the <a href="/library/books">book library</a>: I love movies!!!
        </p>
      ) : (
        <p class="about-watched__lede">
          See my recent watches in my{' '}
          <a href={diaryUrl} target="_blank" rel="noopener noreferrer">
            Letterboxd diary
          </a>
          , or browse the <a href="/library/books">book library</a>.
        </p>
      )
    }
  </div>

  {
    films.length > 0 && (
      <>
        <ul class="about-watched__gallery">
          {films.map((film) => {
            const stars = starSummary(film.memberRating);
            return (
              <li class="about-watched__item">
                <a
                  href={film.href}
                  class="about-watched__card"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span class="about-watched__artwork">
                    {film.posterUrl ? (
                      <img
                        src={film.posterUrl}
                        alt=""
                        width={200}
                        height={300}
                        class="about-watched__poster"
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <span
                        class="about-watched__poster about-watched__poster--placeholder"
                        aria-hidden="true"
                      />
                    )}
                  </span>
                  <span class="about-watched__meta">
                    <span class="about-watched__title">{film.filmTitle}</span>
                    <span class="about-watched__details">
                      {film.filmYear && <span class="about-watched__year">{film.filmYear}</span>}
                      {stars && (
                        <span class="about-watched__stars" aria-label={stars.a11y}>
                          <span aria-hidden="true">{stars.visual}</span>
                        </span>
                      )}
                    </span>
                    {film.rewatch && <span class="about-watched__rewatch">Rewatch</span>}
                  </span>
                </a>
              </li>
            );
          })}
        </ul>
        <p class="about-watched__footer">
          <a href={diaryUrl} target="_blank" rel="noopener noreferrer">
            Full diary on Letterboxd <span aria-hidden="true">↗</span>
          </a>
        </p>
      </>
    )
  }
</section>

<style>
  .about-watched__intro {
    display: grid;
    align-items: end;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .about-watched__heading {
    max-width: 20ch;
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--about-heading-size, 2rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .about-watched__lede {
    max-width: 48ch;
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--about-body-size, 1.125rem);
    line-height: 1.65;
    color: rgb(var(--color-text-muted));
  }

  .about-watched__lede a {
    color: rgb(var(--color-accent));
    text-decoration: underline;
    text-decoration-color: rgb(var(--color-accent) / 0.4);
    text-underline-offset: 0.18em;
  }

  .about-watched__lede a:hover {
    text-decoration-color: currentColor;
  }

  .about-watched__gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .about-watched__item {
    min-width: 0;
  }

  .about-watched__card {
    display: block;
    height: 100%;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid rgb(var(--color-border) / 0.6);
    color: rgb(var(--color-text));
    text-decoration: none;
  }

  .about-watched__artwork {
    display: block;
    overflow: hidden;
    margin-bottom: 0.8rem;
    aspect-ratio: 2 / 3;
    background: rgb(var(--color-bg-alt));
  }

  .about-watched__poster {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms ease;
  }

  .about-watched__poster--placeholder {
    background: linear-gradient(145deg, rgb(var(--color-bg-alt)), rgb(var(--color-border) / 0.35));
  }

  .about-watched__meta {
    display: grid;
    gap: 0.35rem;
    font-family: var(--font-sans);
    font-size: var(--about-body-size, 1.125rem);
    line-height: 1.4;
  }

  .about-watched__title {
    font-weight: 600;
    color: rgb(var(--color-text));
  }

  .about-watched__details {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.65rem;
  }

  .about-watched__year {
    color: rgb(var(--color-text-muted));
    font-size: 0.875rem;
  }

  .about-watched__stars {
    color: rgb(var(--color-accent));
    font-size: 0.875rem;
    letter-spacing: 0.01em;
    line-height: 1;
  }

  .about-watched__rewatch {
    color: rgb(var(--color-text-muted));
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
  }

  .about-watched__card:hover .about-watched__poster {
    transform: scale(1.04);
  }

  .about-watched__card:hover .about-watched__title {
    color: rgb(var(--color-accent));
  }

  .about-watched__footer {
    display: flex;
    justify-content: flex-end;
    margin: 1.5rem 0 0;
    font-family: var(--font-sans);
    font-size: var(--about-body-size, 1.125rem);
    line-height: 1.5;
  }

  .about-watched__footer a {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: rgb(var(--color-accent));
    text-decoration: none;
  }

  .about-watched__footer a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .about-watched__footer span {
    font-size: var(--about-body-size, 1.125rem);
  }

  .about-watched a:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 5px;
  }

  @media (min-width: 640px) {
    .about-watched__gallery {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2rem 1.5rem;
    }
  }

  @media (min-width: 800px) {
    .about-watched__gallery {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 960px) {
    .about-watched__intro {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 4rem;
    }
  }

  @media (min-width: 1200px) {
    .about-watched__gallery {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-watched__poster {
      transition: none;
    }

    .about-watched__card:hover .about-watched__poster {
      transform: none;
    }
  }
</style>
