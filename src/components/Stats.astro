---
/**
 * Stats: Antonio's self-hosted Umami, shared by all his sites (see docs/analytics.md).
 * Renders nothing unless the build has PUBLIC_UMAMI_HOST and PUBLIC_UMAMI_WEBSITE_ID,
 * so local builds and previews stay script-free.
 */
const host = import.meta.env.PUBLIC_UMAMI_HOST as string | undefined;
const websiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID as string | undefined;
---

{host && websiteId && (
  <>
    <script is:inline>
      // The same rule as BaseLayout's Vercel Analytics hook: a reader's search (?q=) never leaves the page.
      window.statsBeforeSend = (type, payload) => {
        if (payload?.url) {
          const url = new URL(payload.url, location.origin);
          url.searchParams.delete('q');
          payload.url = url.href;
        }
        return payload;
      };
      // Clicks to other sites become an "outbound" event: the host, and the address without its query.
      document.addEventListener(
        'click',
        (event) => {
          const link = event.target instanceof Element ? event.target.closest('a[href]') : null;
          if (!link) return;
          const url = new URL(link.href, location.href);
          if (!/^https?:$/.test(url.protocol) || url.host === location.host) return;
          // A call to action that leaves the site keeps its "cta" event and carries the same two
          // properties, so the click is counted once and still counts as a click out.
          if (link.getAttribute('data-umami-event') === 'cta') {
            link.setAttribute('data-umami-event-to', url.hostname);
            link.setAttribute('data-umami-event-url', url.origin + url.pathname);
            return;
          }
          if (link.hasAttribute('data-umami-event')) return;
          window.umami?.track('outbound', { to: url.hostname, url: url.origin + url.pathname });
        },
        true,
      );
      // "read-end": the reader reached the end of a post's text. Sent once per page view.
      document.addEventListener('DOMContentLoaded', () => {
        const end = document.querySelector('[data-read-end]');
        if (!end || !('IntersectionObserver' in window)) return;
        const watch = new IntersectionObserver((entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          watch.disconnect();
          window.umami?.track('read-end', { post: location.pathname });
        });
        watch.observe(end);
      });
    </script>
    <script
      is:inline
      defer
      src={`${host}/p.js`}
      data-website-id={websiteId}
      data-domains="notes.antoniwan.online"
      data-do-not-track="true"
      data-before-send="statsBeforeSend"
    />
  </>
)}
