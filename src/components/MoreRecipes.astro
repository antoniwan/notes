---
import type { CollectionEntry } from 'astro:content';
import { findMoreRecipes } from '../utils/recipes';
import { isSpanishPrimary } from '../utils/publishFilters';
import PostCard from './PostCard.astro';

interface Props {
  currentPost?: CollectionEntry<'blog'>;
  allPosts?: CollectionEntry<'blog'>[];
}

const { currentPost, allPosts } = Astro.props;
const moreRecipes = currentPost && allPosts ? findMoreRecipes(currentPost, allPosts, 4) : [];
const isSpanish = currentPost ? isSpanishPrimary(currentPost.data) : false;
---

<section class="more-recipes" aria-labelledby="more-recipes-heading">
  <header class="recipes-heading">
    <h2 id="more-recipes-heading">{isSpanish ? 'Más recetas' : 'More recipes'}</h2>
    {
      moreRecipes.length > 0 && (
        <p>{isSpanish ? 'Otros platos de esta cocina.' : 'Other dishes from this kitchen.'}</p>
      )
    }
  </header>
  {
    moreRecipes.length > 0 && (
      <div class="postcards-grid recipes-grid">
        {moreRecipes.map((post) => (
          <PostCard
            post={post}
            compact
            headingAs="h3"
            idPrefix="more-recipes"
            showFeaturedIndicator={false}
          />
        ))}
      </div>
    )
  }
  <a href="/recipes" class="recipes-browse">
    {isSpanish ? 'Explorar el recetario (índice en inglés)' : 'Browse the cookbook'}
  </a>
</section>

<style>
  .more-recipes {
    scroll-margin-top: calc(var(--site-header-height) + 1.5rem);
  }

  .recipes-heading {
    margin-bottom: 2rem;
  }

  .recipes-heading h2 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 2.4vw, 2rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.025em;
  }

  .recipes-heading p {
    max-width: 62ch;
    margin: 1rem 0 0;
    color: rgb(var(--color-text-muted));
    font-size: 1.125rem;
    line-height: 1.75;
  }

  .recipes-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem 2rem;
  }

  .more-recipes .recipes-grid :global(article.postcard .postcard-meta) {
    font-size: 0.875rem;
    line-height: 1.5;
    letter-spacing: 0;
    text-transform: none;
  }

  .more-recipes .recipes-grid :global(article.postcard .postcard-description) {
    display: block;
    font-size: 1rem;
    line-height: 1.75;
    overflow: visible;
    -webkit-line-clamp: unset;
  }

  .recipes-browse {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    margin-top: 2rem;
    padding-block: 0.5rem;
    color: rgb(var(--color-accent));
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.5;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .recipes-heading + .recipes-browse {
    margin-top: 0;
  }

  .recipes-browse:hover {
    color: rgb(var(--color-accent-hover));
  }

  .recipes-browse:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 4px;
  }

  @media (min-width: 768px) {
    .recipes-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
