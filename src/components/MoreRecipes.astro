---
import type { CollectionEntry } from 'astro:content';
import { findMoreRecipes } from '../utils/recipes';

interface Props {
  currentPost?: CollectionEntry<'blog'>;
  allPosts?: CollectionEntry<'blog'>[];
}

const { currentPost, allPosts } = Astro.props;

const moreRecipes = currentPost && allPosts ? findMoreRecipes(currentPost, allPosts, 4) : [];
const hasMoreRecipes = moreRecipes.length > 0;
---

<section class="more-recipes mt-10" aria-labelledby="more-recipes-heading">
  <div class="space-y-7">
    <div class="mb-6">
      <h2
        id="more-recipes-heading"
        class="mb-2 text-2xl leading-tight font-bold text-[rgb(var(--color-text))]"
      >
        🍳 More Recipes
      </h2>
      {
        hasMoreRecipes ? (
          <p class="text-body-muted text-base leading-relaxed">
            Other dishes from this kitchen.{' '}
            <a href="/recipes" class="text-[rgb(var(--color-accent))] hover:underline">
              Cookbook
            </a>
          </p>
        ) : (
          <p class="text-body-muted text-base leading-relaxed">
            <a href="/recipes" class="text-[rgb(var(--color-accent))] hover:underline">
              Cookbook
            </a>
          </p>
        )
      }
    </div>

    {
      hasMoreRecipes ? (
        <ol class="post-list motion-stagger space-y-3">
          {moreRecipes.map((post, index) => (
            <li class="post-item">
              <a href={`/p/${post.id}`} class="post-link group" data-post-slug={post.id}>
                <span class="post-number">{index + 1}.</span>
                <div class="post-content">
                  <span class="post-title">{post.data.title}</span>
                  {post.data.description && (
                    <span class="post-description">{post.data.description}</span>
                  )}
                </div>
              </a>
            </li>
          ))}
        </ol>
      ) : (
        <p class="empty-state">No other recipes yet.</p>
      )
    }
  </div>
</section>

<style>
  .more-recipes {
    scroll-margin-top: 2rem;
  }

  .more-recipes h2,
  .more-recipes p {
    margin-top: 0;
  }

  .post-list {
    list-style: none;
    padding: 0;
  }

  .post-item {
    border-radius: 0.5rem;
    transition: all 0.2s ease;
  }

  .post-link {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.75rem;
    border-radius: 0.5rem;
    text-decoration: none;
    color: inherit;
    transition: all 0.2s ease;
  }

  .post-link:hover {
    background-color: rgb(var(--color-bg-alt));
  }

  .post-number {
    font-weight: 600;
    color: rgb(var(--color-primary));
    min-width: 1.5rem;
    font-size: 0.875rem;
  }

  .post-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .post-title {
    font-weight: 600;
    color: rgb(var(--color-text));
    line-height: 1.4;
  }

  .post-description {
    font-size: 0.875rem;
    color: rgb(var(--color-text-muted));
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .empty-state {
    color: rgb(var(--color-text-muted));
    font-style: italic;
    padding: 1.75rem;
    text-align: center;
    margin: 0;
  }

  @media (max-width: 768px) {
    .post-link {
      padding: 0.5rem;
      gap: 0.5rem;
    }

    .post-number {
      min-width: 1.25rem;
      font-size: 0.8rem;
    }

    .post-description {
      -webkit-line-clamp: 1;
    }
  }

  .post-link:focus {
    outline: 2px solid rgb(var(--color-primary));
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .post-link,
    .post-item {
      transition: none !important;
    }
  }
</style>
