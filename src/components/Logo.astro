---
import { SITE_TITLE, SHORT_SITE_TITLE } from '../consts';
import { siteStrings, type SiteLanguage } from '../data/siteStrings';

interface Props {
  /**
   * The size variant of the logo
   */
  size?: 'xs' | 'sm' | 'md' | 'lg' | 'xl';

  /**
   * Additional classes to apply
   */
  class?: string;

  /**
   * Custom icon to use (emoji or text)
   */
  icon?: string;

  /**
   * Whether to show the full title on all screen sizes
   */
  alwaysFull?: boolean;

  /**
   * Whether to show only the icon (no text)
   */
  iconOnly?: boolean;

  /**
   * Whether to use the SVG logo instead of emoji
   */
  useSvg?: boolean;

  /**
   * Whether to show a subtle background on hover
   */
  showHoverBg?: boolean;

  /**
   * The page's language, for the link's accessible name
   */
  lang?: SiteLanguage;
}

const {
  size = 'md',
  class: className = '',
  icon = '⚡',
  alwaysFull = false,
  iconOnly = false,
  useSvg = true,
  showHoverBg = false,
  lang = 'en',
} = Astro.props;

const sizeClasses = {
  xs: 'text-sm sm:text-base',
  sm: 'text-base sm:text-lg',
  md: 'text-lg sm:text-xl',
  lg: 'text-xl sm:text-2xl',
  xl: 'text-2xl sm:text-3xl',
};

const iconSizeClasses = {
  xs: 'text-base',
  sm: 'text-lg',
  md: 'text-xl',
  lg: 'text-2xl',
  xl: 'text-3xl',
};

const paddingClasses = {
  xs: 'p-1',
  sm: 'p-2',
  md: 'p-2',
  lg: 'p-3',
  xl: 'p-3',
};
---

<a
  href="/"
  class:list={[
    'group font-heading inline-flex items-center gap-3 rounded-lg font-bold tracking-tight text-[rgb(var(--color-text))] transition-colors duration-200 ease-out hover:text-[rgb(var(--color-accent))] focus:ring-2 focus:ring-[rgb(var(--color-accent))] focus:ring-offset-2 focus:ring-offset-[rgb(var(--color-bg))] focus:outline-hidden',
    showHoverBg && 'hover:bg-[rgb(var(--color-bg-alt))]',
    showHoverBg && paddingClasses[size],
    sizeClasses[size],
    className,
  ]}
  aria-label={`${SITE_TITLE} - ${siteStrings(lang).home}`}
>
  <!-- Icon Section -->
  <span
    class:list={[
      'text-[rgb(var(--color-accent))]',
      iconSizeClasses[size],
      useSvg && 'flex items-center justify-center',
    ]}
    aria-hidden="true"
  >
    {useSvg ? (
      <svg
        width="1em"
        height="1em"
        viewBox="0 0 100 100"
        xmlns="http://www.w3.org/2000/svg"
        class="logo-mark fill-current"
        data-logo-mark
      >
        <polygon
          points="50,0 100,50 50,100 0,50"
          fill="none"
          stroke="currentColor"
          stroke-width="5"
        />
        <line x1="0" y1="50" x2="100" y2="50" stroke="currentColor" stroke-width="5" />
      </svg>
    ) : (
      icon
    )}
  </span>

  <!-- Text Section -->
  {!iconOnly && (
    <span class="flex flex-col">
      {alwaysFull ? (
        <span class="leading-tight">{SITE_TITLE}</span>
      ) : (
        <>
          <span class="leading-tight lg:hidden">{SHORT_SITE_TITLE}</span>
          <span class="hidden leading-tight lg:inline">{SITE_TITLE}</span>
        </>
      )}
    </span>
  )}
</a>

<script>
  import { initLogoJiggle } from '../utils/logoJiggle.client';

  initLogoJiggle();
</script>

<style>
  /* The diamond spins and squashes around its own center (see logoJiggle.client.ts). */
  .logo-mark {
    overflow: visible;
    transform-origin: 50% 50%;
  }

  /* Respect reduced motion preferences */
  @media (prefers-reduced-motion: reduce) {
    a {
      transition: none !important;
    }
    span {
      transition: none !important;
    }
    .group:hover {
      transform: none !important;
    }
    .group:hover span {
      transform: none !important;
    }
    .logo-mark {
      transform: none !important;
    }
  }

  /* Focus styles for better accessibility */
  a:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 2px;
  }
</style>
