---
export interface Props {
  images: {
    src: string;
    alt: string;
    caption?: string;
  }[];
  autoRotate?: boolean;
  rotationSpeed?: number; // in milliseconds
  showNavigation?: boolean;
  showThumbnails?: boolean;
  className?: string;
  /** 'contain' shows each image whole (letterboxed) instead of cropping it to fill. */
  fit?: 'cover' | 'contain';
  /** CSS aspect-ratio of the stage, e.g. '5 / 3'. */
  aspectRatio?: string;
  /** 'below' moves captions under the stage so they never cover the image. */
  captionPosition?: 'overlay' | 'below';
}

const {
  images,
  autoRotate = true,
  rotationSpeed = 5000,
  showNavigation = true,
  showThumbnails = true,
  className = '',
  fit = 'cover',
  aspectRatio = '16 / 9',
  captionPosition = 'overlay',
} = Astro.props;

if (!images || images.length === 0) {
  return null;
}

const canAutoRotate = autoRotate && images.length > 1;
const captionsBelow = captionPosition === 'below';
---

<div
  class={`image-rotator ${fit === 'contain' ? 'fit-contain' : ''} ${className}`}
  data-auto-rotate={autoRotate}
  data-rotation-speed={rotationSpeed}
>
  <div class="rotator-container">
    <!-- Main image display -->
    <div class="main-image-container" style={`aspect-ratio: ${aspectRatio}`}>
      {images.map((image, index) => (
        <div
          class={`main-image ${index === 0 ? 'active' : ''}`}
          data-index={index}
          data-src={image.src}
          data-caption={image.caption}
          data-alt={image.alt}
          role="img"
          aria-label={image.alt}
          aria-hidden={index === 0 ? 'false' : 'true'}
          style={index === 0 ? `background-image: url(${JSON.stringify(image.src)})` : undefined}
        >
          {!captionsBelow && (
            <div class="image-overlay">
              {image.caption && (
                <div class="image-caption">
                  <p>{image.caption}</p>
                </div>
              )}
            </div>
          )}
        </div>
      ))}

      <!-- Clicking the stage opens the full-size view. It sits under the arrows and
           other controls, so those keep working. Hidden until the script runs. -->
      <button class="rotator-zoom" type="button" aria-haspopup="dialog" hidden>
        <span class="sr-only">View image full size</span>
      </button>

      <!-- Navigation arrows -->
      {showNavigation && images.length > 1 && (
        <>
          <button class="nav-arrow nav-prev" aria-label="Previous image">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="15,18 9,12 15,6" />
            </svg>
          </button>
          <button class="nav-arrow nav-next" aria-label="Next image">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="9,18 15,12 9,6" />
            </svg>
          </button>
        </>
      )}

      <!-- Image counter -->
      {images.length > 1 && (
        <div class="image-counter">
          <span class="current-index">1</span>
          <span class="separator">/</span>
          <span class="total-count">{images.length}</span>
        </div>
      )}

      <!-- Autoplay control. Hidden until the script takes over so readers without
           JavaScript never see a dead button. The script also sets the label to
           match the state rotation actually starts in. -->
      {canAutoRotate && (
        <button class="rotator-playback" type="button" data-playing="true" hidden>
          <svg
            class="rotator-icon rotator-icon-pause"
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <rect x="6" y="5" width="4" height="14" rx="1" />
            <rect x="14" y="5" width="4" height="14" rx="1" />
          </svg>
          <svg
            class="rotator-icon rotator-icon-play"
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <polygon points="7,4 20,12 7,20" />
          </svg>
          <span class="rotator-playback-label">Pause slideshow</span>
        </button>
      )}
    </div>

    {captionsBelow && images[0].caption && (
      <p class="rotator-caption-below" aria-live="polite">
        {images[0].caption}
      </p>
    )}

    <!-- Thumbnail navigation -->
    {showThumbnails && images.length > 1 && (
      <div class="thumbnail-container">
        {images.map((image, index) => (
          <button
            class={`thumbnail ${index === 0 ? 'active' : ''}`}
            data-index={index}
            aria-label={image.alt}
            aria-current={index === 0 ? 'true' : undefined}
          >
            {index === 0 ? (
              <img src={image.src} data-src={image.src} alt="" loading="lazy" decoding="async" />
            ) : (
              <img data-src={image.src} alt="" loading="lazy" decoding="async" />
            )}
          </button>
        ))}
      </div>
    )}
  </div>

  <!-- Full-size view. A native modal dialog keeps focus inside, closes on Esc,
       and makes the rest of the page inert while it is open. -->
  <dialog class="rotator-lightbox" aria-label="Full size image">
    <div class="lightbox-stage">
      <figure class="lightbox-figure">
        <img class="lightbox-image" alt="" decoding="async" />
        <figcaption class="lightbox-caption"></figcaption>
      </figure>
    </div>
    <button class="lightbox-btn lightbox-close" type="button" aria-label="Close full size view">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <line x1="6" y1="6" x2="18" y2="18" />
        <line x1="18" y1="6" x2="6" y2="18" />
      </svg>
    </button>
    {images.length > 1 && (
      <>
        <button class="lightbox-btn lightbox-prev" type="button" aria-label="Previous image">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <polyline points="15,18 9,12 15,6" />
          </svg>
        </button>
        <button class="lightbox-btn lightbox-next" type="button" aria-label="Next image">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <polyline points="9,18 15,12 9,6" />
          </svg>
        </button>
        <p class="lightbox-counter" aria-live="polite"></p>
      </>
    )}
  </dialog>
</div>

<style>
  @reference '../styles/global.css';

  .image-rotator {
    @apply mx-auto my-8 w-full max-w-4xl;
  }

  .rotator-container {
    @apply relative;
  }

  .main-image-container {
    @apply relative overflow-hidden rounded-lg bg-gray-100 dark:bg-gray-800;
  }

  .fit-contain .main-image-container {
    background-color: #111;
  }

  .fit-contain .main-image {
    background-size: contain;
  }

  .rotator-caption-below {
    @apply mt-3 mb-0 text-sm italic opacity-80;
  }

  .main-image {
    @apply absolute inset-0 bg-cover bg-center bg-no-repeat opacity-0 transition-opacity duration-500;
  }

  .main-image.active {
    @apply opacity-100;
  }

  .image-overlay {
    @apply absolute right-0 bottom-0 left-0 bg-linear-to-t from-black/70 via-black/30 to-transparent p-4;
  }

  .image-caption {
    @apply text-sm text-white;
  }

  .image-caption p {
    @apply m-0;
  }

  .nav-arrow {
    @apply absolute top-1/2 -translate-y-1/2 rounded-full bg-white/80 p-2 text-gray-800 shadow-lg transition-all duration-200 hover:scale-110 hover:bg-white dark:bg-gray-800/80 dark:text-gray-200 dark:hover:bg-gray-700;
  }

  .nav-prev {
    @apply left-4;
  }

  .nav-next {
    @apply right-4;
  }

  .image-counter {
    @apply absolute top-4 right-4 rounded-full bg-black/50 px-3 py-1 text-sm font-medium text-white;
  }

  .rotator-playback {
    @apply absolute top-4 left-4 flex items-center justify-center rounded-full bg-black/50 p-2 text-white transition-colors duration-200 hover:bg-black/70;
    min-height: 44px;
    min-width: 44px;
  }

  /* The display utility above would otherwise beat the UA rule for [hidden]. */
  .rotator-playback[hidden] {
    display: none;
  }

  .rotator-playback:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 2px;
  }

  .rotator-playback-label {
    @apply sr-only;
  }

  .rotator-playback[data-playing='true'] .rotator-icon-play,
  .rotator-playback[data-playing='false'] .rotator-icon-pause {
    display: none;
  }

  .thumbnail-container {
    @apply mt-4 flex gap-2 overflow-x-auto pb-2;
  }

  .thumbnail-container .thumbnail:first-child {
    @apply ml-0;
  }

  .thumbnail-container .thumbnail:last-child {
    @apply mr-0;
  }

  .thumbnail {
    @apply m-0 h-16 w-20 flex-shrink-0 overflow-hidden rounded-lg border-2 border-transparent p-0 transition-all duration-200 hover:border-blue-500;
  }

  .thumbnail.active {
    @apply border-blue-500;
  }

  .thumbnail img {
    @apply m-0 h-full w-full object-contain p-0;
  }

  .rotator-zoom {
    @apply absolute inset-0 m-0 h-full w-full border-0 bg-transparent p-0;
    cursor: zoom-in;
  }

  .rotator-zoom[hidden] {
    display: none;
  }

  .rotator-zoom:focus-visible {
    outline: 3px solid rgb(var(--color-accent));
    outline-offset: -3px;
  }

  /* Full-size view */
  .rotator-lightbox {
    @apply m-0 border-0 p-0 text-white;
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    background: rgb(0 0 0 / 0.94);
  }

  .rotator-lightbox::backdrop {
    background: rgb(0 0 0 / 0.94);
  }

  .lightbox-stage {
    @apply flex h-full w-full items-center justify-center;
    cursor: zoom-out;
  }

  .lightbox-figure {
    @apply m-0 flex max-h-full w-full flex-col items-center;
  }

  /* As wide as the screen, unless that would make it taller than the screen. */
  .lightbox-image {
    @apply m-0 block w-full p-0;
    height: auto;
    max-height: calc(100dvh - 5rem);
    object-fit: contain;
    cursor: default;
  }

  /* Prose styles color figcaptions and paragraphs for the page; the overlay is always dark. */
  .rotator-lightbox .lightbox-caption {
    @apply mx-auto mt-3 mb-0 max-w-3xl px-16 text-center text-sm;
    color: rgb(255 255 255 / 0.85);
  }

  .lightbox-caption:empty {
    display: none;
  }

  .lightbox-btn {
    @apply absolute flex items-center justify-center rounded-full bg-black/60 text-white transition-colors duration-200 hover:bg-black/85;
    min-height: 44px;
    min-width: 44px;
  }

  .lightbox-btn:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  .lightbox-close {
    @apply top-4 right-4;
  }

  .lightbox-prev,
  .lightbox-next {
    @apply top-1/2 -translate-y-1/2;
  }

  .lightbox-prev {
    @apply left-4;
  }

  .lightbox-next {
    @apply right-4;
  }

  .rotator-lightbox .lightbox-counter {
    @apply absolute top-4 left-4 m-0 rounded-full bg-black/60 px-3 py-1 text-sm font-medium;
    color: #fff;
  }

  @media (prefers-reduced-motion: no-preference) {
    .rotator-lightbox[open] {
      animation: lightbox-in 180ms ease-out;
    }
  }

  @keyframes lightbox-in {
    from {
      opacity: 0;
    }
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    .nav-arrow {
      @apply p-2;
    }

    .nav-arrow svg {
      @apply h-5 w-5;
    }

    .thumbnail {
      @apply m-0 h-12 w-16 p-0;
    }

    .thumbnail img {
      @apply m-0 h-full w-full object-contain p-0;
    }
  }
</style>

<script>
  class ImageRotator {
    private container: HTMLElement;
    private images: Element[];
    private thumbnails: Element[];
    private currentIndex: number;
    private autoRotate: boolean;
    private rotationSpeed: number;
    private rotationInterval: number | null;
    private playbackBtn: HTMLButtonElement | null;
    private reducedMotion: MediaQueryList;
    // The reader's explicit choice. Nothing but the playback button changes it,
    // so moving the pointer away never resumes a slideshow they paused.
    private userPaused = false;
    // Transient reasons to hold: pointer over the rotator, keyboard focus inside
    // it, or a backgrounded tab.
    private hovered = false;
    private focused = false;
    private lightboxOpen = false;
    private lightbox: HTMLDialogElement | null;
    private lightboxImg: HTMLImageElement | null;

    constructor(container: HTMLElement) {
      this.container = container;
      this.images = Array.from(container.querySelectorAll('.main-image'));
      this.thumbnails = Array.from(container.querySelectorAll('.thumbnail'));
      this.currentIndex = 0;
      this.autoRotate = container.dataset.autoRotate === 'true';
      this.rotationSpeed = parseInt(container.dataset.rotationSpeed || '5000');
      this.rotationInterval = null;
      this.playbackBtn = container.querySelector('.rotator-playback');
      this.reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      this.lightbox = container.querySelector('.rotator-lightbox');
      this.lightboxImg = container.querySelector('.lightbox-image');

      this.init();
    }

    private init(): void {
      this.setupNavigation();
      this.setupThumbnails();
      this.setupThumbnailObserver();
      this.setupAutoRotation();
      this.setupLightbox();
      this.updateDisplay();
    }

    private setupLightbox(): void {
      const dialog = this.lightbox;
      const zoom = this.container.querySelector<HTMLButtonElement>('.rotator-zoom');
      if (!dialog || !zoom || typeof dialog.showModal !== 'function') return;

      zoom.hidden = false;
      zoom.addEventListener('click', () => this.openLightbox());

      dialog.querySelector('.lightbox-close')?.addEventListener('click', () => dialog.close());
      dialog.querySelector('.lightbox-prev')?.addEventListener('click', () => this.previous());
      dialog.querySelector('.lightbox-next')?.addEventListener('click', () => this.next());

      // A click on the dark area around the image closes; clicks on the image,
      // the caption or the controls do not.
      dialog.addEventListener('click', (event) => {
        const target = event.target;
        if (
          target === dialog ||
          (target instanceof Element && target.classList.contains('lightbox-stage'))
        ) {
          dialog.close();
        }
      });

      dialog.addEventListener('keydown', (event) => {
        if (this.images.length < 2) return;
        if (event.key === 'ArrowRight') {
          event.preventDefault();
          this.next();
        } else if (event.key === 'ArrowLeft') {
          event.preventDefault();
          this.previous();
        }
      });

      // Horizontal swipe moves between slides.
      let startX = 0;
      let startY = 0;
      dialog.addEventListener(
        'touchstart',
        (event) => {
          startX = event.touches[0].clientX;
          startY = event.touches[0].clientY;
        },
        { passive: true },
      );
      dialog.addEventListener('touchend', (event) => {
        if (this.images.length < 2) return;
        const dx = event.changedTouches[0].clientX - startX;
        const dy = event.changedTouches[0].clientY - startY;
        if (Math.abs(dx) < 50 || Math.abs(dx) < Math.abs(dy)) return;
        if (dx < 0) this.next();
        else this.previous();
      });

      dialog.addEventListener('close', () => {
        this.lightboxOpen = false;
        document.documentElement.style.removeProperty('overflow');
        // Browsers restore focus on close, but not all of them do it reliably.
        zoom.focus({ preventScroll: true });
        this.syncRotation();
      });
    }

    private openLightbox(): void {
      if (!this.lightbox) return;
      this.lightboxOpen = true;
      this.syncRotation();
      this.updateLightbox();
      document.documentElement.style.overflow = 'hidden';
      this.lightbox.showModal();
      // Start on the close button so Enter or Space never reopens by accident.
      this.lightbox.querySelector<HTMLButtonElement>('.lightbox-close')?.focus();
    }

    private updateLightbox(): void {
      const slide = this.images[this.currentIndex];
      if (!this.lightbox || !this.lightboxImg || !(slide instanceof HTMLElement)) return;
      const src = slide.dataset.src ?? '';
      if (this.lightboxImg.getAttribute('src') !== src) this.lightboxImg.src = src;
      this.lightboxImg.alt = slide.dataset.alt ?? '';
      const caption = this.lightbox.querySelector('.lightbox-caption');
      if (caption) caption.textContent = slide.dataset.caption ?? '';
      const counter = this.lightbox.querySelector('.lightbox-counter');
      if (counter) counter.textContent = `${this.currentIndex + 1} / ${this.images.length}`;
    }

    /** CSS backgrounds cannot be lazy-loaded, so only current ± 1 get a url. */
    private ensureSlideLoaded(index: number): void {
      const image = this.images[index];
      if (!(image instanceof HTMLElement)) return;
      if (image.style.backgroundImage) return;
      const src = image.dataset.src;
      if (!src) return;
      image.style.backgroundImage = `url(${JSON.stringify(src)})`;
    }

    private setupThumbnailObserver(): void {
      const thumbs = this.container.querySelectorAll<HTMLImageElement>('.thumbnail img[data-src]');
      if (!thumbs.length) return;

      const loadThumb = (img: HTMLImageElement) => {
        const src = img.dataset.src;
        if (!src || img.getAttribute('src') === src) return;
        img.src = src;
      };

      const scroller = this.container.querySelector('.thumbnail-container');
      if (!('IntersectionObserver' in window) || !(scroller instanceof HTMLElement)) {
        thumbs.forEach(loadThumb);
        return;
      }

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            if (entry.target instanceof HTMLImageElement) loadThumb(entry.target);
            observer.unobserve(entry.target);
          }
        },
        { root: scroller, rootMargin: '80px' },
      );
      thumbs.forEach((img) => observer.observe(img));
    }

    private setupNavigation(): void {
      const prevBtn = this.container.querySelector('.nav-prev');
      const nextBtn = this.container.querySelector('.nav-next');

      if (prevBtn) {
        prevBtn.addEventListener('click', () => this.previous());
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', () => this.next());
      }
    }

    private setupThumbnails(): void {
      this.thumbnails.forEach((thumbnail: Element, index: number) => {
        thumbnail.addEventListener('click', () => this.goTo(index));
      });
    }

    private setupAutoRotation(): void {
      if (!this.autoRotate || this.images.length <= 1) return;

      // Readers who ask for reduced motion start paused rather than losing the
      // control entirely; they can still opt in.
      this.userPaused = this.reducedMotion.matches;

      this.container.addEventListener('mouseenter', () => {
        this.hovered = true;
        this.syncRotation();
      });
      this.container.addEventListener('mouseleave', () => {
        this.hovered = false;
        this.syncRotation();
      });
      // Focus inside the rotator holds rotation so a keyboard reader is not
      // moved out from under themselves. The playback control is excluded, or
      // pressing Play would be cancelled by the focus it just received.
      const holdsFocus = (node: EventTarget | null): boolean =>
        node instanceof Node && this.container.contains(node) && node !== this.playbackBtn;

      this.container.addEventListener('focusin', (event) => {
        this.focused = holdsFocus(event.target);
        this.syncRotation();
      });
      this.container.addEventListener('focusout', (event) => {
        this.focused = holdsFocus((event as FocusEvent).relatedTarget);
        this.syncRotation();
      });
      document.addEventListener('visibilitychange', () => this.syncRotation());
      this.reducedMotion.addEventListener('change', (event) => {
        // A reader turning the preference on mid-visit should stop advancing.
        if (event.matches) this.userPaused = true;
        this.syncRotation();
      });

      if (this.playbackBtn) {
        this.playbackBtn.hidden = false;
        this.playbackBtn.addEventListener('click', () => {
          this.userPaused = !this.userPaused;
          this.syncRotation();
        });
      }

      this.syncRotation();
    }

    private shouldRotate(): boolean {
      if (!this.autoRotate || this.images.length <= 1) return false;
      return (
        !this.userPaused && !this.hovered && !this.focused && !this.lightboxOpen && !document.hidden
      );
    }

    private syncRotation(): void {
      if (this.shouldRotate()) this.startAutoRotation();
      else this.stopAutoRotation();
      this.updatePlaybackControl();
    }

    // The button reports the reader's own choice, not the transient hover/focus
    // holds, so hovering never makes the label flicker to "Play".
    private updatePlaybackControl(): void {
      if (!this.playbackBtn) return;
      const playing = !this.userPaused;
      this.playbackBtn.dataset.playing = playing ? 'true' : 'false';
      const label = this.playbackBtn.querySelector('.rotator-playback-label');
      if (label) label.textContent = playing ? 'Pause slideshow' : 'Play slideshow';
    }

    private startAutoRotation(): void {
      if (this.rotationInterval) return;

      this.rotationInterval = window.setInterval(() => {
        this.next();
      }, this.rotationSpeed);
    }

    private stopAutoRotation(): void {
      if (this.rotationInterval) {
        clearInterval(this.rotationInterval);
        this.rotationInterval = null;
      }
    }

    private goTo(index: number): void {
      if (index < 0 || index >= this.images.length) return;

      this.currentIndex = index;
      this.updateDisplay();
    }

    private next(): void {
      this.currentIndex = (this.currentIndex + 1) % this.images.length;
      this.updateDisplay();
    }

    private previous(): void {
      this.currentIndex = this.currentIndex === 0 ? this.images.length - 1 : this.currentIndex - 1;
      this.updateDisplay();
    }

    private updateDisplay(): void {
      const last = this.images.length;
      this.ensureSlideLoaded(this.currentIndex);
      if (last > 1) {
        this.ensureSlideLoaded((this.currentIndex + 1) % last);
        this.ensureSlideLoaded((this.currentIndex - 1 + last) % last);
      }

      // Update main images
      this.images.forEach((image: Element, index: number) => {
        const isActive = index === this.currentIndex;
        image.classList.toggle('active', isActive);
        image.setAttribute('aria-hidden', isActive ? 'false' : 'true');
      });

      // Update thumbnails
      this.thumbnails.forEach((thumbnail: Element, index: number) => {
        const isActive = index === this.currentIndex;
        thumbnail.classList.toggle('active', isActive);
        if (isActive) {
          thumbnail.setAttribute('aria-current', 'true');
        } else {
          thumbnail.removeAttribute('aria-current');
        }
      });

      // Update the caption shown under the stage
      const captionBelow = this.container.querySelector('.rotator-caption-below');
      const activeImage = this.images[this.currentIndex];
      if (captionBelow && activeImage instanceof HTMLElement) {
        captionBelow.textContent = activeImage.dataset.caption ?? '';
      }

      // Update counter
      const counter = this.container.querySelector('.image-counter');
      if (counter) {
        const currentIndexEl = counter.querySelector('.current-index');
        if (currentIndexEl) {
          currentIndexEl.textContent = String(this.currentIndex + 1);
        }
      }

      if (this.lightboxOpen) this.updateLightbox();
    }
  }

  // Initialize all image rotators on the page
  function initializeRotators() {
    const rotators = document.querySelectorAll('.image-rotator');
    rotators.forEach((rotator) => new ImageRotator(rotator as HTMLElement));
  }
  if (document.readyState === 'loading')
    document.addEventListener('DOMContentLoaded', initializeRotators, { once: true });
  else initializeRotators();
</script>
