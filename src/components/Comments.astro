---
import { commentsConfig } from '../config/comments';
import { generateCanonicalUrl } from '../utils/seo';

interface Props {
  language?: 'en' | 'es';
}

const { language = 'en' } = Astro.props;
const pageUrl = generateCanonicalUrl(Astro.url.pathname);
const { host, siteId } = commentsConfig;
const copy =
  language === 'es'
    ? {
        heading: 'Deje una nota',
        invitation: 'Puede compartir una reflexión o hacer una pregunta en los comentarios.',
        email: 'Si prefiere escribir en privado, puede enviarme un correo a',
        subject: 'Sobre su escrito',
        idle: 'Los comentarios se cargarán al llegar a esta sección.',
        loading: 'Cargando los comentarios…',
        failed:
          'No se pudo abrir el espacio de comentarios. Puede intentarlo de nuevo o escribirme por correo.',
        load: 'Cargar comentarios',
        retry: 'Intentar de nuevo',
        reload: 'Volver a cargar los comentarios',
        noScript:
          'Los comentarios necesitan JavaScript. También puede escribirme por correo mediante el enlace de arriba.',
      }
    : {
        heading: 'Leave a note',
        invitation: 'Share a thought or ask a question in the comments.',
        email: 'For a private note, you can email me at',
        subject: 'About your writing',
        idle: 'Comments will load when you reach this section.',
        loading: 'Loading comments…',
        failed: 'The comment box could not be opened. You can try again or write to me by email.',
        load: 'Load comments',
        retry: 'Try again',
        reload: 'Reload comments',
        noScript: 'Comments need JavaScript. You can also write to me using the email link above.',
      };
const email = 'antonio@builds.software';
const emailUrl = `mailto:${email}?subject=${encodeURIComponent(copy.subject)}&body=${encodeURIComponent(pageUrl)}`;
---

<section id="comments" class="comments-section" aria-labelledby="comments-heading" lang={language}>
  <header class="comments-introduction">
    <h2 id="comments-heading">{copy.heading}</h2>
    <p>{copy.invitation}</p>
    <p>{copy.email} <a href={emailUrl}>{email}</a>.</p>
  </header>
  <div
    id="comments-container"
    class="remark42-container"
    data-host={host}
    data-site-id={siteId}
    data-page-url={pageUrl}
    data-language={language}
    data-loading={copy.loading}
    data-failed={copy.failed}
    data-retry={copy.retry}
    data-reload={copy.reload}
  >
    <div class="comments-feedback" data-comments-feedback hidden>
      <p role="status" aria-live="polite" aria-atomic="true" data-comments-status>{copy.idle}</p>
      <button type="button" data-comments-retry aria-controls="remark42">{copy.load}</button>
    </div>
    <div id="remark42"></div>
    <noscript><p class="comments-noscript">{copy.noScript}</p></noscript>
  </div>
</section>

<script>
  import type { Remark42Instance } from '../types/comments';
  import {
    buildRemark42Config,
    createRemark42Instance,
    loadRemark42Script,
    waitForRemark42Frame,
  } from '../utils/remark42.client';
  import { THEME_CHANGE_EVENT } from '../utils/themeEvents';

  let activeContainer: HTMLElement | null = null;
  let dispose: (() => void) | null = null;

  function clearComments() {
    dispose?.();
    dispose = null;
    activeContainer = null;
  }

  function initComments() {
    const container = document.getElementById('comments-container');
    if (container && container === activeContainer) return;
    clearComments();
    if (!container) return;
    const node = container.querySelector<HTMLElement>('#remark42');
    const feedback = container.querySelector<HTMLElement>('[data-comments-feedback]');
    const status = container.querySelector<HTMLElement>('[data-comments-status]');
    const retry = container.querySelector<HTMLButtonElement>('[data-comments-retry]');
    const { host, siteId, pageUrl, language } = container.dataset;
    if (!node || !feedback || !status || !retry || !host || !siteId || !pageUrl) return;
    activeContainer = container;
    feedback.hidden = false;
    // An earlier page's slow embed download can finish after navigation.
    window.remark_config = buildRemark42Config(
      host,
      siteId,
      pageUrl,
      language === 'es' ? 'es' : 'en',
    );

    let instance: Remark42Instance | null = null;
    let request: AbortController | null = null;
    let observer: IntersectionObserver | null = null;
    let loading = false;

    function destroyInstance() {
      if (instance) {
        try {
          instance.destroy();
        } catch {
          // The embed may already have removed its frame during navigation.
        }
        instance = null;
      }
    }

    async function loadComments() {
      if (loading) return;
      loading = true;
      observer?.disconnect();
      request?.abort();
      request = new AbortController();
      const { signal } = request;
      destroyInstance();
      status!.hidden = false;
      status!.textContent = container!.dataset.loading ?? '';
      retry!.disabled = true;
      node!.setAttribute('aria-busy', 'true');
      const locale = language === 'es' ? 'es' : 'en';

      try {
        await loadRemark42Script(buildRemark42Config(host!, siteId!, pageUrl!, locale), { signal });
        if (signal.aborted || !container!.isConnected) return;
        instance = createRemark42Instance(node!, host!, siteId!, pageUrl!, locale);
        await waitForRemark42Frame(node!, host!, { signal });
        if (signal.aborted) return;
        // The widget owns thread-fetch errors. Its initialization signal only
        // confirms the comment box booted, not that comments were retrieved.
        status!.hidden = true;
        retry!.textContent = container!.dataset.reload ?? '';
      } catch {
        if (signal.aborted) return;
        destroyInstance();
        status!.hidden = false;
        status!.textContent = container!.dataset.failed ?? '';
        retry!.textContent = container!.dataset.retry ?? '';
      } finally {
        if (!signal.aborted) {
          loading = false;
          retry!.disabled = false;
          node!.removeAttribute('aria-busy');
        }
      }
    }

    retry.addEventListener('click', loadComments);
    dispose = () => {
      request?.abort();
      observer?.disconnect();
      retry.removeEventListener('click', loadComments);
      destroyInstance();
    };

    if ('IntersectionObserver' in window) {
      observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) void loadComments();
        },
        { rootMargin: '200px' },
      );
      observer.observe(container);
    } else {
      void loadComments();
    }
  }

  function updateTheme() {
    const theme = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
    try {
      window.REMARK42?.changeTheme?.(theme);
    } catch {
      // Theme changes can arrive before the iframe finishes initializing.
    }
  }

  const win = window as Window & { __commentsListenersInstalled?: boolean };
  if (!win.__commentsListenersInstalled) {
    win.__commentsListenersInstalled = true;
    window.addEventListener(THEME_CHANGE_EVENT, updateTheme);
    new MutationObserver(updateTheme).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['class'],
    });
    document.addEventListener('astro:before-swap', clearComments);
    document.addEventListener('astro:page-load', initComments);
    window.addEventListener('pagehide', clearComments);
    window.addEventListener('pageshow', initComments);
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initComments, { once: true });
  } else {
    initComments();
  }
</script>

<style>
  .comments-section {
    scroll-margin-top: calc(var(--site-header-height) + 2rem);
  }
  .comments-introduction {
    display: grid;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .comments-introduction h2 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 2.4vw, 2rem);
    font-weight: 600;
    line-height: 1.2;
  }
  .comments-introduction p,
  .comments-noscript {
    max-width: 62ch;
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.75;
  }
  .comments-introduction a {
    color: rgb(var(--color-accent));
    text-decoration: underline;
    text-underline-offset: 0.2em;
    overflow-wrap: anywhere;
  }
  .comments-feedback {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-bottom: 1rem;
  }
  .comments-feedback p {
    max-width: 62ch;
    margin: 0;
    color: rgb(var(--color-text-muted));
    font-size: 1rem;
    line-height: 1.6;
  }
  .comments-feedback button {
    min-height: 44px;
    padding: 0.5rem 0;
    border: 0;
    background: transparent;
    color: rgb(var(--color-accent));
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.5;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }
  .comments-feedback button:disabled {
    color: rgb(var(--color-text-muted));
    cursor: wait;
  }
  .comments-section :is(a, button):focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 4px;
  }
  .comments-section [hidden] {
    display: none !important;
  }
  :global(#remark42) {
    min-width: 0;
  }
  :global(.dark #remark42) {
    color-scheme: dark;
  }
</style>
