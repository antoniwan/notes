---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import DefaultImage from './DefaultImage.astro';
import { calculateReadingTimeFromMarkdown } from '../utils/readingTime';

interface Props {
  post: CollectionEntry<'blog'>;
  featured?: boolean;
  compact?: boolean;
  showFeaturedIndicator?: boolean;
}

const { post, featured = false, compact = false, showFeaturedIndicator = true } = Astro.props;
const { data } = post;

const readingTime = calculateReadingTimeFromMarkdown(post.body || '');
---

<article
  class="interactive-card postcard group relative overflow-hidden"
  class:list={{
    'featured-card': featured,
    'compact-card': compact,
  }}
  role="article"
  data-post-slug={post.id}
>
  <div class="read-indicator" data-post-slug={post.id}>
    <span class="read-dot"></span>
  </div>

  <div class="image-container relative overflow-hidden">
    {
      data.heroImage ? (
        <img
          src={data.heroImage}
          alt={data.imageAlt || data.title}
          class="postcard-image"
          loading="lazy"
        />
      ) : (
        <DefaultImage
          alt={data.title}
          className="postcard-image"
          loading="lazy"
        />
      )
    }
  </div>

  <div class="postcard-body">
    <div class="postcard-meta">
      <FormattedDate date={data.pubDate} class="postcard-meta__item" />
      {
        readingTime && (
          <>
            <span class="postcard-meta__sep" aria-hidden="true">
              ·
            </span>
            <span
              class="postcard-meta__item reading-time-display"
              data-post-slug={post.id}
              data-original-reading-time={readingTime}
            >
              {readingTime}
            </span>
          </>
        )
      }
      {
        featured && showFeaturedIndicator && (
          <>
            <span class="postcard-meta__sep" aria-hidden="true">
              ·
            </span>
            <span
              class="postcard-meta__item postcard-meta__featured"
              role="img"
              aria-label="Featured post"
            >
              Featured
            </span>
          </>
        )
      }
    </div>

    <h2 id={`postcard-title-${post.id}`} class="postcard-title">
      <a href={`/p/${post.id}`} class="postcard-link">{data.title}</a>
    </h2>

    {
      data.description && (
        <p class="postcard-description">{data.description}</p>
      )
    }
  </div>
</article>

<script>
  const readStateService = (window as any).ReadStateService?.getInstance();

  function updateIndicators() {
    if (!readStateService) return;

    document.querySelectorAll('.read-indicator').forEach((indicator) => {
      const postSlug = (indicator as HTMLElement).dataset.postSlug;
      const dot = indicator.querySelector('.read-dot');

      if (!postSlug || !dot) return;

      const isRead = readStateService.isRead(postSlug);
      const readingTimeElement = document.querySelector(
        `.reading-time-display[data-post-slug="${postSlug}"]`,
      ) as HTMLElement | null;
      const readingTimeSep = readingTimeElement?.previousElementSibling as HTMLElement | null;

      if (isRead) {
        dot.classList.add('read');
        indicator.setAttribute('title', 'Read');

        if (readingTimeElement) {
          readingTimeElement.textContent = 'Read';
          readingTimeElement.hidden = false;
          if (readingTimeSep?.classList.contains('postcard-meta__sep')) {
            readingTimeSep.hidden = false;
          }
        }
      } else {
        dot.classList.remove('read');
        indicator.setAttribute('title', 'Unread');

        if (readingTimeElement) {
          const originalReadingTime = readingTimeElement.getAttribute(
            'data-original-reading-time',
          );
          if (originalReadingTime) {
            readingTimeElement.textContent = originalReadingTime;
            readingTimeElement.hidden = false;
            if (readingTimeSep?.classList.contains('postcard-meta__sep')) {
              readingTimeSep.hidden = false;
            }
          } else {
            readingTimeElement.hidden = true;
            if (readingTimeSep?.classList.contains('postcard-meta__sep')) {
              readingTimeSep.hidden = true;
            }
          }
        }
      }
    });
  }

  let unsubscribe: (() => void) | null = null;
  if (readStateService) {
    unsubscribe = readStateService.subscribeToAll(() => {
      updateIndicators();
    });

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', updateIndicators);
    } else {
      updateIndicators();
    }
  }

  window.addEventListener('beforeunload', () => {
    if (unsubscribe) unsubscribe();
  });
</script>

<style>
  @reference '../styles/global.css';

  .read-indicator {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 10;
    pointer-events: none;
  }

  .read-dot {
    display: block;
    width: 8px;
    height: 8px;
    margin: 0;
    padding: 0;
    border-radius: 50%;
    background: rgb(var(--color-border));
    border: 2px solid rgb(var(--color-bg));
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .read-dot.read {
    background: rgb(var(--color-success));
    border-color: rgb(var(--color-success));
    box-shadow: 0 0 0 2px rgb(var(--color-success) / 0.22);
  }

  /* Prose wrappers fight card typography — scoped resets stay intentional */
  :global(.prose) article.postcard,
  article.postcard {
    position: relative;
    display: block;
    width: 100%;
    max-width: 100%;
    margin: 0;
    box-sizing: border-box;
    overflow: hidden;
    border: 1px solid rgb(var(--color-border) / 0.45);
    border-radius: var(--radius-lg);
    background: rgb(var(--color-bg));
    box-shadow: none;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  :global(.prose) article.postcard :is(h1, h2, h3, h4, h5, h6, p, time, span, a, header),
  article.postcard :is(h1, h2, h3, h4, h5, h6, p, time, span, a, header) {
    margin: 0;
    padding: 0;
  }

  article.postcard .postcard-body {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 1rem 1.1rem 1.15rem;
  }

  @media (min-width: 640px) {
    article.postcard .postcard-body {
      padding: 1.15rem 1.25rem 1.35rem;
      gap: 0.65rem;
    }
  }

  article.postcard .postcard-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 0.45rem;
    row-gap: 0.15rem;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    line-height: 1.4;
    color: rgb(var(--color-text-muted));
    text-transform: uppercase;
  }

  .postcard-meta__item,
  .postcard-meta time {
    display: inline;
    color: rgb(var(--color-text-muted));
    font-size: inherit;
    line-height: inherit;
    white-space: nowrap;
  }

  .postcard-meta__sep {
    display: inline;
    color: rgb(var(--color-text-muted));
    opacity: 0.45;
    user-select: none;
    line-height: inherit;
  }

  .postcard-meta__featured {
    font-weight: 700;
    color: rgb(var(--color-primary));
  }

  article.postcard .postcard-title {
    display: block;
    font-family: var(--font-heading);
    font-size: 1.05rem;
    line-height: 1.3;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: rgb(var(--color-text));
  }

  @media (min-width: 640px) {
    article.postcard .postcard-title {
      font-size: 1.2rem;
    }
  }

  @media (min-width: 768px) {
    article.postcard .postcard-title {
      font-size: 1.28rem;
    }
  }

  article.postcard .postcard-link {
    display: block;
    text-decoration: none;
    color: inherit;
    font-weight: inherit;
  }

  /* Stretch title link across the card for a single hit target */
  article.postcard .postcard-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  article.postcard .postcard-description {
    display: -webkit-box;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    line-height: 1.55;
    color: rgb(var(--color-text-muted));
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  article.postcard .image-container {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    margin: 0;
    padding: 0;
    background: rgb(var(--color-bg-alt));
    overflow: hidden;
  }

  article.postcard.compact-card .image-container {
    aspect-ratio: 16 / 9;
  }

  :global(.prose) article.postcard .image-container img,
  article.postcard .image-container img,
  article.postcard .postcard-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    border: none;
    margin: 0;
    padding: 0;
    max-width: 100%;
    box-shadow: none;
    border-radius: 0;
    transition: transform 0.45s var(--animation-easing-out);
  }

  .featured-card {
    border-color: rgb(var(--color-primary) / 0.55);
    box-shadow: inset 3px 0 0 rgb(var(--color-primary));
  }

  article.postcard.compact-card .postcard-body {
    padding: 0.75rem 0.9rem 0.95rem;
  }

  article.postcard:hover {
    border-color: rgb(var(--color-accent) / 0.35);
    box-shadow: var(--shadow-soft);
  }

  article.postcard:hover .postcard-image {
    transform: scale(1.03);
  }

  article.postcard:focus-within {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 2px;
  }

  :global(.postcards-grid) {
    margin-top: 0;
    margin-bottom: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    article.postcard,
    article.postcard .postcard-image,
    .read-dot {
      transition: none;
    }

    article.postcard:hover .postcard-image {
      transform: none;
    }
  }
</style>
