---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import DefaultImage from './DefaultImage.astro';
import { calculateReadingTimeFromMarkdown } from '../utils/readingTime';
import { getSpanishTwinGroups } from '../utils/translationUtils';
import { isSpanishPrimary } from '../utils/publishFilters';
import { isRecipePost } from '../utils/recipes';

interface Props {
  post: CollectionEntry<'blog'>;
  featured?: boolean;
  compact?: boolean;
  showFeaturedIndicator?: boolean;
  idPrefix?: string;
  imageLoading?: 'eager' | 'lazy';
  headingAs?: 'h2' | 'h3';
}

const {
  post,
  featured = false,
  compact = false,
  showFeaturedIndicator = true,
  idPrefix = 'postcard',
  imageLoading = 'lazy',
  headingAs = 'h2',
} = Astro.props;
const { data } = post;
const Heading = headingAs;

const readingTime = calculateReadingTimeFromMarkdown(post.body || '');
const isRecipe = isRecipePost(post);
const kindLabel = isRecipe ? (isSpanishPrimary(data) ? 'Receta' : 'Recipe') : null;
const spanishTwinGroups = await getSpanishTwinGroups();
const hasSpanishTwin =
  !isSpanishPrimary(data) &&
  Boolean(data.translationGroup) &&
  spanishTwinGroups.has(data.translationGroup ?? '');
---

<article
  class="postcard group relative"
  class:list={{
    'featured-card': featured,
    'compact-card': compact,
  }}
  role="article"
  data-post-slug={post.id}
>
  <div class="read-indicator" data-post-slug={post.id}>
    <span class="read-dot"></span>
  </div>

  <div class="image-container relative overflow-hidden">
    {
      data.heroImage ? (
        <img
          src={data.heroImage}
          alt={data.imageAlt || data.title}
          class="postcard-image"
          loading={imageLoading}
        />
      ) : (
        <DefaultImage
          alt={data.title}
          className="postcard-image"
          loading={imageLoading}
          width={1200}
          height={750}
        />
      )
    }
  </div>

  <div class="postcard-body">
    <div class="postcard-meta">
      <FormattedDate date={data.pubDate} class="postcard-meta__item" />
      {
        kindLabel && (
          <>
            <span class="postcard-meta__sep" aria-hidden="true">
              ·
            </span>
            <span
              class="postcard-meta__item postcard-meta__kind"
              lang={isSpanishPrimary(data) ? 'es' : 'en'}
            >
              {kindLabel}
            </span>
          </>
        )
      }
      {
        readingTime && !isRecipe && (
          <>
            <span class="postcard-meta__sep" aria-hidden="true">
              ·
            </span>
            <span
              class="postcard-meta__item reading-time-display"
              data-post-slug={post.id}
              data-original-reading-time={readingTime}
            >
              {readingTime}
            </span>
          </>
        )
      }
      {
        featured && showFeaturedIndicator && (
          <>
            <span class="postcard-meta__sep" aria-hidden="true">
              ·
            </span>
            <span
              class="postcard-meta__item postcard-meta__featured"
              role="img"
              aria-label="Featured post"
            >
              Featured
            </span>
          </>
        )
      }
      {
        hasSpanishTwin && (
          <>
            <span class="postcard-meta__sep" aria-hidden="true">
              ·
            </span>
            <span
              class="postcard-meta__item postcard-meta__es"
              lang="es"
              aria-label="Also available in Spanish"
            >
              ES
            </span>
          </>
        )
      }
    </div>

    <Heading id={`${idPrefix}-title-${post.id}`} class="postcard-title">
      <a href={`/p/${post.id}`} class="postcard-link">{data.title}</a>
    </Heading>

    {data.description && <p class="postcard-description">{data.description}</p>}
  </div>
</article>

<script>
  const readStateService = (window as any).ReadStateService?.getInstance();

  function updateIndicators() {
    if (!readStateService) return;

    document.querySelectorAll('.read-indicator').forEach((indicator) => {
      const postSlug = (indicator as HTMLElement).dataset.postSlug;
      const dot = indicator.querySelector('.read-dot');

      if (!postSlug || !dot) return;

      const isRead = readStateService.isRead(postSlug);
      const readingTimeElement = indicator
        .closest('article')
        ?.querySelector(
          `.reading-time-display[data-post-slug="${postSlug}"]`,
        ) as HTMLElement | null;
      const readingTimeSep = readingTimeElement?.previousElementSibling as HTMLElement | null;

      if (isRead) {
        dot.classList.add('read');
        indicator.setAttribute('title', 'Read');

        if (readingTimeElement) {
          readingTimeElement.textContent = 'Read';
          readingTimeElement.hidden = false;
          if (readingTimeSep?.classList.contains('postcard-meta__sep')) {
            readingTimeSep.hidden = false;
          }
        }
      } else {
        dot.classList.remove('read');
        indicator.setAttribute('title', 'Unread');

        if (readingTimeElement) {
          const originalReadingTime = readingTimeElement.getAttribute('data-original-reading-time');
          if (originalReadingTime) {
            readingTimeElement.textContent = originalReadingTime;
            readingTimeElement.hidden = false;
            if (readingTimeSep?.classList.contains('postcard-meta__sep')) {
              readingTimeSep.hidden = false;
            }
          } else {
            readingTimeElement.hidden = true;
            if (readingTimeSep?.classList.contains('postcard-meta__sep')) {
              readingTimeSep.hidden = true;
            }
          }
        }
      }
    });
  }

  let unsubscribe: (() => void) | null = null;
  if (readStateService) {
    unsubscribe = readStateService.subscribeToAll(() => {
      updateIndicators();
    });

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', updateIndicators);
    } else {
      updateIndicators();
    }
  }

  window.addEventListener('beforeunload', () => {
    if (unsubscribe) unsubscribe();
  });
</script>

<style>
  @reference '../styles/global.css';

  .read-indicator {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 10;
    pointer-events: none;
  }

  .read-dot {
    display: block;
    width: 8px;
    height: 8px;
    margin: 0;
    padding: 0;
    border-radius: 50%;
    background: rgb(var(--color-border));
    border: 2px solid rgb(var(--color-bg));
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .read-dot.read {
    background: rgb(var(--color-success));
    border-color: rgb(var(--color-success));
    box-shadow: 0 0 0 2px rgb(var(--color-success) / 0.22);
  }

  /* Prose wrappers fight card typography — scoped resets stay intentional */
  :global(.prose) article.postcard,
  article.postcard {
    position: relative;
    display: block;
    width: 100%;
    max-width: 100%;
    margin: 0;
    box-sizing: border-box;
    overflow: visible;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }

  :global(.prose) article.postcard :is(h1, h2, h3, h4, h5, h6, p, time, span, a, header),
  article.postcard :is(h1, h2, h3, h4, h5, h6, p, time, span, a, header) {
    margin: 0;
    padding: 0;
  }

  article.postcard .postcard-body {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding: 1rem 0 0;
  }

  article.postcard .postcard-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 0.45rem;
    row-gap: 0.15rem;
    font-family: var(--font-sans);
    font-size: 0.68rem;
    letter-spacing: 0.035em;
    line-height: 1.4;
    color: rgb(var(--color-text-muted));
    text-transform: uppercase;
  }

  .postcard-meta__item,
  .postcard-meta time {
    display: inline;
    color: rgb(var(--color-text-muted));
    font-size: inherit;
    line-height: inherit;
    white-space: nowrap;
  }

  .postcard-meta__sep {
    display: inline;
    color: rgb(var(--color-text-muted));
    opacity: 0.45;
    user-select: none;
    line-height: inherit;
  }

  .postcard-meta__featured {
    font-weight: 700;
    color: rgb(var(--color-accent));
  }

  .postcard-meta__es {
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: none;
    color: rgb(var(--color-accent));
  }

  .postcard-meta__kind {
    font-weight: 600;
  }

  article.postcard .postcard-title {
    display: block;
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 1.7vw, 1.6rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: rgb(var(--color-text));
    text-wrap: pretty;
    overflow: visible;
  }

  article.postcard .postcard-link {
    display: block;
    text-decoration: none;
    color: inherit;
    font-weight: inherit;
  }

  /* Stretch title link across the card for a single hit target */
  article.postcard .postcard-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  article.postcard .postcard-description {
    display: -webkit-box;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: rgb(var(--color-text-muted));
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
  }

  article.postcard .image-container {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-lg);
    margin: 0;
    padding: 0;
    background: rgb(var(--color-bg-alt));
    overflow: hidden;
  }

  article.postcard.compact-card .image-container {
    aspect-ratio: 16 / 9;
  }

  /* :global(img) — DefaultImage lives in a child scope, so unscoped img is required.
     Absolute fill so native aspect ratios cannot stretch the card. */
  article.postcard .image-container :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: center;
    display: block;
    border: none;
    margin: 0;
    padding: 0;
    box-shadow: none;
    border-radius: 0;
    transition: transform 0.45s var(--animation-easing-out);
  }

  :global(.prose) article.postcard .image-container :global(img) {
    width: 100% !important;
    height: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    object-fit: cover !important;
    object-position: center !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    cursor: default !important;
  }

  article.postcard.compact-card .postcard-body {
    padding: 0.75rem 0 0;
  }

  article.postcard:hover .postcard-link {
    color: rgb(var(--color-accent));
  }

  article.postcard:hover .image-container :global(img) {
    transform: scale(1.03);
  }

  article.postcard:focus-within {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 4px;
  }

  :global(.postcards-grid) {
    row-gap: 2.5rem;
    margin-top: 0;
    margin-bottom: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    article.postcard,
    article.postcard .image-container :global(img),
    .read-dot {
      transition: none;
    }

    article.postcard:hover .image-container :global(img) {
      transform: none;
    }
  }
</style>
