---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import DefaultImage from './DefaultImage.astro';
import { calculateReadingTimeFromMarkdown } from '../utils/readingTime';

interface Props {
  post: CollectionEntry<'blog'>;
  featured?: boolean;
  compact?: boolean;
  showFeaturedIndicator?: boolean;
}

const { post, featured = false, compact = false, showFeaturedIndicator = true } = Astro.props;
const { data } = post;

const readingTime = calculateReadingTimeFromMarkdown(post.body || '');
---

<article
  class="interactive-card group relative overflow-hidden"
  class:list={{
    'featured-card': featured,
    'compact-card': compact,
  }}
  role="article"
  data-post-slug={post.id}
>
  <div class="read-indicator" data-post-slug={post.id}>
    <span class="read-dot"></span>
  </div>

  <div class="image-container relative overflow-hidden">
    {
      data.heroImage ? (
        <img
          src={data.heroImage}
          alt={data.imageAlt || data.title}
          class="h-32 w-full object-cover object-center md:h-40"
          loading="lazy"
        />
      ) : (
        <DefaultImage
          alt={data.title}
          className="h-32 w-full object-cover object-center md:h-40"
          loading="lazy"
        />
      )
    }
  </div>

  <div class="postcard-body">
    <div class="postcard-meta">
      <FormattedDate date={data.pubDate} class="postcard-meta__item" />
      {
        readingTime && (
          <>
            <span class="postcard-meta__sep" aria-hidden="true">
              ·
            </span>
            <span
              class="postcard-meta__item reading-time-display"
              data-post-slug={post.id}
              data-original-reading-time={readingTime}
            >
              {readingTime}
            </span>
          </>
        )
      }
      {
        featured && showFeaturedIndicator && (
          <>
            <span class="postcard-meta__sep" aria-hidden="true">
              ·
            </span>
            <span
              class="postcard-meta__item postcard-meta__featured"
              role="img"
              aria-label="Featured post"
            >
              Featured
            </span>
          </>
        )
      }
    </div>

    <h2 id={`postcard-title-${post.id}`} class="postcard-title">
      <a href={`/p/${post.id}`}>{data.title}</a>
    </h2>

    {
      data.description && (
        <p class="postcard-description">{data.description}</p>
      )
    }
  </div>
</article>

<script>
  const readStateService = (window as any).ReadStateService?.getInstance();

  function updateIndicators() {
    if (!readStateService) return;

    document.querySelectorAll('.read-indicator').forEach((indicator) => {
      const postSlug = (indicator as HTMLElement).dataset.postSlug;
      const dot = indicator.querySelector('.read-dot');

      if (!postSlug || !dot) return;

      const isRead = readStateService.isRead(postSlug);
      const readingTimeElement = document.querySelector(
        `.reading-time-display[data-post-slug="${postSlug}"]`,
      ) as HTMLElement | null;
      const readingTimeSep = readingTimeElement?.previousElementSibling as HTMLElement | null;

      if (isRead) {
        dot.classList.add('read');
        indicator.setAttribute('title', 'Read');

        if (readingTimeElement) {
          readingTimeElement.textContent = 'Read';
          readingTimeElement.hidden = false;
          if (readingTimeSep?.classList.contains('postcard-meta__sep')) {
            readingTimeSep.hidden = false;
          }
        }
      } else {
        dot.classList.remove('read');
        indicator.setAttribute('title', 'Unread');

        if (readingTimeElement) {
          const originalReadingTime = readingTimeElement.getAttribute(
            'data-original-reading-time',
          );
          if (originalReadingTime) {
            readingTimeElement.textContent = originalReadingTime;
            readingTimeElement.hidden = false;
            if (readingTimeSep?.classList.contains('postcard-meta__sep')) {
              readingTimeSep.hidden = false;
            }
          } else {
            readingTimeElement.hidden = true;
            if (readingTimeSep?.classList.contains('postcard-meta__sep')) {
              readingTimeSep.hidden = true;
            }
          }
        }
      }
    });
  }

  let unsubscribe: (() => void) | null = null;
  if (readStateService) {
    unsubscribe = readStateService.subscribeToAll(() => {
      updateIndicators();
    });

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', updateIndicators);
    } else {
      updateIndicators();
    }
  }

  window.addEventListener('beforeunload', () => {
    if (unsubscribe) unsubscribe();
  });
</script>

<style>
  @reference '../styles/global.css';

  .read-indicator {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 10;
    pointer-events: none;
  }

  .read-dot {
    display: block;
    width: 8px;
    height: 8px;
    margin: 0;
    padding: 0;
    border-radius: 50%;
    background: rgb(var(--color-border));
    border: 2px solid rgb(var(--color-bg));
    transition: background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .read-dot.read {
    background: rgb(34, 197, 94);
    border-color: rgb(34, 197, 94);
    box-shadow: 0 0 0 2px rgb(34, 197, 94, 0.2);
  }

  :global(.prose) article.interactive-card,
  article.interactive-card {
    transition:
      box-shadow 0.2s ease,
      border-color 0.2s ease;
    border: 1px solid rgb(var(--color-border) / 0.35) !important;
    box-shadow: var(--shadow-soft) !important;
    width: 100% !important;
    display: block !important;
    margin: 0 !important;
    max-width: 100% !important;
    box-sizing: border-box !important;
    background: rgb(var(--color-bg)) !important;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  /* Kill inherited prose/global margins on every text node in the card */
  :global(.prose) article.interactive-card :is(h1, h2, h3, h4, h5, h6, p, time, span, a, div, header),
  article.interactive-card :is(h1, h2, h3, h4, h5, h6, p, time, span, a, div, header) {
    margin: 0 !important;
    padding: 0 !important;
    max-width: none !important;
  }

  :global(.prose) article.interactive-card .postcard-body,
  article.interactive-card .postcard-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem !important;
  }

  @media (min-width: 640px) {
    :global(.prose) article.interactive-card .postcard-body,
    article.interactive-card .postcard-body {
      padding: 1.25rem !important;
    }
  }

  @media (min-width: 768px) {
    :global(.prose) article.interactive-card .postcard-body,
    article.interactive-card .postcard-body {
      padding: 1.5rem !important;
    }
  }

  :global(.prose) article.interactive-card .postcard-meta,
  article.interactive-card .postcard-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 0.5rem;
    row-gap: 0.15rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    line-height: 1.4;
    color: rgb(var(--color-text-muted));
  }

  .postcard-meta__item,
  .postcard-meta time {
    display: inline;
    color: rgb(var(--color-text-muted));
    font-size: inherit;
    line-height: inherit;
    white-space: nowrap;
  }

  .postcard-meta__sep {
    display: inline;
    color: rgb(var(--color-text-muted));
    opacity: 0.5;
    user-select: none;
    line-height: inherit;
  }

  .postcard-meta__featured {
    font-weight: 600;
    color: rgb(var(--color-primary));
  }

  :global(.prose) article.interactive-card .postcard-title,
  article.interactive-card .postcard-title {
    font-family: var(--font-heading);
    font-size: 1rem !important;
    line-height: 1.35 !important;
    font-weight: 700 !important;
    letter-spacing: -0.01em !important;
    color: rgb(var(--color-text));
  }

  @media (min-width: 640px) {
    :global(.prose) article.interactive-card .postcard-title,
    article.interactive-card .postcard-title {
      font-size: 1.125rem !important;
    }
  }

  @media (min-width: 768px) {
    :global(.prose) article.interactive-card .postcard-title,
    article.interactive-card .postcard-title {
      font-size: 1.25rem !important;
    }
  }

  :global(.prose) article.interactive-card .postcard-title a,
  article.interactive-card .postcard-title a {
    display: inline;
    text-decoration: none !important;
    color: inherit !important;
    font-weight: inherit !important;
  }

  :global(.prose) article.interactive-card .postcard-description,
  article.interactive-card .postcard-description {
    font-family: var(--font-sans);
    font-size: 0.875rem !important;
    line-height: 1.55 !important;
    color: rgb(var(--color-text-muted));
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  @media (min-width: 640px) {
    :global(.prose) article.interactive-card .postcard-description,
    article.interactive-card .postcard-description {
      font-size: 0.9375rem !important;
    }
  }

  article.interactive-card .image-container {
    position: relative;
    width: 100%;
    height: 8rem;
    margin: 0 !important;
    padding: 0 !important;
    background: rgb(var(--color-bg-alt));
    overflow: hidden;
  }

  :global(.prose) article.interactive-card .image-container img,
  article.interactive-card .image-container img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    object-position: center !important;
    display: block !important;
    border: none !important;
    outline: none !important;
    margin: 0 !important;
    padding: 0 !important;
    max-width: 100% !important;
    box-shadow: none !important;
    border-radius: 0 !important;
    cursor: default !important;
  }

  @media (min-width: 768px) {
    article.interactive-card .image-container {
      height: 22rem;
    }
  }

  .featured-card {
    border: 2px solid rgb(var(--color-primary) / 0.3);
    box-shadow: 0 4px 12px -2px rgb(var(--color-primary) / 0.15);
  }

  .compact-card.interactive-card .postcard-body,
  :global(.prose) article.compact-card .postcard-body {
    padding: 0.75rem !important;
  }

  @media (min-width: 640px) {
    .compact-card.interactive-card .postcard-body,
    :global(.prose) article.compact-card .postcard-body {
      padding: 1rem !important;
    }
  }

  .group:hover {
    box-shadow: var(--shadow-lift);
    border-color: rgb(var(--color-primary) / 0.28);
  }

  .group:focus-within {
    outline: 2px solid rgb(var(--color-primary));
    outline-offset: 2px;
    border-radius: var(--radius-lg);
  }

  :global(.postcards-grid) {
    margin-top: 0;
    margin-bottom: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    article.interactive-card {
      transition: none !important;
    }

    .group:hover {
      transform: none;
    }

    .read-dot {
      transition: none !important;
    }
  }
</style>
