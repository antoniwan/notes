---
import Container from './Container.astro';

export interface Props {
  title: string;
  description?: string;
  className?: string;
  showTitle?: boolean;
  /** Extra classes for the title/description stack (gap). */
  stackClass?: string;
  /** Extra classes for the description (size). */
  descriptionClass?: string;
  /**
   * Document heading level. Keep a single page H1 — use `p` for visual echoes.
   * Default: h1 (canonical page title via PageHeader).
   */
  as?: 'h1' | 'p';
}

const {
  title,
  description,
  className = '',
  showTitle = true,
  stackClass = '',
  descriptionClass = '',
  as = 'h1',
}: Props = Astro.props as Props;
const TitleTag = as;
---

<Container maxWidth="container" padding="none" class={`py-4 md:py-8 lg:py-10 ${className}`}>
  <div class:list={['flex flex-col', stackClass || 'gap-3 md:gap-4']}>
    <TitleTag
      class={`text-display m-0 text-[rgb(var(--color-text))]${!showTitle ? ' sr-only' : ''}`}
    >
      {title}
    </TitleTag>
    {
      description && (
        <p
          class:list={[
            'text-body-muted m-0 max-w-none leading-[1.65]',
            descriptionClass || 'text-base md:text-lg',
          ]}
        >
          {description}
        </p>
      )
    }
  </div>
</Container>
