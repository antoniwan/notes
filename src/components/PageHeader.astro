---
import Container from './Container.astro';

interface Props {
  title: string;
  description?: string;
  className?: string;
  showTitle?: boolean;
  /**
   * Document heading level. Keep a single page H1 — use `p` for visual echoes.
   * Default: h1 (canonical page title via PageHeader).
   */
  as?: 'h1' | 'p';
}

const { title, description, className = '', showTitle = true, as = 'h1' } = Astro.props;
const TitleTag = as;
---

<Container maxWidth="container" padding="none" class={`py-4 md:py-8 lg:py-10 ${className}`}>
  <div class="space-y-3 md:space-y-4">
    <TitleTag
      class={`text-display text-[rgb(var(--color-text))]${!showTitle ? ' sr-only' : ''}`}
      style="margin: 0;"
    >
      {title}
    </TitleTag>
    {
      description && (
        <p
          class="text-body-muted max-w-none text-base leading-relaxed md:text-lg md:leading-relaxed"
          style="margin: 0; line-height: 1.65;"
        >
          {description}
        </p>
      )
    }
  </div>
</Container>
