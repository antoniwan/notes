---
import Container from './Container.astro';

interface Props {
  title: string;
  description?: string;
  className?: string;
  showTitle?: boolean;
}

const { title, description, className = '', showTitle = true } = Astro.props;
---

<Container maxWidth="container" padding="none" class={`py-4 md:py-8 lg:py-10 ${className}`}>
  <div class="space-y-3 md:space-y-4">
    <h1
      class={`text-display text-[rgb(var(--color-text))]${!showTitle ? ' sr-only' : ''}`}
      style="line-height: 1.15; margin: 0;"
    >
      {title}
    </h1>
    {
      description && (
        <p
          class="md:text-body-large text-body-muted max-w-[40rem] text-base leading-relaxed"
          style="margin: 0; line-height: 1.65;"
        >
          {description}
        </p>
      )
    }
  </div>
</Container>
