---
import type { CollectionEntry } from 'astro:content';
import { getCategoryNameFromIds } from '../utils/categoryUtils';
import { calculateReadingTimeFromMarkdown } from '../utils/readingTime';
import { isRecipePost } from '../utils/recipes';

export interface Props {
  posts: CollectionEntry<'blog'>[];
  chapterTitle: string;
  chapterId: string;
}

const { posts, chapterTitle, chapterId } = Astro.props;
const shortDate = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<section class="book-chapter" id={chapterId} data-season aria-labelledby={`heading-${chapterId}`}>
  <header class="chapter-header">
    <div>
      <h2 class="chapter-title" id={`heading-${chapterId}`} tabindex="-1">{chapterTitle}</h2>
      <p class="chapter-count">{posts.length} {posts.length === 1 ? 'writing' : 'writings'}</p>
    </div>
    <span class="chapter-progress" data-chapter-read hidden></span>
  </header>
  <ol class="post-list">
    {
      posts.map((post, index) => {
        const categoryName = getCategoryNameFromIds(post.data.category);
        const isRecipe = isRecipePost(post);
        const readingTime = calculateReadingTimeFromMarkdown(post.body || '');
        return (
          <li class="post-item" data-guided-post={post.id}>
            <a href={`/p/${post.id}`} class="post-link">
              <span class="post-number" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <div class="post-content">
                <h3 class="post-title">{post.data.title}</h3>
                <div class="post-meta">
                  <time datetime={post.data.pubDate.toISOString()}>
                    {shortDate.format(post.data.pubDate)}
                  </time>
                  {isRecipe && <span>Recipe</span>}
                  {categoryName && <span class="post-category">{categoryName}</span>}
                </div>
                {post.data.description && <p class="post-description">{post.data.description}</p>}
              </div>
              <div class="post-status">
                {readingTime && !isRecipe && <span>{readingTime}</span>}
                <span class="read-status" data-read-status hidden>
                  Unread
                </span>
              </div>
            </a>
          </li>
        );
      })
    }
  </ol>
</section>

<style>
  .book-chapter {
    min-width: 0;
    padding: 1.5rem;
    border-radius: var(--radius-lg);
    background: rgb(var(--color-bg-alt));
    scroll-margin-top: calc(var(--site-header-height) + 2rem);
  }
  .book-chapter[data-active-season] {
    background: color-mix(in srgb, rgb(var(--color-accent)) 6%, rgb(var(--color-bg)));
    box-shadow: inset 3px 0 0 rgb(var(--color-accent));
  }
  .book-chapter[data-active-season] .chapter-title {
    color: rgb(var(--color-accent));
  }
  .chapter-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .chapter-title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 2.6vw, 2.25rem);
    line-height: 1.15;
    font-weight: 600;
    letter-spacing: -0.025em;
    scroll-margin-top: calc(var(--site-header-height) + 2rem);
  }
  .chapter-count,
  .chapter-progress {
    margin: 0.75rem 0 0;
    color: rgb(var(--color-text-muted));
    font-family: var(--font-sans);
    font-size: 0.875rem;
    line-height: 1.6;
    font-variant-numeric: tabular-nums;
  }
  .chapter-progress.is-complete {
    color: rgb(var(--color-success));
  }
  .post-list {
    display: grid;
    gap: 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .post-item {
    margin: 0;
    min-width: 0;
  }
  .post-link {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    gap: 0.75rem 1rem;
    align-items: start;
    padding: 0.5rem;
    margin: -0.5rem;
    border-radius: var(--radius-md);
    color: rgb(var(--color-text));
    text-decoration: none;
    transition: background-color 160ms ease;
  }
  .post-link:hover {
    background: rgb(var(--color-bg-alt));
  }
  .post-link:hover .post-title {
    color: rgb(var(--color-accent));
  }
  .post-link:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 4px;
  }
  .post-number {
    padding-top: 0.25rem;
    color: rgb(var(--color-text-muted));
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
    line-height: 1.5;
  }
  .post-content {
    min-width: 0;
  }
  .post-title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 1.7vw, 1.6rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.015em;
    text-wrap: pretty;
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 1rem;
    margin-top: 0.75rem;
    color: rgb(var(--color-text-muted));
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .post-category {
    color: rgb(var(--color-accent));
  }
  .post-description {
    max-width: 62ch;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    margin: 0.75rem 0 0;
    color: rgb(var(--color-text-muted));
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.7;
  }
  .post-status {
    grid-column: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    color: rgb(var(--color-text-muted));
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .read-status.is-read {
    color: rgb(var(--color-success));
    font-weight: 600;
  }
  @media (min-width: 768px) {
    .book-chapter {
      padding: 2rem;
    }
    .post-list {
      gap: 2.5rem;
    }
    .post-link {
      grid-template-columns: 1.5rem minmax(0, 1fr) 6rem;
    }
    .post-status {
      grid-column: 3;
      flex-direction: column;
      align-items: flex-end;
      padding-top: 0.25rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .post-link {
      transition: none;
    }
  }
</style>
