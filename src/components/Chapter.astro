---
import { getCategoryNameFromIds } from '../utils/categoryUtils';
import { calculateReadingTimeFromMarkdown } from '../utils/readingTime';

export interface Props {
  posts: any[];
  chapterTitle: string;
  chapterId: string;
  defaultExpanded?: boolean;
}

const { posts, chapterTitle, chapterId, defaultExpanded = true } = Astro.props;
---

<div class="book-chapter">
  <button
    class="chapter-header"
    aria-expanded={defaultExpanded}
    aria-controls={`chapter-${chapterId}`}
  >
    <div class="chapter-title-section">
      <h2 class="chapter-title">{chapterTitle}</h2>
      <div class="chapter-meta">
        <span class="post-count">({posts.length} writings)</span>
        <div class="chapter-progress" data-chapter-id={chapterId}>
          <div class="progress-bar">
            <div class="progress-fill" data-chapter-id={chapterId}></div>
          </div>
          <span class="progress-text" data-chapter-id={chapterId}>0%</span>
        </div>
      </div>
    </div>
    <svg
      class="expand-icon"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
      style={`transform: rotate(${defaultExpanded ? '180deg' : '0deg'})`}
    >
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"
      ></path>
    </svg>
  </button>

  <div class={`chapter-content ${!defaultExpanded ? 'collapsed' : ''}`} id={`chapter-${chapterId}`}>
    {
      posts.length > 0 ? (
        <ol class="post-list">
          {posts.map((post, index) => {
            const categoryName = getCategoryNameFromIds(post.data.category);
            return (
              <li class="post-item">
                <a href={`/p/${post.id}`} class="post-link" data-post-slug={post.id}>
                  <span class="post-number">{index + 1}.</span>
                  <div class="post-content">
                    <span class="post-title">{post.data.title}</span>
                    {categoryName && <span class="post-category">{categoryName}</span>}
                  </div>
                  <div class="post-status">
                    <span class="read-status" data-post-slug={post.id}>
                      <span class="status-icon">⭕</span>
                      <span class="status-text">Unread</span>
                    </span>
                    <span class="reading-time" data-post-slug={post.id}>
                      {calculateReadingTimeFromMarkdown(post.body || '')}
                    </span>
                  </div>
                </a>
              </li>
            );
          })}
        </ol>
      ) : (
        <p class="empty-state">No writings yet in this chapter.</p>
      )
    }
  </div>
</div>

<script>
  // ReadStateService is initialized by ReadStateServiceInit component in BaseLayout
  // Get the singleton instance (typed as any for client script)
  const readStateService: any = (window as any).ReadStateService?.getInstance
    ? (window as any).ReadStateService.getInstance()
    : undefined;

  function updateIndicators() {
    if (!readStateService) return; // Exit early if service not available

    document.querySelectorAll('.read-status').forEach((statusElement) => {
      const statusEl = statusElement as HTMLElement;
      const postSlug = statusEl.dataset.postSlug;
      const iconElement = statusEl.querySelector('.status-icon') as HTMLElement | null;
      const textElement = statusEl.querySelector('.status-text') as HTMLElement | null;

      if (!postSlug || !iconElement || !textElement) return;

      const isRead = readStateService.isRead(postSlug);
      const readingTimeElement = document.querySelector(
        `.reading-time[data-post-slug="${postSlug}"]`,
      ) as HTMLElement | null;

      if (isRead) {
        iconElement.textContent = '✅';
        textElement.textContent = 'Read';
        statusEl.classList.add('read');
        if (readingTimeElement) {
          readingTimeElement.style.display = 'none';
        }
      } else {
        iconElement.textContent = '⭕';
        textElement.textContent = 'Unread';
        statusEl.classList.remove('read');
        if (readingTimeElement) {
          readingTimeElement.style.display = 'inline';
        }
      }
    });

    // Update chapter progress
    updateChapterProgress();
  }

  function updateChapterProgress() {
    document.querySelectorAll('.chapter-progress').forEach((progressElement) => {
      const progressEl = progressElement as HTMLElement;
      const chapterId = progressEl.dataset.chapterId;
      if (!chapterId) return;

      const chapterContent = document.getElementById(`chapter-${chapterId}`);
      if (!chapterContent) return;

      const posts = chapterContent.querySelectorAll('.post-item');
      const readPosts = chapterContent.querySelectorAll('.post-item .read-status.read');

      const totalPosts = posts.length;
      const readCount = readPosts.length;
      const percentage = totalPosts > 0 ? Math.round((readCount / totalPosts) * 100) : 0;

      // Update progress bar
      const progressFill = progressEl.querySelector('.progress-fill') as HTMLElement | null;
      if (progressFill) {
        progressFill.style.width = `${percentage}%`;
      }

      // Update progress text
      const progressText = progressEl.querySelector('.progress-text') as HTMLElement | null;
      if (progressText) {
        progressText.textContent = `${percentage}%`;
      }

      // Add completion class for styling
      if (percentage === 100) {
        progressEl.classList.add('completed');
      } else {
        progressEl.classList.remove('completed');
      }
    });
  }

  // Chapter expand/collapse functionality
  class ChapterManager {
    constructor() {
      this.init();
    }

    init(): void {
      // Add click handlers to chapter headers
      document.querySelectorAll('.chapter-header').forEach((header) => {
        const headerEl = header as HTMLElement;
        headerEl.addEventListener('click', (e) => {
          e.preventDefault();
          this.toggleChapter(headerEl);
        });
      });
    }

    toggleChapter(header: HTMLElement): void {
      const isExpanded = header.getAttribute('aria-expanded') === 'true';
      const contentId = header.getAttribute('aria-controls');
      if (!contentId) return;

      const content = document.getElementById(contentId);
      const icon = header.querySelector('.expand-icon') as HTMLElement | null;
      if (!icon) return;

      if (isExpanded) {
        // Collapse
        header.setAttribute('aria-expanded', 'false');
        if (content) content.classList.add('collapsed');
        icon.style.transform = 'rotate(0deg)';
      } else {
        // Expand
        header.setAttribute('aria-expanded', 'true');
        if (content) content.classList.remove('collapsed');
        icon.style.transform = 'rotate(180deg)';
      }
    }
  }

  let unsubscribe = null;

  function initChapterFeatures() {
    new ChapterManager();
    updateIndicators();
  }

  if (readStateService) {
    unsubscribe = readStateService.subscribeToAll(() => {
      updateIndicators();
    });

    // Initial update
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initChapterFeatures);
    } else {
      initChapterFeatures();
    }
  } else {
    // Initialize chapter manager even if service not available
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        new ChapterManager();
      });
    } else {
      new ChapterManager();
    }
  }

  // Cleanup on page unload
  window.addEventListener('beforeunload', () => {
    if (typeof unsubscribe === 'function') {
      unsubscribe();
    }
  });
</script>

<style>
  .book-chapter {
    margin-bottom: 1.25rem;
    border: 1px solid rgb(var(--color-border) / 0.55);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: rgb(var(--color-bg));
  }

  .book-chapter:last-child {
    margin-bottom: 0;
  }

  .chapter-header {
    width: 100%;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 1.35rem;
    background: rgb(var(--color-bg-alt));
    border: none;
    cursor: pointer;
    text-align: left;
    transition: background-color 0.2s ease;
  }

  @media (min-width: 768px) {
    .chapter-header {
      align-items: center;
      padding: 1.35rem 1.75rem;
    }
  }

  .chapter-header:hover {
    background: rgb(var(--color-surface-2));
  }

  .chapter-header:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: -2px;
  }

  .chapter-title-section {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.55rem;
    flex: 1;
    min-width: 0;
  }

  @media (min-width: 768px) {
    .chapter-title-section {
      flex-direction: row;
      align-items: center;
      gap: 1.25rem;
    }
  }

  .chapter-title {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.25;
    color: rgb(var(--color-text));
    margin: 0;
  }

  @media (min-width: 768px) {
    .chapter-title {
      font-size: 1.5rem;
    }
  }

  .chapter-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
  }

  @media (min-width: 768px) {
    .chapter-meta {
      margin-left: auto;
    }
  }

  .post-count {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: rgb(var(--color-text-muted));
    font-weight: 500;
  }

  .chapter-progress {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    min-width: 7rem;
  }

  .progress-bar {
    width: 4.5rem;
    height: 0.4rem;
    background: rgb(var(--color-border));
    border-radius: 999px;
    overflow: hidden;
  }

  .progress-fill {
    height: 100%;
    background: rgb(var(--color-primary));
    border-radius: 999px;
    width: 0%;
    transition: width 0.3s ease;
  }

  .chapter-progress.completed .progress-fill {
    background: rgb(var(--color-success));
  }

  .progress-text {
    font-size: 0.75rem;
    font-weight: 600;
    color: rgb(var(--color-text-muted));
    min-width: 2.25rem;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .chapter-progress.completed .progress-text {
    color: rgb(var(--color-success));
  }

  .expand-icon {
    width: 1.35rem;
    height: 1.35rem;
    flex-shrink: 0;
    margin-top: 0.2rem;
    color: rgb(var(--color-text-muted));
    transition: transform 0.2s ease;
  }

  @media (min-width: 768px) {
    .expand-icon {
      margin-top: 0;
    }
  }

  /* Grid collapse avoids clipping long seasons (old max-height: 2000px bug) */
  .chapter-content {
    display: grid;
    grid-template-rows: 1fr;
    transition:
      grid-template-rows 0.28s ease,
      opacity 0.2s ease;
    opacity: 1;
  }

  .chapter-content.collapsed {
    grid-template-rows: 0fr;
    opacity: 0;
  }

  .chapter-content > * {
    overflow: hidden;
  }

  .post-list {
    list-style: none;
    padding: 0.35rem 0;
    margin: 0;
  }

  .post-item {
    margin: 0;
    border-bottom: 1px solid rgb(var(--color-border) / 0.55);
  }

  .post-item:last-child {
    border-bottom: none;
  }

  .post-link {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    gap: 0.35rem 0.85rem;
    align-items: start;
    padding: 1.1rem 1.35rem;
    text-decoration: none;
    color: rgb(var(--color-text));
    transition: background-color 0.2s ease;
  }

  @media (min-width: 768px) {
    .post-link {
      grid-template-columns: 2.5rem minmax(0, 1fr) auto;
      align-items: center;
      gap: 0.85rem 1.1rem;
      padding: 1.2rem 1.75rem;
    }
  }

  .post-link:hover {
    background: rgb(var(--color-bg-alt));
  }

  .post-link:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: -2px;
  }

  .post-number {
    font-family: var(--font-sans);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: rgb(var(--color-text-muted));
    line-height: 1.5;
  }

  .post-content {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }

  .post-title {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  @media (min-width: 768px) {
    .post-title {
      font-size: 1.1rem;
    }
  }

  .post-category {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    color: rgb(var(--color-accent));
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .post-status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem 0.75rem;
    grid-column: 2;
  }

  @media (min-width: 768px) {
    .post-status {
      grid-column: auto;
      justify-self: end;
    }
  }

  .read-status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-sm);
    background: transparent;
    border: 1px solid rgb(var(--color-border));
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .read-status.read {
    background: rgb(var(--color-success) / 0.1);
    color: rgb(var(--color-success));
    border-color: rgb(var(--color-success) / 0.28);
  }

  .status-icon {
    font-size: 0.8rem;
  }

  .status-text {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .reading-time {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: rgb(var(--color-text-muted));
    white-space: nowrap;
  }

  .empty-state {
    color: rgb(var(--color-text-muted));
    font-style: italic;
    padding: 1.75rem;
    text-align: center;
    margin: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .chapter-content,
    .expand-icon,
    .progress-fill,
    .post-link,
    .read-status {
      transition: none;
    }
  }
</style>
