---
/**
 * What this section is: a forkable Markdown toolkit, plus local-only reports.
 */
const notesRepoUrl = 'https://github.com/antoniwan/notes';
---

<aside class="wi-preamble" aria-labelledby="wi-preamble-heading">
  <h2 id="wi-preamble-heading" class="wi-preamble__heading">
    An idea — this is a toolkit, not a verdict
  </h2>
  <p>
    Put Markdown in <code>src/content/p/</code> and run the build, or
    <a href={notesRepoUrl}>fork the repo</a> and do the same. These pages count dates, tags, and word-list
    hits from that folder.
  </p>
  <p>
    Dated files in <code>docs/materials/</code> and the graph under <code>graphify-out/</code> stay on
    this machine. Pages are <code>noindex</code>. A letter grade is a number from a formula; the
    “this set” and “an A” lines say what that formula used.
  </p>
</aside>

<style>
  .wi-preamble {
    margin: 0 0 1.75rem;
    max-width: 42rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px dashed rgb(var(--color-border) / 0.7);
  }

  .wi-preamble__heading {
    margin: 0 0 0.75rem;
    font-family: var(--font-sans);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
    line-height: 1.35;
    color: rgb(var(--color-text));
  }

  .wi-preamble p {
    margin: 0 0 0.75rem;
    font-size: 0.95rem;
    line-height: 1.65;
    color: rgb(var(--color-text-muted));
  }

  .wi-preamble p:last-child {
    margin-bottom: 0;
  }

  .wi-preamble a {
    color: rgb(var(--color-accent));
    text-underline-offset: 3px;
  }

  .wi-preamble code {
    font-size: 0.85em;
  }
</style>
