---
import { BRAIN_SCIENCE_PAGES } from '../../data/brainScience';

interface Props {
  currentPage: string;
  showNavLinks?: boolean;
}

const { currentPage, showNavLinks = true } = Astro.props;
const allPages = BRAIN_SCIENCE_PAGES;
---

{
  showNavLinks && (
    <nav class="bs-nav" aria-label="Brain Science sections">
      <ul class="bs-nav__list">
        {allPages.map((page) => {
          const isActive = page.path === currentPage;
          return (
            <li>
              <a
                href={page.path}
                class:list={['bs-nav__link', { 'is-active': isActive }]}
                aria-current={isActive ? 'page' : undefined}
              >
                <span class="bs-nav__label-short">{page.title.split(' ')[0]}</span>
                <span class="bs-nav__label-full">{page.title}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  )
}

<style>
  .bs-nav {
    margin: 0 0 0.5rem;
    border-bottom: 1px solid rgb(var(--color-border) / 0.55);
  }

  .bs-nav__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .bs-nav__link {
    display: inline-flex;
    align-items: center;
    padding: 0.7rem 0.75rem;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 500;
    line-height: 1.2;
    color: rgb(var(--color-text-muted));
    text-decoration: none;
    white-space: nowrap;
    transition:
      color 0.15s ease,
      border-color 0.15s ease,
      background-color 0.15s ease;
  }

  @media (min-width: 768px) {
    .bs-nav__link {
      padding: 0.85rem 1rem;
      font-size: 0.92rem;
    }
  }

  .bs-nav__link:hover {
    color: rgb(var(--color-text));
    background: rgb(var(--color-bg-alt));
  }

  .bs-nav__link.is-active {
    color: rgb(var(--color-accent));
    border-bottom-color: rgb(var(--color-primary));
    font-weight: 600;
  }

  .bs-nav__link:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 2px;
  }

  .bs-nav__label-short {
    display: inline;
  }

  .bs-nav__label-full {
    display: none;
  }

  @media (min-width: 640px) {
    .bs-nav__label-short {
      display: none;
    }

    .bs-nav__label-full {
      display: inline;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bs-nav__link {
      transition: none;
    }
  }
</style>
