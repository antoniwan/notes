---
import Container from '../Container.astro';
import BrainScienceNav from './BrainScienceNav.astro';
import { getBrainSciencePage } from '../../data/brainScience';

interface Props {
  currentPage: string;
  title: string;
  description: string;
  emoji?: string;
  showNavLinks?: boolean;
}

const { currentPage, title, description, emoji, showNavLinks = true } = Astro.props;

const pageInfo = getBrainSciencePage(currentPage);
const displayEmoji = emoji || pageInfo?.emoji || '🧠';
---

<Container class="pt-4 md:pt-6 lg:pt-8">
  <BrainScienceNav currentPage={currentPage} showNavLinks={showNavLinks} />

  <header class="bs-header">
    <p class="bs-header__eyebrow" aria-hidden="true">{displayEmoji}</p>
    <h1 class="bs-header__title">{title}</h1>
    <p class="bs-header__desc">{description}</p>
  </header>

  <div class="bs-content">
    <slot />
  </div>
</Container>

<style>
  .bs-header {
    margin: 1.5rem 0 2rem;
    max-width: 48rem;
  }

  @media (min-width: 768px) {
    .bs-header {
      margin: 1.75rem 0 2.5rem;
    }
  }

  .bs-header__eyebrow {
    margin: 0 0 0.5rem;
    font-size: 1.5rem;
    line-height: 1;
  }

  .bs-header__title {
    margin: 0 0 0.85rem;
    font-family: var(--font-heading);
    font-size: clamp(1.85rem, 1.4rem + 1.6vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: rgb(var(--color-text));
  }

  .bs-header__desc {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.65;
    color: rgb(var(--color-text-muted));
  }

  @media (min-width: 768px) {
    .bs-header__desc {
      font-size: 1.125rem;
      line-height: 1.7;
    }
  }

  .bs-content {
    padding-bottom: 3rem;
  }

  @media (min-width: 768px) {
    .bs-content {
      padding-bottom: 4rem;
    }
  }

  /* Tone down dense card grids inside analytics pages */
  .bs-content :global(h2) {
    font-family: var(--font-heading);
    letter-spacing: -0.015em;
  }
</style>
