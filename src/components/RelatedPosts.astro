---
import type { CollectionEntry } from 'astro:content';
import { findRelatedPosts } from '../utils/tagProcessing';
import PostSectionBreak from './PostSectionBreak.astro';
import PostCard from './PostCard.astro';

interface Props {
  currentPost?: CollectionEntry<'blog'>;
  allPosts?: CollectionEntry<'blog'>[];
}

const { currentPost, allPosts } = Astro.props;
const relatedPosts = currentPost && allPosts ? findRelatedPosts(currentPost, allPosts, 4) : [];
---

{
  relatedPosts.length > 0 && (
    <section class="related-posts" aria-labelledby="related-posts-heading">
      <PostSectionBreak />
      <header class="related-heading">
        <h2 id="related-posts-heading">💡 Continue Reading</h2>
        <p>The rest is yours to explore.</p>
      </header>
      <div class="postcards-grid related-grid">
        {relatedPosts.map((post) => (
          <PostCard
            post={post}
            compact
            headingAs="h3"
            idPrefix="related"
            showFeaturedIndicator={false}
          />
        ))}
      </div>
      <a href="/everything" class="related-browse">
        Browse All Writings <span aria-hidden="true">↗</span>
      </a>
    </section>
  )
}

<style>
  .related-posts {
    margin-top: 2rem;
    scroll-margin-top: 6rem;
  }

  .related-heading {
    margin-bottom: 2rem;
  }

  .related-heading h2 {
    margin: 0 0 0.65rem;
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.025em;
  }

  .related-heading p {
    margin: 0;
    color: rgb(var(--color-text-muted));
    font-size: 1rem;
    line-height: 1.65;
  }

  .related-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem 2rem;
  }

  .related-browse {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
    padding: 0.5rem 0;
    color: rgb(var(--color-accent));
    font-weight: 600;
    text-decoration: none;
  }

  .related-browse:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .related-browse:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 4px;
  }

  @media (min-width: 640px) {
    .related-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
