---
import type { Category } from '../data/categories';

interface Props {
  category: Category;
  postCount: number;
}

const { category, postCount } = Astro.props;
---

<a
  href={`/category/${category.id}`}
  class="category-card"
  aria-labelledby={`category-${category.id}-title`}
  aria-describedby={`category-${category.id}-description category-${category.id}-count`}
>
  <div class="category-card__heading">
    <div class="category-card__name">
      {
        category.icon && (
          <span class="category-card__icon" aria-hidden="true">
            {category.icon}
          </span>
        )
      }
      <h2 id={`category-${category.id}-title`} class="category-card__title">
        {category.name}
      </h2>
    </div>
    <span class="category-card__arrow" aria-hidden="true">↗</span>
  </div>
  <p id={`category-${category.id}-description`} class="category-card__description">
    {category.description}
  </p>
  <p id={`category-${category.id}-count`} class="category-card__count">
    {`${postCount} ${postCount === 1 ? 'writing' : 'writings'}`}
  </p>
</a>

<style>
  .category-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-width: 0;
    padding: 1.5rem;
    border-radius: var(--radius-lg);
    background: rgb(var(--color-bg-alt));
    color: rgb(var(--color-text));
    text-decoration: none;
    transition: background-color 160ms ease;
  }

  .category-card:hover {
    background: rgb(var(--color-surface-2));
  }

  .category-card:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 4px;
  }

  .category-card__heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .category-card__name {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    min-width: 0;
  }

  .category-card__icon {
    flex-shrink: 0;
    font-size: 1.35em;
    line-height: 1;
  }

  .category-card__title {
    min-width: 0;
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 1.7vw, 1.6rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .category-card__arrow {
    flex-shrink: 0;
    color: rgb(var(--color-accent));
    font-size: 1.125rem;
  }

  .category-card:hover .category-card__title,
  .category-card:focus-visible .category-card__title {
    color: rgb(var(--color-accent));
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .category-card__description {
    max-width: 40ch;
    margin: 1rem 0 1.5rem;
    font-size: 1.125rem;
    line-height: 1.7;
    color: rgb(var(--color-text-muted));
    text-wrap: pretty;
  }

  .category-card__count {
    margin: auto 0 0;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.5;
    color: rgb(var(--color-text-muted));
    font-variant-numeric: tabular-nums;
  }

  @media (min-width: 768px) {
    .category-card {
      padding: 2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .category-card {
      transition: none;
    }
  }
</style>
