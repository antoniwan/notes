---
/**
 * Random quote for the 404 page. The pool is baked into the page at build
 * time and picked in the browser, so a missing page never waits on (or fails
 * on) a server function.
 * Visual language: left-border callout + topic chips.
 */
import { PREFERRED_TAGS } from '../data/tagVocabulary';
import { getTagFamily } from '../data/tagFamilies';
import { quotesData, getQuoteSourceUrl } from '../data/quotes';

interface Props {
  existingTags: string[];
}

const { existingTags } = Astro.props;
const tagFamilyBySlug = Object.fromEntries(
  (PREFERRED_TAGS as readonly string[]).map((tag) => [tag, getTagFamily(tag)]),
);
const quotes = quotesData.quotes.map((q) => ({
  text: q.text,
  author: q.author,
  work: q.work,
  book: q.book,
  themes: q.themes,
  sourceUrl: getQuoteSourceUrl(q),
}));
---

<section
  class="not-found-quote not-prose theme-transition mt-6 rounded-md border border-l-4 border-[rgb(var(--color-border))] border-l-[rgb(var(--color-primary))] bg-[rgb(var(--color-bg-alt))]/60 shadow-xs md:mt-8"
  aria-labelledby="nfq-label"
>
  <div class="px-4 py-5 md:px-6 md:py-6">
    <p
      id="nfq-label"
      class="text-body-muted mb-4 font-mono text-xs font-semibold tracking-[0.12em] uppercase"
    >
      From the archive
    </p>

    <div id="nfq-content">
      <blockquote class="nfq-pullquote">
        <p id="nfq-text" class="nfq-quote-text">
          The obstacle is the way.
        </p>
        <footer class="nfq-attribution">
          <cite id="nfq-author">Marcus Aurelius</cite>
          <span id="nfq-work" class="nfq-work hidden"></span>
        </footer>
        <p id="nfq-source-wrap" class="nfq-source-wrap hidden">
          <a
            id="nfq-source-link"
            href="#"
            class="theme-transition text-sm font-medium text-[rgb(var(--color-accent))] underline decoration-[rgb(var(--color-accent))]/35 underline-offset-4 hover:decoration-[rgb(var(--color-accent))]/70"
          >
            Read the piece
          </a>
        </p>
      </blockquote>

      <div
        id="nfq-themes-wrap"
        class="mt-5 hidden border-t border-[rgb(var(--color-border))]/80 pt-5"
      >
        <p class="text-body-muted mt-0 mb-2 text-xs font-semibold tracking-wider uppercase">
          Related topics
        </p>
        <div id="nfq-themes" class="flex flex-wrap gap-2"></div>
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ existingTags, tagFamilyBySlug, quotes }}>
  const TAG_LINK =
    'tag-chip nfq-topic theme-transition inline-flex items-center gap-1 rounded-full border px-3 py-1 text-sm font-medium focus:outline-hidden';
  const TAG_STATIC =
    'nfq-topic inline-flex items-center gap-1 rounded-full border border-[rgb(var(--color-border))] bg-[rgb(var(--color-bg))] px-3 py-1 text-sm font-medium text-body-muted';

  function showQuote() {
    if (!quotes.length) return;
    const quote = quotes[Math.floor(Math.random() * quotes.length)];

    document.getElementById('nfq-text').textContent = quote.text;
    document.getElementById('nfq-author').textContent = quote.author;

    const workElement = document.getElementById('nfq-work');
    if (quote.work) {
      workElement.textContent = quote.book ? `${quote.work} · ${quote.book}` : quote.work;
      workElement.classList.remove('hidden');
    } else {
      workElement.textContent = '';
      workElement.classList.add('hidden');
    }

    const sourceWrap = document.getElementById('nfq-source-wrap');
    const sourceLink = document.getElementById('nfq-source-link');
    if (quote.sourceUrl) {
      sourceLink.setAttribute('href', quote.sourceUrl);
      sourceWrap.classList.remove('hidden');
    } else {
      sourceWrap.classList.add('hidden');
    }

    const themesWrap = document.getElementById('nfq-themes-wrap');
    const themesEl = document.getElementById('nfq-themes');
    themesEl.replaceChildren();
    if (quote.themes?.length > 0) {
      quote.themes.forEach((theme) => {
        const linked = existingTags.includes(theme);
        const el = document.createElement(linked ? 'a' : 'span');
        el.className = linked ? TAG_LINK : TAG_STATIC;
        if (linked) el.href = `/tag/${encodeURIComponent(theme)}`;
        el.dataset.tagFamily = tagFamilyBySlug[theme] ?? 'rest';

        const hash = document.createElement('span');
        hash.textContent = `#${theme}`;
        el.appendChild(hash);

        themesEl.appendChild(el);
      });
      themesWrap.classList.remove('hidden');
    } else {
      themesWrap.classList.add('hidden');
    }
  }

  showQuote();
</script>

<style>
  .not-found-quote .nfq-pullquote {
    margin: 0;
    border: none;
    padding: 0;
  }

  .not-found-quote .nfq-quote-text {
    margin: 0 0 1rem;
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    font-weight: 600;
    line-height: var(--leading-snug);
    letter-spacing: -0.02em;
    color: rgb(var(--color-text));
  }

  .not-found-quote .nfq-attribution {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .not-found-quote .nfq-attribution cite {
    font-style: normal;
    font-weight: 600;
    font-size: 0.9375rem;
    color: rgb(var(--color-accent));
  }

  .not-found-quote .nfq-attribution cite::before {
    content: '— ';
  }

  .not-found-quote .nfq-work {
    font-size: 0.875rem;
    color: rgb(var(--color-text-muted));
  }

  .not-found-quote .nfq-work.hidden {
    display: none;
  }

  .not-found-quote .nfq-source-wrap {
    margin: 0.75rem 0 0;
  }

  .not-found-quote .nfq-source-wrap.hidden {
    display: none;
  }
</style>
