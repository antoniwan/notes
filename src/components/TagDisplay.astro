---
import { getTagFamily } from '../data/tagFamilies';

interface Props {
  tags: string[];
  maxVisible?: number;
  showMoreIndicator?: boolean;
  compact?: boolean;
  variant?: 'default' | 'subtle' | 'bordered';
  className?: string;
}

const {
  tags,
  maxVisible = 5,
  showMoreIndicator = false,
  compact = false,
  variant = 'default',
  className = '',
} = Astro.props;

const visibleTags = tags.slice(0, maxVisible);
const hasMoreTags = showMoreIndicator && tags.length > maxVisible;
const remainingCount = tags.length - maxVisible;

const variantClass = {
  default: '',
  subtle: 'tag-chip--subtle',
  bordered: 'tag-chip--bordered',
}[variant];
---

<div class={`tag-display flex flex-wrap items-center gap-1.5 ${className}`}>
  {
    visibleTags.map((tag) => (
      <a
        href={`/tag/${tag}`}
        data-tag-family={getTagFamily(tag)}
        class={`tag-chip tag-item inline-flex items-center gap-1.5 ${compact ? 'px-2.5 py-1 text-sm' : 'px-3 py-1.5 text-base'} ${variantClass} interactive-button rounded-full border font-medium focus:outline-hidden`}
      >
        <span class="tag-text">#{tag}</span>
      </a>
    ))
  }
  {
    hasMoreTags && (
      <span
        class={`more-indicator inline-flex items-center gap-1 ${compact ? 'px-2.5 py-1 text-sm' : 'px-3 py-1.5 text-base'} text-body-muted rounded-full border font-medium`}
      >
        <span aria-hidden="true">⋯</span>
        <span>+{remainingCount} more</span>
      </span>
    )
  }
</div>

<style>
  .tag-item {
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease,
      transform 0.2s ease;
    backdrop-filter: blur(4px);
  }

  .tag-text {
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .more-indicator {
    transition: all 0.2s ease;
  }

  .tag-item:hover {
    transform: translateY(-1px);
  }

  @media (prefers-reduced-motion: reduce) {
    .tag-item,
    .more-indicator {
      transition: none !important;
    }

    .tag-item:hover {
      transform: none;
    }
  }
</style>
