---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<button
  type="button"
  class:list={['theme-control', className]}
  aria-label="Toggle theme"
  id="theme-toggle"
>
  <!-- Sun icon for light mode -->
  <svg
    class="h-5 w-5 dark:hidden"
    fill="none"
    stroke="currentColor"
    viewBox="0 0 24 24"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="1.75"
      d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
    ></path>
  </svg>

  <!-- Moon icon for dark mode -->
  <svg
    class="hidden h-5 w-5 dark:block"
    fill="none"
    stroke="currentColor"
    viewBox="0 0 24 24"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="1.75"
      d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
    ></path>
  </svg>
</button>

<script>
  import { THEME_CHANGE_EVENT } from '../utils/themeEvents';

  const themeToggle = document.getElementById('theme-toggle');

  function updateLabel() {
    const label = document.documentElement.classList.contains('dark')
      ? 'Switch to light theme'
      : 'Switch to dark theme';
    themeToggle?.setAttribute('aria-label', label);
    themeToggle?.setAttribute('title', label);
  }

  function setTheme(theme: 'dark' | 'light', remember = true) {
    document.documentElement.classList.toggle('dark', theme === 'dark');
    if (remember) {
      try {
        localStorage.setItem('theme', theme);
      } catch {
        /* Theme still works when storage is unavailable. */
      }
    }
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute('content', theme === 'dark' ? '#0a0a0a' : '#ffffff');
    window.dispatchEvent(new CustomEvent(THEME_CHANGE_EVENT, { detail: { theme } }));
    updateLabel();
  }

  themeToggle?.addEventListener('click', () => {
    setTheme(document.documentElement.classList.contains('dark') ? 'light' : 'dark');
  });
  window.addEventListener(THEME_CHANGE_EVENT, updateLabel);
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (event) => {
    let storedTheme: string | null = null;
    try {
      storedTheme = localStorage.getItem('theme');
    } catch {
      /* Use the system preference. */
    }
    if (!storedTheme) setTheme(event.matches ? 'dark' : 'light', false);
  });
  updateLabel();
</script>

<style>
  .theme-control {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    border: 0;
    border-radius: 0.75rem;
    background: transparent;
    color: rgb(var(--color-text-muted));
    cursor: pointer;
    transition:
      color 150ms ease,
      background-color 150ms ease;
  }
  .theme-control:hover {
    color: rgb(var(--color-accent));
    background: rgb(var(--color-accent) / 0.07);
  }
  .theme-control:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    button {
      transition: none !important;
    }
  }
</style>
