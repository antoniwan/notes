---
import { getTagFamily } from '../data/tagFamilies';
import { getTagMetadata } from '../data/tags';

interface Props {
  tag: string;
  count: number;
  size?: 'sm' | 'md' | 'lg';
  variant?: 'default' | 'subtle' | 'bordered';
  showCount?: boolean;
  className?: string;
}

const {
  tag,
  count,
  size = 'md',
  variant = 'default',
  showCount = true,
  className = '',
} = Astro.props;

const family = getTagFamily(tag);

const variantClass = {
  default: '',
  subtle: 'tag-chip--subtle',
  bordered: 'tag-chip--bordered',
}[variant];

const sizeClasses = {
  sm: 'text-sm px-2.5 py-1',
  md: 'text-base px-3 py-1.5',
  lg: 'text-lg px-4 py-2',
};
---

<a
  href={`/tag/${encodeURIComponent(tag)}`}
  data-tag-family={family}
  class={`tag-chip tag-card group inline-flex items-center gap-2 ${sizeClasses[size]} ${variantClass} rounded-full border font-medium interactive-button focus:outline-hidden ${className}`}
>
  <span class="tag-text">{getTagMetadata(tag).name}</span>
  {
    showCount && (
      <span class="tag-count text-sm leading-relaxed font-normal opacity-75">{count}</span>
    )
  }
</a>

<style>
  .tag-card {
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease,
      transform 0.2s ease;
    backdrop-filter: blur(4px);
  }

  .tag-text {
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .tag-count {
    font-weight: 400;
    opacity: 0.75;
  }

  .tag-card:hover {
    transform: translateY(-1px);
  }

  @media (prefers-reduced-motion: reduce) {
    .tag-card {
      transition: none !important;
    }

    .tag-card:hover {
      transform: none;
    }
  }

  @media (max-width: 768px) {
    .tag-card {
      font-size: 0.75rem;
      padding: 0.125rem 0.375rem;
    }
  }
</style>
