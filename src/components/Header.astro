---
import Logo from './Logo.astro';
import Navigation from './Navigation.astro';
import ThemeToggle from './ThemeToggle.astro';
import MobileNav from './MobileNav.astro';
import SearchBar from './SearchBar.astro';
import Container from './Container.astro';

interface Props {
  searchData: unknown[];
}

const { searchData } = Astro.props;
---

<header class="site-header" role="banner">
  <Container>
    <div class="site-header__bar">
      <div class="site-header__navigation">
        <Logo />
        <div class="site-header__desktop-nav"><Navigation /></div>
      </div>
      <div class="site-header__actions">
        <div class="site-header__desktop-search">
          <SearchBar searchData={searchData} placeholder="Search notes…" />
        </div>
        <button
          type="button"
          id="mobile-search-toggle"
          class="site-header__search-toggle"
          aria-label="Search notes"
          aria-expanded="false"
          aria-controls="mobile-search-container"
        >
          <svg
            width="20"
            height="20"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.75"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
          <span>Search</span>
        </button>
        <ThemeToggle />
        <MobileNav class="xl:hidden" />
      </div>
    </div>
  </Container>
  <div id="mobile-search-container" class="site-header__search-panel" hidden>
    <Container
      ><SearchBar
        searchData={searchData}
        placeholder="Search notes, topics, and pages…"
      /></Container
    >
  </div>
</header>

<script>
  const searchToggle = document.getElementById('mobile-search-toggle');
  const searchPanel = document.getElementById('mobile-search-container');
  const desktopQuery = window.matchMedia('(min-width: 1280px)');

  function closeSearch(restoreFocus = false) {
    if (!searchPanel || !searchToggle) return;
    searchPanel.hidden = true;
    searchToggle.setAttribute('aria-expanded', 'false');
    if (restoreFocus) searchToggle.focus();
  }

  function openSearch() {
    if (!searchPanel || !searchToggle || desktopQuery.matches) return;
    searchPanel.hidden = false;
    searchToggle.setAttribute('aria-expanded', 'true');
    searchPanel.querySelector('input')?.focus();
  }

  searchToggle?.addEventListener('click', () => {
    if (searchPanel?.hidden) openSearch();
    else closeSearch(true);
  });

  document.addEventListener('mobile-nav:open-search', openSearch);
  document.addEventListener('mobile-nav:opened', () => closeSearch());
  document.addEventListener('click', (event) => {
    if (
      !searchPanel?.hidden &&
      !searchPanel?.contains(event.target as Node) &&
      !searchToggle?.contains(event.target as Node)
    ) {
      closeSearch();
    }
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && searchPanel && !searchPanel.hidden) {
      event.preventDefault();
      closeSearch(true);
    }
  });
  document.addEventListener('focusin', (event) => {
    if (
      searchPanel &&
      !searchPanel.hidden &&
      !searchPanel.contains(event.target as Node) &&
      !searchToggle?.contains(event.target as Node)
    ) {
      closeSearch();
    }
  });
  desktopQuery.addEventListener('change', () => {
    if (!desktopQuery.matches) return;
    const moveFocus = searchPanel?.contains(document.activeElement);
    closeSearch();
    if (moveFocus)
      document.querySelector<HTMLInputElement>('.site-header__desktop-search input')?.focus();
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    width: 100%;
    background: rgb(var(--color-bg) / 0.96);
    backdrop-filter: blur(16px);
    font-family: var(--font-sans);
  }

  .site-header__bar,
  .site-header__navigation,
  .site-header__actions {
    display: flex;
    align-items: center;
  }

  .site-header__bar {
    height: var(--site-header-height);
    justify-content: space-between;
    gap: 1rem;
  }

  .site-header__navigation {
    gap: clamp(1.5rem, 3vw, 3rem);
  }
  .site-header__actions {
    gap: 0.25rem;
  }
  .site-header__desktop-nav,
  .site-header__desktop-search {
    display: none;
  }

  .site-header__search-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-width: 44px;
    min-height: 44px;
    border: 0;
    border-radius: 0.75rem;
    background: transparent;
    color: rgb(var(--color-text-muted));
    font-size: 0.875rem;
    cursor: pointer;
  }

  .site-header__search-toggle span {
    display: none;
  }
  .site-header__search-toggle:hover,
  .site-header__search-toggle[aria-expanded='true'] {
    color: rgb(var(--color-accent));
    background: rgb(var(--color-accent) / 0.07);
  }
  .site-header__search-toggle:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 3px;
  }

  .site-header__search-panel {
    position: absolute;
    top: 100%;
    inset-inline: 0;
    padding-block: 0.5rem 1rem;
    background: rgb(var(--color-bg));
    box-shadow: 0 12px 24px rgb(0 0 0 / 0.06);
  }

  @media (min-width: 640px) {
    .site-header__actions {
      gap: 0.5rem;
    }
    .site-header__search-toggle {
      padding-inline: 0.75rem;
    }
    .site-header__search-toggle span {
      display: inline;
    }
  }
  @media (min-width: 1280px) {
    .site-header__desktop-nav,
    .site-header__desktop-search {
      display: block;
    }
    .site-header__desktop-search {
      width: clamp(14rem, 21vw, 18rem);
      margin-right: 0.75rem;
    }
    .site-header__search-toggle,
    .site-header__search-panel {
      display: none;
    }
  }
</style>
