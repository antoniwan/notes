---
interface Props {
  /**
   * The date to format
   */
  date: Date;

  /**
   * The format to use
   */
  format?: 'short' | 'long' | 'relative';

  /**
   * Language of the page the date sits on
   */
  language?: 'en' | 'es';

  /**
   * Additional classes to apply
   */
  class?: string;
}

const { date, format = 'long', language = 'en', class: className = '' } = Astro.props;
const locale = language === 'es' ? 'es-PR' : 'en-US';

const formatter = new Intl.DateTimeFormat(locale, {
  year: 'numeric',
  month: format === 'short' ? 'short' : 'long',
  day: 'numeric',
});

// numeric: 'auto' already says today, yesterday and tomorrow in each language.
const relativeTimeFormatter = new Intl.RelativeTimeFormat(locale, {
  numeric: 'auto',
});

function getRelativeTime(date: Date): string {
  const now = new Date();
  const diff = date.getTime() - now.getTime();
  const days = Math.round(diff / (1000 * 60 * 60 * 24));

  return relativeTimeFormatter.format(days, 'day');
}
---

<time datetime={date.toISOString()} class:list={['theme-transition text-body-muted', className]}>
  {format === 'relative' ? getRelativeTime(date) : formatter.format(date)}
</time>
