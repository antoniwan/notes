---
import { SITE_TITLE, SOCIAL_LINKS } from '../consts';
import Logo from './Logo.astro';
import Container from './Container.astro';
import pkg from '../../package.json';
---

<footer
  class="theme-transition mt-16 border-t border-[rgb(var(--color-border))]/40 bg-[rgb(var(--color-bg))] md:mt-20"
  role="contentinfo"
>
  <Container class="py-10 md:py-12">
    <div class="flex flex-col gap-10 lg:flex-row lg:items-start lg:justify-between lg:gap-12">
      <div class="w-full max-w-sm shrink-0 space-y-3">
        <Logo size="xs" />
        <p class="text-body-muted m-0 text-sm leading-relaxed">
          Personal notes — practice over performance.
        </p>
      </div>

      <nav
        class="flex min-w-0 flex-1 flex-wrap gap-x-8 gap-y-3 text-sm"
        aria-label="Footer"
      >
        <a href="/guided-path" class="link-muted">Guided Path</a>
        <a href="/category" class="link-muted">Categories</a>
        <a href="/everything" class="link-muted">Everything</a>
        <a href="/about" class="link-muted">About</a>
        <a href="/brain-science" class="link-muted">Writing Insights</a>
        <a href="/library/books" class="link-muted">Book Library</a>
      </nav>

      <nav
        class="flex shrink-0 flex-wrap gap-x-6 gap-y-2 text-sm lg:justify-end"
        aria-label="Connect"
      >
        <a
          href={SOCIAL_LINKS.threads}
          target="_blank"
          rel="noopener noreferrer"
          class="link-muted">Threads</a
        >
        <a
          href={SOCIAL_LINKS.github}
          target="_blank"
          rel="noopener noreferrer"
          class="link-muted">GitHub</a
        >
        <a
          href={SOCIAL_LINKS.buildsSoftware}
          target="_blank"
          rel="noopener noreferrer"
          class="link-muted">Builds Software</a
        >
        <a
          href="https://antoniwan.online"
          target="_blank"
          rel="noopener noreferrer"
          class="link-muted">Links</a
        >
      </nav>
    </div>

    <div
      class="mt-10 flex flex-col items-center justify-between gap-3 border-t border-[rgb(var(--color-border))]/40 pt-6 md:flex-row"
    >
      <p class="text-body-muted m-0 text-center text-[0.7rem] leading-snug md:text-left">
        © {new Date().getFullYear()}
        {SITE_TITLE}. Content:
        <a
          href="https://creativecommons.org/licenses/by-nc-sa/4.0/"
          target="_blank"
          rel="noopener noreferrer">CC BY-NC-SA 4.0</a
        >
        · Code:
        <a href="https://opensource.org/licenses/MIT" target="_blank" rel="noopener noreferrer"
          >MIT</a
        >
      </p>

      <div class="text-body-muted flex flex-wrap items-center justify-center gap-3 text-[0.7rem]">
        <a href="/sitemap-index.xml" class="link-muted">Sitemap</a>
        <span class="text-[rgb(var(--color-text-muted))]/40" aria-hidden="true">·</span>
        <a href="/rss.xml" class="link-muted" title="RSS Feed">RSS</a>
        <span class="text-[rgb(var(--color-text-muted))]/40" aria-hidden="true">·</span>
        <a href="/feed.json" class="link-muted" title="JSON Feed">JSON</a>
        <span class="text-[rgb(var(--color-text-muted))]/40" aria-hidden="true">·</span>
        <a
          href="https://github.com/antoniwan/notes"
          target="_blank"
          rel="noopener noreferrer"
          class="link-muted">v{pkg.version}</a
        >
      </div>
    </div>
  </Container>
</footer>
