---
import { AUTHOR, SITE_TITLE, SOCIAL_LINKS } from '../consts';
import Logo from './Logo.astro';
import Container from './Container.astro';
import pkg from '../../package.json';
---

<footer
  class="theme-transition mt-16 border-t border-[rgb(var(--color-border))]/40 bg-[rgb(var(--color-bg))] md:mt-20"
  role="contentinfo"
>
  <Container class="py-10 md:py-12">
    <div class="space-y-6">
      <div>
        <Logo size="xs" />
      </div>

      <nav class="flex flex-wrap gap-x-5 gap-y-2 text-sm" aria-label="Footer">
        <a href="/guided-path" class="link-muted">Guided Path</a>
        <a href="/category" class="link-muted">Categories</a>
        <a href="/everything" class="link-muted">Everything</a>
        <a href="/about" class="link-muted">About</a>
        <a href="/brain-science" class="link-muted">Writing Insights</a>
        <a href="/library/books" class="link-muted">Book Library</a>
        <a href={SOCIAL_LINKS.threads} target="_blank" rel="noopener noreferrer" class="link-muted"
          >Threads</a
        >
        <a href={SOCIAL_LINKS.github} target="_blank" rel="noopener noreferrer" class="link-muted"
          >GitHub</a
        >
        <a
          href={SOCIAL_LINKS.buildsSoftware}
          target="_blank"
          rel="noopener noreferrer"
          class="link-muted">Builds Software</a
        >
        <a
          href="https://antoniwan.online"
          target="_blank"
          rel="noopener noreferrer"
          class="link-muted">Links</a
        >
      </nav>
    </div>

    <div
      class="mt-8 flex flex-col gap-3 border-t border-[rgb(var(--color-border))]/40 pt-6 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="text-body-muted m-0 text-[0.7rem] leading-snug">
        © {new Date().getFullYear()}{' '}
        {SITE_TITLE} by {AUTHOR.name}. Content:{' '}
        <a
          href="https://creativecommons.org/licenses/by-nc-sa/4.0/"
          target="_blank"
          rel="noopener noreferrer">CC BY-NC-SA 4.0</a
        >
        {' '}· Code:{' '}
        <a href="https://opensource.org/licenses/MIT" target="_blank" rel="noopener noreferrer"
          >MIT</a
        >
      </p>

      <div class="text-body-muted flex flex-wrap items-center gap-x-2 gap-y-1 text-[0.7rem]">
        <a href="/sitemap-index.xml" class="link-muted">Sitemap</a>
        <span class="opacity-40" aria-hidden="true">·</span>
        <a href="/rss.xml" class="link-muted" title="RSS Feed">RSS</a>
        <span class="opacity-40" aria-hidden="true">·</span>
        <a href="/feed.json" class="link-muted" title="JSON Feed">JSON</a>
        <span class="opacity-40" aria-hidden="true">·</span>
        <a
          href="https://github.com/antoniwan/notes"
          target="_blank"
          rel="noopener noreferrer"
          class="link-muted">v{pkg.version}</a
        >
      </div>
    </div>
  </Container>
</footer>
