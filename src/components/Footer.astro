---
import { AUTHOR } from '../consts';
import { readingLinks, collectionLinks, contactLinks } from '../data/readerNavigation';
import Logo from './Logo.astro';
import Container from './Container.astro';
import pkg from '../../package.json';

const footerGroups = [
  { id: 'reading', label: 'Read', links: readingLinks },
  { id: 'collections', label: 'Collections', links: collectionLinks },
  { id: 'connect', label: 'Connect', links: contactLinks },
];
---

<footer class="site-footer" role="contentinfo">
  <Container>
    <div class="footer-directory">
      <div class="footer-identity">
        <Logo size="xl" alwaysFull class="footer-brand" />
        <p>{AUTHOR.name}</p>
      </div>
      {
        footerGroups.map((group) => (
          <nav class="footer-group" aria-labelledby={'footer-' + group.id}>
            <h2 id={'footer-' + group.id}>{group.label}</h2>
            <ul>
              {group.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="footer-colophon">
      <div class="footer-licenses">
        <a
          href="https://creativecommons.org/licenses/by-nc-sa/4.0/"
          target="_blank"
          rel="noopener noreferrer"
        >
          Content: CC BY-NC-SA 4.0
        </a>
        <a href="https://opensource.org/licenses/MIT" target="_blank" rel="noopener noreferrer">
          Code: MIT
        </a>
      </div>

      <nav class="footer-feeds" aria-label="Site information">
        <a href="/sitemap-index.xml">Sitemap</a>
        <a href="/writing-insights">Writing Insights</a>
        <a href="/feed.json" title="JSON Feed">JSON</a>
        <a
          href="https://github.com/antoniwan/notes"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Site source, version ${pkg.version}`}
        >
          v{pkg.version}
        </a>
      </nav>
    </div>
  </Container>
</footer>

<style>
  .site-footer {
    margin-top: 0;
    padding-block: 2rem;
    color: rgb(var(--color-text-muted));
    font-family: var(--font-sans);
  }

  .footer-directory {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 1.5rem;
    row-gap: 2rem;
    align-items: start;
  }

  .footer-identity {
    min-width: 0;
  }

  .footer-identity :global(.footer-brand) {
    min-height: 44px;
    font-size: 2rem;
  }

  .footer-identity p {
    max-width: 14rem;
    margin: 0.65rem 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    text-wrap: balance;
  }

  .footer-group h2 {
    margin: 0 0 0.5rem;
    color: rgb(var(--color-accent));
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.5;
  }

  .footer-group {
    min-width: 0;
  }

  .footer-group ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    padding: 0;
    max-width: 100%;
    color: inherit;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .footer-group a {
    font-size: 1rem;
    line-height: 1.5;
  }

  .site-footer a:hover {
    color: rgb(var(--color-accent));
  }

  .site-footer a:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 4px;
    border-radius: 2px;
  }

  .footer-colophon {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    column-gap: 2rem;
    margin-top: 2rem;
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .footer-licenses,
  .footer-feeds {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 1.25rem;
  }

  .footer-feeds a {
    min-width: 44px;
  }

  @media (min-width: 640px) {
    .footer-directory {
      grid-template-columns: minmax(0, 1.35fr) repeat(3, minmax(0, 1fr));
      gap: 2rem;
    }

    .footer-colophon {
      margin-top: 2.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-footer a {
      transition: none;
    }
  }
</style>
