---
import BaseLayout from './BaseLayout.astro';
import PostDetails from '../components/post-reading/PostDetails.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Comments from '../components/Comments.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import MoreRecipes from '../components/MoreRecipes.astro';
import Container from '../components/Container.astro';
import DefaultImage from '../components/DefaultImage.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SocialShare from '../components/SocialShare.astro';
import LanguageToggle from '../components/LanguageToggle.astro';
import PostTocModal from '../components/post-toc/PostTocModal.astro';
import { generateCanonicalUrl, normalizeSeoPath } from '../utils/seo';
import { resolveContentLanguage } from '../utils/publishFilters';
import { isRecipePost } from '../utils/recipes';
import type { BlogLayoutProps } from '../types/layout';

interface Props extends BlogLayoutProps {}

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  minutesRead,
  tags,
  category,
  categoryItems = [],
  path,
  imageAlt,
  author,
  keywords,
  tableOfContents,
  showComments = true,
  translationData,
  ...rest
} = Astro.props as Props;

// Prefer an explicit path prop; always normalize trailing slashes for canonicals.
const canonicalPath = normalizeSeoPath(path || Astro.url.pathname);
const canonical = generateCanonicalUrl(canonicalPath);

const postLanguage = rest.currentPost?.data.language;
const contentLanguage = resolveContentLanguage(postLanguage);
const imageCredit = rest.currentPost?.data.imageCredit;
const imageCreditUrl = rest.currentPost?.data.imageCreditUrl;
const imageLicense = rest.currentPost?.data.imageLicense;
const isRecipe = rest.currentPost ? isRecipePost(rest.currentPost) : false;
const recipeData = isRecipe ? rest.currentPost?.data : undefined;
const estimatedWordCount = (() => {
  if (!minutesRead || typeof minutesRead !== 'string') return undefined;
  const match = minutesRead.match(/(\d+)/);
  // ~200 wpm reading estimate used only when body word count isn't passed in.
  return match ? Number(match[1]) * 200 : undefined;
})();

const hreflangAlternates = translationData?.hasTranslations
  ? [
      ...translationData.translations.map((translation) => ({
        hreflang: translation.language[0] || 'en',
        href: generateCanonicalUrl(translation.path),
      })),
      {
        hreflang: 'x-default',
        href: generateCanonicalUrl(
          translationData.translations.find((t) => t.language[0] === 'en')?.path ||
            translationData.currentPath,
        ),
      },
    ]
  : undefined;

// Use Astro's native post.id directly (no regex, no normalization)
const postId = rest.currentPost?.id || '';
const postSlug = postId; // Alias for backward compatibility in template
const primaryCategory = categoryItems[0] || null;
const isSpanish = contentLanguage.contentLanguage === 'es';
---

<BaseLayout
  title={title}
  description={description}
  pubDate={pubDate}
  updatedDate={updatedDate}
  heroImage={heroImage}
  minutesRead={minutesRead}
  tags={tags}
  category={category}
  path={canonicalPath}
  imageAlt={imageAlt}
  author={author}
  keywords={keywords}
  type="article"
  structuredDataType={isRecipe ? 'recipe' : 'article'}
  recipeIngredient={recipeData?.recipeIngredient}
  recipeInstructions={recipeData?.recipeInstructions}
  prepTime={recipeData?.prepTime}
  cookTime={recipeData?.cookTime}
  totalTime={recipeData?.totalTime}
  recipeYield={recipeData?.recipeYield}
  recipeCategory={recipeData?.recipeCategory}
  recipeCuisine={recipeData?.recipeCuisine}
  tableOfContents={tableOfContents}
  hasComments={showComments}
  featured={rest.featured}
  draft={rest.draft}
  postId={postId}
  htmlLang={contentLanguage.htmlLang}
  locale={contentLanguage.ogLocale}
  inLanguage={contentLanguage.inLanguage}
  wordCount={estimatedWordCount}
  {...rest}
  hreflangAlternates={hreflangAlternates}
>
  <Container class="post-shell">
    <div class="post-breadcrumbs">
      <Breadcrumbs
        items={[
          { label: isSpanish ? 'Inicio' : 'Home', href: '/' },
          ...(isRecipe
            ? [{ label: isSpanish ? 'Recetario' : 'Cookbook', href: '/recipes' }]
            : primaryCategory
              ? [{ label: primaryCategory.name, href: `/category/${primaryCategory.id}` }]
              : []),
          { label: title },
        ]}
        class="text-sm"
      />
    </div>

    <div class="post-layout">
      <header class="post-heading" id="post-heading">
        {
          primaryCategory && (
            <a
              class="post-eyebrow"
              href={isRecipe ? '/recipes' : `/category/${primaryCategory.id}`}
            >
              <span aria-hidden="true" class="post-eyebrow__mark" />
              {isRecipe
                ? isSpanish
                  ? 'Del recetario'
                  : 'From the cookbook'
                : primaryCategory.name}
            </a>
          )
        }
        <h1 id="post-title" class="post-title">{title}</h1>
        {description && <p class="post-description">{description}</p>}
        <div class="post-byline">
          {pubDate && <FormattedDate date={pubDate} format="long" />}
          {minutesRead && !isRecipe && <span class="post-duration">{minutesRead}</span>}
          <span class="post-read-status" data-read-status data-post-slug={postSlug} hidden></span>
        </div>
        {
          translationData?.hasTranslations && (
            <div class="post-language">
              <LanguageToggle
                translations={translationData.translations}
                currentLanguage={translationData.currentLanguage}
                currentPath={translationData.currentPath}
              />
            </div>
          )
        }
      </header>

      <aside
        class="post-sidebar scrollbar-subtle-y"
        aria-label={isSpanish
          ? 'Navegación y detalles del artículo'
          : 'Article navigation and details'}
      >
        <PostTocModal
          tableOfContents={tableOfContents}
          language={contentLanguage.contentLanguage}
        />
        <div class="post-sidebar__details">
          <PostDetails
            categoryItems={categoryItems}
            tags={tags}
            pubDate={pubDate}
            updatedDate={updatedDate}
            language={contentLanguage.contentLanguage}
          />
          <div class="post-share">
            <SocialShare
              title={title}
              description={description}
              url={canonical}
              variant="vertical"
            />
          </div>
        </div>
      </aside>

      <article class="post-article" aria-labelledby="post-title">
        <div class="post-hero">
          <div class="post-hero__frame">
            {
              heroImage ? (
                <img
                  src={heroImage}
                  alt={imageAlt || title}
                  class="h-full w-full object-cover"
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                  width="1200"
                  height="450"
                />
              ) : (
                <DefaultImage
                  alt={imageAlt || title}
                  className="h-full w-full"
                  loading="eager"
                  priority={true}
                  width={1200}
                  height={450}
                />
              )
            }
          </div>
          {
            imageCredit && (
              <p class="text-body-muted mt-2 text-sm leading-relaxed">
                {contentLanguage.contentLanguage === 'es' ? 'Foto: ' : 'Photo: '}
                {imageCreditUrl ? (
                  <a
                    href={imageCreditUrl}
                    class="underline decoration-[rgb(var(--color-border))] underline-offset-2 hover:text-[rgb(var(--color-accent))]"
                    rel="noopener noreferrer"
                  >
                    {imageCredit}
                  </a>
                ) : (
                  imageCredit
                )}
                {imageLicense ? ` · ${imageLicense}` : ''}
                {imageCreditUrl?.includes('wikimedia.org')
                  ? ' via Wikimedia Commons'
                  : imageCreditUrl?.includes('flickr.com')
                    ? ' via Flickr'
                    : imageCreditUrl?.includes('unsplash.com')
                      ? ' via Unsplash'
                      : ''}
                . Converted to AVIF.
              </p>
            )
          }
        </div>

        <div
          id="post-top"
          class="post-prose prose prose-lg prose-p:text-[rgb(var(--color-text))]"
          data-post-slug={postSlug}
        >
          <slot />
        </div>
      </article>

      <div class="post-afterword">
        <div
          class:list={[
            'post-finish-actions',
            { 'post-finish-actions--topics-only': !showComments },
          ]}
        >
          <details class="post-mobile-details">
            <summary
              >{
                isSpanish ? 'Temas y detalles de este artículo' : 'Topics and article details'
              }</summary
            >
            <PostDetails
              categoryItems={categoryItems}
              tags={tags}
              pubDate={pubDate}
              updatedDate={updatedDate}
              language={contentLanguage.contentLanguage}
            />
            <div class="post-share">
              <SocialShare
                title={title}
                description={description}
                url={canonical}
                variant="horizontal"
              />
            </div>
          </details>
          {
            showComments && (
              <a class="post-comment-jump" href="#comments">
                {isSpanish ? 'Dejar una nota' : 'Leave a note'}
              </a>
            )
          }
        </div>
        {
          rest.currentPost && isRecipePost(rest.currentPost) ? (
            <MoreRecipes currentPost={rest.currentPost} allPosts={rest.allPosts} />
          ) : (
            <RelatedPosts currentPost={rest.currentPost} allPosts={rest.allPosts} />
          )
        }
        {showComments && <Comments language={contentLanguage.contentLanguage} />}
      </div>
    </div>
  </Container>
</BaseLayout>

<style>
  :global(.post-shell) {
    padding-bottom: 3rem;
  }

  .post-breadcrumbs {
    margin: 1.5rem 0 0;
  }

  .post-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    width: 100%;
  }

  .post-heading {
    min-width: 0;
    padding-block: clamp(1.75rem, 4vw, 3.5rem) 2rem;
  }

  .post-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2rem;
    margin-bottom: 0.85rem;
    color: rgb(var(--color-accent));
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .post-eyebrow__mark {
    width: 0.5rem;
    height: 0.5rem;
    background: rgb(var(--color-primary));
    transform: rotate(45deg);
  }

  .post-title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(2.125rem, 1.4rem + 2.2vw, 3.5rem);
    line-height: 1.13;
    font-weight: 700;
    letter-spacing: -0.035em;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .post-description {
    margin: 1.25rem 0 0;
    max-width: 42rem;
    color: rgb(var(--color-text-muted));
    font-size: clamp(1.0625rem, 0.95rem + 0.35vw, 1.25rem);
    line-height: 1.65;
    text-wrap: pretty;
  }

  .post-byline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.1rem;
    margin-top: 1.5rem;
    color: rgb(var(--color-text-muted));
    font-family: var(--font-sans);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .post-duration {
    font-variant-numeric: tabular-nums;
  }

  .post-read-status {
    color: rgb(var(--color-accent));
  }

  .post-language {
    margin-top: 1.25rem;
  }

  .post-language :global(.language-toggle) {
    margin-bottom: 0;
    flex-wrap: wrap;
  }

  .post-sidebar {
    display: contents;
  }

  .post-sidebar__details {
    display: none;
  }

  .post-article,
  .post-afterword {
    min-width: 0;
  }

  .post-hero {
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .post-hero__frame {
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 0.75rem;
    background: rgb(var(--color-bg-alt));
    border: 1px solid rgb(var(--color-border) / 0.45);
  }

  .post-hero__frame :global(img) {
    display: block;
    height: 100%;
    width: 100%;
    object-fit: cover;
  }

  .post-article :global(.post-prose) {
    max-width: 68ch !important;
    margin-inline: 0 !important;
    overflow-x: auto !important;
    overflow-y: visible !important;
    display: flow-root;
    font-size: clamp(1.125rem, 1.025rem + 0.35vw, 1.25rem);
    line-height: 1.8;
    scroll-margin-top: calc(var(--site-header-height) + 1.5rem);
    overflow-wrap: anywhere;
  }

  .post-afterword {
    width: 100%;
    margin-top: clamp(3.5rem, 7vw, 6rem);
  }

  .post-finish-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 1rem 2rem;
    margin-bottom: 2rem;
  }

  .post-comment-jump {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: rgb(var(--color-accent));
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.5;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .post-comment-jump:hover {
    color: rgb(var(--color-accent-hover));
  }

  .post-comment-jump:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 4px;
  }

  .post-afterword :global(.comments-section) {
    margin-top: clamp(3.5rem, 7vw, 6rem);
  }

  .post-article :global(.post-prose hr) {
    border: 0;
    height: 0;
    margin-block: 2.5rem;
  }

  .post-article :global(.post-prose p) {
    line-height: 1.8;
  }

  .post-article :global(.post-prose > :first-child) {
    margin-top: 0;
  }

  .post-article :global(.post-prose :is(h2, h3, h4, [id])) {
    scroll-margin-top: calc(var(--site-header-height) + 1.5rem);
  }

  .post-article :global(.post-prose pre) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    overscroll-behavior-x: contain;
  }

  .post-article :global(.post-prose table) {
    display: table;
    width: 100%;
    max-width: none;
    overflow: visible;
    font-size: 0.9em;
    overflow-wrap: normal;
  }

  .post-article :global(.post-prose .table-scroll) {
    max-width: 100%;
    margin-block: 2rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
  }

  .post-article :global(.post-prose .table-scroll table) {
    margin: 0;
    width: max-content;
    min-width: 100%;
    overflow: visible;
  }

  .post-article :global(.post-prose :is(thead, tbody, tfoot, tr, th, td)) {
    max-width: none;
  }

  .post-article :global(.post-prose th) {
    text-transform: none;
    letter-spacing: -0.02em;
  }

  .post-article :global(.post-prose :is(th, td)) {
    padding-block: 0.7rem;
    padding-inline: 1rem;
  }

  .post-article :global(.post-prose :is(th, td):first-child) {
    padding-inline-start: 1.5rem;
  }

  .post-article :global(.post-prose :is(th, td):last-child) {
    padding-inline-end: 1.5rem;
  }

  .post-article :global(.post-prose td:first-child) {
    font-weight: inherit;
  }

  .post-article :global(.post-prose :is(a, button, [tabindex]):focus-visible),
  .post-eyebrow:focus-visible,
  .post-mobile-details > summary:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 4px;
    border-radius: 2px;
  }

  .post-mobile-details {
    max-width: 100%;
    margin: 0;
    padding: 0;
  }

  .post-mobile-details > summary {
    min-height: 2.75rem;
    align-content: center;
    cursor: pointer;
    color: rgb(var(--color-text-muted));
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .post-mobile-details[open] > summary {
    margin-bottom: 1rem;
  }

  .post-share {
    margin-top: 1.25rem;
    padding-top: 1.25rem;
  }

  @media (max-width: 599px) {
    .post-breadcrumbs {
      display: none;
    }
    .post-heading {
      padding-top: 1.75rem;
    }
  }

  @media (min-width: 768px) {
    .post-hero__frame {
      aspect-ratio: 16 / 9;
      max-height: 28rem;
    }
  }

  @media (min-width: 1200px) {
    .post-breadcrumbs {
      max-width: none;
      margin-top: 2rem;
    }
    .post-layout {
      max-width: none;
      grid-template-columns: 14rem minmax(0, 1fr);
      column-gap: clamp(3rem, 5vw, 4.5rem);
    }
    .post-heading {
      grid-column: 2;
      grid-row: 1;
      padding-top: 2.25rem;
    }
    .post-sidebar {
      display: block;
      grid-column: 1;
      grid-row: 1 / 4;
      position: sticky;
      align-self: start;
      top: calc(var(--site-header-height) + 1.5rem);
      margin-top: 2.5rem;
      max-height: calc(100dvh - var(--site-header-height) - 3rem);
      overflow-y: auto;
      overscroll-behavior: contain;
      padding-block: 0.25rem;
      padding-right: 0.5rem;
      font-family: var(--font-sans);
    }
    .post-sidebar__details {
      display: block;
    }
    .post-sidebar:has([data-post-toc]) .post-sidebar__details {
      margin-top: 1.5rem;
      padding-top: 1.5rem;
    }
    .post-article {
      grid-column: 2;
      grid-row: 2;
    }
    .post-afterword {
      grid-column: 2;
      grid-row: 3;
    }
    .post-mobile-details {
      display: none;
    }
    .post-finish-actions--topics-only {
      display: none;
    }
  }
</style>

<script>
  import { formatRelativeReadTime } from '../utils/relativeReadTime.client';
  import '../components/post-toc/postToc.client';

  const status = document.querySelector<HTMLElement>('[data-read-status]');
  const postSlug = status?.dataset.postSlug;
  const readStateService = window.ReadStateService?.getInstance();

  function updateReadStatus() {
    if (!status || !postSlug || !readStateService) return;
    const readData = readStateService.getReadData(postSlug);
    status.hidden = !readData;
    status.textContent = readData ? `✓ ${formatRelativeReadTime(readData.readAt)}` : '';
  }

  const unsubscribe = readStateService?.subscribeToAll(updateReadStatus);
  updateReadStatus();
  window.addEventListener('beforeunload', () => unsubscribe?.());
</script>
