---
import BaseLayout from './BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Container from '../components/Container.astro';
import type { BaseLayoutProps } from '../types/layout';

interface Props extends BaseLayoutProps {
  /**
   * Visible page H1. Defaults to `title`.
   * Use when the document title (SEO/nav brand) should differ from the on-page headline
   * — e.g. home: title "Notes", heading "A season of execution".
   */
  heading?: string;
  /**
   * Page content shell:
   * - prose (default): long-form / mixed text pages
   * - chrome: listing & tool pages (cards/grids) — avoids fighting Tailwind Typography
   * Or pass an explicit contentClass to override.
   */
  mode?: 'prose' | 'chrome';
  /** Replaces default wrapper when you need a custom page layout */
  contentClass?: string;
}

const {
  title,
  heading,
  description,
  metaDescription,
  path,
  imageAlt,
  author,
  keywords,
  structuredDataType,
  structuredDataIdentifier,
  posts,
  showTitle = true,
  mode = 'prose',
  contentClass,
  ...rest
} = Astro.props;

const resolvedContentClass =
  contentClass ?? (mode === 'chrome' ? 'page-chrome max-w-none' : 'prose prose-lg max-w-none');
const visibleHeading = heading ?? title;
---

<BaseLayout
  title={title}
  description={description}
  metaDescription={metaDescription}
  path={path}
  imageAlt={imageAlt}
  author={author}
  keywords={keywords}
  structuredDataType={structuredDataType}
  structuredDataIdentifier={structuredDataIdentifier}
  posts={posts}
  {...rest}
>
  <Container>
    <PageHeader title={visibleHeading} description={description} showTitle={showTitle} />

    <div class={resolvedContentClass}>
      <slot />
    </div>
  </Container>
</BaseLayout>